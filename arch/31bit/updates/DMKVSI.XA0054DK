./ R 00295000          $ 00294100 100                                           
         TM    VMFSTAT,VMESA390  M7.10: ESA/390 SSCH:          XA0054DK         
         BZ    VSIOCAW        ITS CAW IS IN DMKVCSCW,          XA0054DK         
         L     R15,=A(DMKVCSCW)  NOT AT X'48' (I-256)          XA0054DK         
         ICM   R2,15,0(R15)                                    XA0054DK         
         BZ    VSIOCAW        NONE: DMKVMI'S OWN SIO           XA0054DK         
         XC    0(4,R15),0(R15)                                 XA0054DK         
         N     R2,=X'F0FFFFFF'  DROP THE MARK                  XA0054DK         
         B     TSTDED1                                         XA0054DK         
VSIOCAW  LA    R1,CAW         LOGICAL ADDRESS OF USER'S CAW    XA0054DK         
./ R 00328000 00330000 $ 00328000 010                                           
         TM    VDEVTYPC,CLASTERM IS THIS A TERMINAL DEVICE?    XA0054DK         
         BO    GETIOBNA       YES: NOT ACTIVE                  XA0054DK         
         CLI   VDEVTYPC,CLASSPEC  I-287: A CTCA WAITS ON ITS   XA0054DK         
         BNE   IOBFREE        PARTNER: NOT ACTIVE EITHER       XA0054DK         
GETIOBNA NI    VCUSTAT,255-VCUACTV RESET ACTIVE FLAG           XA0054DK         
./ R 00492000 00493000 $ 00492000 100                                           
TYPLCS   EQU   X'08'          9.12B: VIRTUAL LCS ADAPTER       XA0054DK         
         TM    VDEVTYPE,TYPCTCA+TYPLCS  CTCA OR LCS?           XA0054DK         
         BZ    VIOKNCP        NO...                            XA0054DK         
./ R 01637000          $ 01636001 001                                           
VMESA390 EQU   X'02'          VMFSTAT: ESA/390 MACHINE         XA0054DK         
VMVCSIX  EQU   VMUSERH1       ITS TABLE: SLOT IN DMKVCS        XA0054DK         
VMVCSFL  EQU   VMLCLRSV       X'80': ESA/390 I/O ACTIVE        XA0054DK         
*                                                              XA0054DK         
* M7: THE VIRTUAL CHANNEL SUBSYSTEM OF AN ESA/390 VIRTUAL      XA0054DK         
* MACHINE (SET ESA ON). SUBCHANNEL N IS THE N-TH VIRTUAL       XA0054DK         
* DEVICE IN ADDRESS ORDER. SSCH AND TSCH/TPI RUN THROUGH       XA0054DK         
* DMKVSI AS SIO AND TIO; DMKVSJ COMES BACK TO DMKVCSSE.        XA0054DK         
* DOCS/39-M7-ESA-GUESTS.MD.                                    XA0054DK         
*                                                              XA0054DK         
DMKVCS   CSECT                                                 XA0054DK         
         DROP  R10,R12                                         XA0054DK         
         USING DMKVCS,R12                                      XA0054DK         
         USING VCSTAB,R10                                      XA0054DK         
         ENTRY DMKVCSEX,DMKVCSSE,DMKVCSIN,DMKVCSSN,DMKVCSAR    XA0054DK         
         ENTRY DMKVCSC1                                        XA0054DK         
DMKVCSEX DS    0H             GOTO FROM DMKPRV: B212, B23X     XA0054DK         
*  M7.8: ONE ESA/390 GUEST IN DMKVCS AT A TIME. ITS WORK       XA0054DK         
*  FIELDS ARE STATIC AND LIVE ACROSS GUESTIO'S DEFERRED        XA0054DK         
*  TRANS;                                                      XA0054DK         
*  A SECOND GUEST'S SSCH CONVERTED ITS CHAIN WITH THE FIRST    XA0054DK         
*  ONE'S VCSNEW/VCSVIS (TWO DEBIANS: SIGSEGV IN INIT). THE     XA0054DK         
*  OWNER RELEASES THE LOCK AT VCSEXIT AND SEBACK (M4B.3: THE   XA0054DK         
*  OLD RULE, HELD ONLY WHILE THE OWNER WAITS, LOST IT BETWEEN  XA0054DK         
*  A PAGE-IN AND THE DEFERRED CONTINUATION: TWO DEBIANS, THE   XA0054DK         
*  SECOND ONE'S INIT SEGFAULTED). A LOCK WHOSE OWNER IS IN     XA0054DK         
*  ITS OWN WAIT STATE OR LOGGING OFF IS STALE AND TAKEN.       XA0054DK         
         L     R1,VCSLOCK                                      XA0054DK         
         LTR   R1,R1                                           XA0054DK         
         BZ    VCSLKOWN                                        XA0054DK         
         CR    R1,R11                                          XA0054DK         
         BE    VCSLKOWN                                        XA0054DK         
         TM    VMPSW+1-VMBLOK(R1),X'02'  GUEST WAIT STATE      XA0054DK         
         BO    VCSLKOWN                                        XA0054DK         
         TM    VMRSTAT-VMBLOK(R1),VMLOGOFF                     XA0054DK         
         BO    VCSLKOWN                                        XA0054DK         
         SR    R1,R1          BUSY: BACK THE PSW UP BY THE     XA0054DK         
         IC    R1,VMINST      INSTRUCTION LENGTH (00: 2,       XA0054DK         
         SRL   R1,6           01/10: 4, 11: 6) AND LET IT      XA0054DK         
         LA    R1,1(,R1)      COME AGAIN                       XA0054DK         
         SRL   R1,1                                            XA0054DK         
         SLL   R1,1                                            XA0054DK         
         LA    R1,2(,R1)                                       XA0054DK         
         L     R0,VMPSW+4                                      XA0054DK         
         SR    R0,R1                                           XA0054DK         
         ST    R0,VMPSW+4                                      XA0054DK         
         NI    VMRSTAT,255-VMEXWAIT  RUNNABLE (TWO DEBIANS:    XA0054DK         
         GOTO  DMKDSPCH       LEFT IN EXWAIT, NEVER RAN)       XA0054DK         
VCSLKOWN ST    R11,VCSLOCK                                     XA0054DK         
         NI    VMPSW+2,X'CF'  CC 0                             XA0054DK         
         BAL   R9,GETTAB      R10 = THE USER'S TABLE           XA0054DK         
         MVI   VCSOP,0                                         XA0054DK         
         OI    VMVCSFL,X'80'  FROM NOW ON: ESA/390 I/O         XA0054DK         
         L     R15,=A(VCRUPD)  THE DIAGNOSTIC RING, BEYOND     XA0054DK         
         BALR  R9,R15         R12'S REACH (9.12B)              XA0054DK         
VCRDONE  DS    0H                                              XA0054DK         
         CLI   VMINST,X'E5'   TPROT (E501)                     XA0054DK         
         BE    VCSTPROT                                        XA0054DK         
         CLI   VMINST,X'AE'   SIGP: PAST R12'S 4 KB, AT        XA0054DK         
         BNE   VCSNSIGP       THE END WITH ITS OWN BASE        XA0054DK         
         L     R15,=A(VCSSIGP)                                 XA0054DK         
         BR    R15                                             XA0054DK         
VCSNSIGP DS    0H                                              XA0054DK         
         CLI   VMINST+1,X'12' STAP                             XA0054DK         
         BE    VCSSTAP                                         XA0054DK         
         CLI   VMINST+1,X'B1' STFL                             XA0054DK         
         BE    VCSSTFL                                         XA0054DK         
         CLI   VMINST+1,X'7D' STSI: NO SYSTEM                  XA0054DK         
         BE    VCSCC3         INFORMATION, CC 3                XA0054DK         
         CLI   VMINST+1,X'20' SERVC: NO SERVICE                XA0054DK         
         BE    VCSCC3         PROCESSOR, CC 3                  XA0054DK         
         CLI   VMINST+1,X'5F' CHSC: NOT AVAILABLE              XA0054DK         
         BE    VCSCC3         (CC 3)                           XA0054DK         
         CLI   VMINST+1,X'11' STPX: PREFIX 0                   XA0054DK         
         BE    VCSSTPX                                         XA0054DK         
         CLI   VMINST+1,X'10' SPX                              XA0054DK         
         BE    VCSSPX                                          XA0054DK         
         CLI   VMINST+1,X'21' IPTE                             XA0054DK         
         BE    VCSIPTE                                         XA0054DK         
         CLI   VMINST+1,X'79' SACF                             XA0054DK         
         BE    VCSSAC                                          XA0054DK         
         CLI   VMINST+1,X'19' SAC                              XA0054DK         
         BE    VCSSAC                                          XA0054DK         
         CLI   VMINST+1,X'36' TPI                              XA0054DK         
         BE    VCSTPI                                          XA0054DK         
         CLI   VMINST+1,X'39' STCRW                            XA0054DK         
         BE    VCSSTCRW                                        XA0054DK         
         L     R1,VMGPRS+4    GR1: SUBSYSTEM ID                XA0054DK         
         CLM   R1,12,SSIDW    X'0001' NNNN ?                   XA0054DK         
         BNE   VCSCC3                                          XA0054DK         
         N     R1,F65535      THE SUBCHANNEL NUMBER            XA0054DK         
         BAL   R9,FINDSUB     R6-R8, R13 = ITS DEVICE          XA0054DK         
         BNZ   VCSCC3                                          XA0054DK         
         BAL   R9,GETENT      R3 = ITS ENTRY                   XA0054DK         
         CLI   VDEVTYPE,TYPLCS  9.12B: A VIRTUAL LCS IS        XA0054DK         
         BNE   VCSNLCS        DMKVLN'S (PAST R12'S REACH)      XA0054DK         
         L     R15,=A(DMKVLNEX)                                XA0054DK         
         BR    R15                                             XA0054DK         
VCSNLCS  CLI   VMINST+1,X'34'                                  XA0054DK         
         BE    VCSSTSCH                                        XA0054DK         
         CLI   VMINST+1,X'32'                                  XA0054DK         
         BE    VCSMSCH                                         XA0054DK         
         CLI   VMINST+1,X'33'                                  XA0054DK         
         BE    VCSSSCH                                         XA0054DK         
         CLI   VMINST+1,X'35'                                  XA0054DK         
         BE    VCSTSCH                                         XA0054DK         
         CLI   VMINST+1,X'31' HSCH                             XA0054DK         
         BE    VCSCSCH                                         XA0054DK         
         CLI   VMINST+1,X'30' CSCH                             XA0054DK         
         BE    VCSCSCH                                         XA0054DK         
         B     VCSEXIT        RSCH, SAL, SCHM: NOTHING         XA0054DK         
VCSCC3   OI    VMPSW+2,X'30'                                   XA0054DK         
         B     VCSEXIT                                         XA0054DK         
VCSCC2   OI    VMPSW+2,X'20'                                   XA0054DK         
         B     VCSEXIT                                         XA0054DK         
VCSCC1   OI    VMPSW+2,X'10'                                   XA0054DK         
VCSEXIT  L     R1,VCRLAST                                      XA0054DK         
         MVC   12(1,R1),VMPSW+2                                XA0054DK         
         C     R11,VCSLOCK    RELEASE THE LOCK (M4B.3)         XA0054DK         
         BNE   *+10                                            XA0054DK         
         XC    VCSLOCK,VCSLOCK                                 XA0054DK         
         NI    VMRSTAT,255-VMEXWAIT  OUT OF INSTR WAIT         XA0054DK         
         GOTO  DMKDSPCH       (AS DMKPRV PRIVRET)              XA0054DK         
*                                                              XA0054DK         
VCSSTAP  BAL   R9,OPADDR      STAP: CPU ADDRESS 0              XA0054DK         
         TRANS 2,1,OPT=(BRING,DEFER,AMODE31),ADEX=VCSEXIT      XA0054DK         
         XC    0(2,R2),0(R2)                                   XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSSTFL  MVC   VCSBUF(4),STFLN3  STFL: N3 ONLY, AT X'C8'       XA0054DK         
         LA    R5,200         (THE INSTRUCTIONS AN ESA/390     XA0054DK         
         LA    R6,VCSBUF      KERNEL BUILT FOR Z900 USES;      XA0054DK         
         LA    R4,1           HERCULES HAS THEM IN ESA/390     XA0054DK         
         SR    R0,R0          MODE)                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSSTPX  BAL   R9,OPADDR      STPX: THE ONE CPU'S PREFIX       XA0054DK         
         LR    R5,R1          IS 0                             XA0054DK         
         XC    VCSBUF(4),VCSBUF                                XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,1                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSTPROT BAL   R9,OPADDR      TPROT: CC 0 INSIDE THE           XA0054DK         
         CL    R1,VMSIZE      MACHINE'S STORAGE, CC 3          XA0054DK         
         BL    VCSEXIT        BEYOND (LINUX SIZES ITS          XA0054DK         
         B     VCSCC3         MEMORY THIS WAY)                 XA0054DK         
*                                                              XA0054DK         
* SPX: ONE CPU, NO VIRTUAL PREFIXING. THE NEW PREFIX PAGE IS   XA0054DK         
* COPIED TO PAGE 0, WHICH STAYS THE LOWCORE (LINUX UP SETS     XA0054DK         
* ITS LOWCORE UP AT P, THEN SPX P; IT USES IT AT REAL 0).      XA0054DK         
VCSSPX   BAL   R9,OPADDR                                       XA0054DK         
         LR    R5,R1                                           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,1                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO     THE NEW PREFIX                   XA0054DK         
         L     R7,VCSBUF                                       XA0054DK         
         N     R7,XPFX                                         XA0054DK         
         BZ    VCSEXIT        0: NOTHING TO COPY               XA0054DK         
         SR    R8,R8          OFFSET                           XA0054DK         
SPXLOOP  LR    R5,R7          (NOT LA: CP RUNS AMODE 24 AND    XA0054DK         
         AR    R5,R8          LINUX'S PREFIX IS NEAR 64 MB)    XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,4                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         LR    R5,R8                                           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,4                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         LA    R8,16(,R8)                                      XA0054DK         
         C     R8,=F'4096'                                     XA0054DK         
         BL    SPXLOOP                                         XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
* IPTE R1,R2: THE GUEST'S PTE INVALID; EVERY SHADOW TABLE      XA0054DK         
* INVALIDATED BEFORE IT RUNS AGAIN (DMKVAX).                   XA0054DK         
VCSIPTE  IC    R1,VMINST+3                                     XA0054DK         
         SRL   R1,4                                            XA0054DK         
         N     R1,=F'15'                                       XA0054DK         
         SLL   R1,2                                            XA0054DK         
         L     R5,VMGPRS(R1)  PAGE TABLE ORIGIN                XA0054DK         
         N     R5,=X'7FFFFFC0'                                 XA0054DK         
         IC    R1,VMINST+3                                     XA0054DK         
         N     R1,=F'15'                                       XA0054DK         
         SLL   R1,2                                            XA0054DK         
         L     R1,VMGPRS(R1)  PAGE INDEX                       XA0054DK         
         SRL   R1,12                                           XA0054DK         
         N     R1,=F'255'                                      XA0054DK         
         SLL   R1,2                                            XA0054DK         
         AR    R5,R1                                           XA0054DK         
         ST    R5,VCSADDR                                      XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,1                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         OI    VCSBUF+2,X'04'                                  XA0054DK         
         L     R5,VCSADDR                                      XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,1                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         OI    VMESTAT,VMINVPAG                                XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
* SAC/SACF: HOME MODE IS PRIVILEGED IN THE REAL PROBLEM        XA0054DK         
* STATE THE GUEST RUNS IN. BITS 22-23 OF THE ADDRESS ARE       XA0054DK         
* THE NEW ADDRESS-SPACE CONTROL, PSW BITS 16-17.               XA0054DK         
VCSSAC   BAL   R9,OPADDR                                       XA0054DK         
         SRL   R1,8                                            XA0054DK         
         N     R1,=F'3'                                        XA0054DK         
         SLL   R1,6                                            XA0054DK         
         STC   R1,VCSBUF                                       XA0054DK         
         NI    VMPSW+2,X'3F'                                   XA0054DK         
         OC    VMPSW+2(1),VCSBUF                               XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSSTCRW XC    VCSBUF(4),VCSBUF  STCRW: NO CRW PENDING         XA0054DK         
         LA    R4,1                                            XA0054DK         
         BAL   R9,STOREOP                                      XA0054DK         
         B     VCSCC1                                          XA0054DK         
*                                                              XA0054DK         
VCSSTSCH BAL   R9,BLDSCHIB    STSCH: 52 BYTES                  XA0054DK         
         LA    R4,13                                           XA0054DK         
         BAL   R9,STOREOP                                      XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSMSCH  BAL   R9,OPADDR      MSCH: THE PMCW                   XA0054DK         
         LR    R5,R1                                           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,7                                            XA0054DK         
         LA    R0,1           FETCH                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         MVC   ENTIPRM(4,R3),VCSBUF                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         IC    R0,VCSBUF+4                                     XA0054DK         
         SRL   R0,3                                            XA0054DK         
         N     R0,F7                                           XA0054DK         
         STC   R0,ENTISC(R3)                                   XA0054DK         
         IC    R0,VCSBUF+5    MEASUREMENT MODE, MULTIPATH      XA0054DK         
         N     R0,=F'28'                                       XA0054DK         
         STC   R0,ENTPM5(R3)                                   XA0054DK         
         IC    R0,VCSBUF+27   CONCURRENT SENSE, XMWME, MBFC:   XA0054DK         
         N     R0,F7          LINUX'S CIO_CHECK_CONFIG READS   XA0054DK         
         STC   R0,ENTPM27(R3) THEM BACK WITH STSCH             XA0054DK         
         MVC   ENTMBI(2,R3),VCSBUF+12                          XA0054DK         
         NI    ENTFLG(R3),255-ENTENAB                          XA0054DK         
         TM    VCSBUF+5,X'80' ENABLED?                         XA0054DK         
         BZ    VCSEXIT                                         XA0054DK         
         OI    ENTFLG(R3),ENTENAB                              XA0054DK         
         B     VCSEXIT                                         XA0054DK         
*                                                              XA0054DK         
VCSSSCH  TM    VCHTYPE,VCHSEL A CTCA'S CHANNEL IS FORCED TO    XA0054DK         
         BZ    SSCHS1         SELECTOR: A READ PENDING ON ONE  XA0054DK         
         MVI   VCHTYPE,VCHBMX ADAPTER WOULD BLOCK THE OTHER    XA0054DK         
SSCHS1   TM    ENTFLG(R3),ENTPEND  SSCH                        XA0054DK         
         BO    VCSCC1         STATUS PENDING                   XA0054DK         
         TM    ENTFLG(R3),ENTACT                               XA0054DK         
         BO    VCSCC2         BUSY                             XA0054DK         
         BAL   R9,OPADDR      THE ORB                          XA0054DK         
         LR    R5,R1                                           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,3                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         MVC   ENTIPRM(4,R3),VCSBUF                            XA0054DK         
         BAL   R9,UNCVT       A CHAIN LEFT CONVERTED: BACK     XA0054DK         
         NI    ENTFLG(R3),255-ENTFMT1-ENTSOL                   XA0054DK         
         NI    ENTFLG2(R3),255-ENTPRIM                         XA0054DK         
         L     R0,VCSBUF+8    CCW ADDRESS                      XA0054DK         
         N     R0,X7FFF                                        XA0054DK         
         ST    R0,ENTCCW(R3)                                   XA0054DK         
         TM    VCSBUF+5,X'80' FORMAT-1 CCWS?                   XA0054DK         
         BZ    SSCHF0                                          XA0054DK         
         OI    ENTFLG(R3),ENTFMT1                              XA0054DK         
         LA    R0,1           CONVERTED IN PLACE TO            XA0054DK         
         BAL   R9,CVTCHN      FORMAT 0 FOR DMKVSI/DMKCCW,      XA0054DK         
         OI    ENTFLG2(R3),ENTCVT  BACK AT TSCH                XA0054DK         
SSCHF0   BAL   R9,SIDCHK      SENSE ID: OURS                   XA0054DK         
         TM    ENTFLG2(R3),ENTSID                              XA0054DK         
         BO    SSCHSID                                         XA0054DK         
         L     R0,VCSBUF+8    CCW ADDRESS                      XA0054DK         
         N     R0,XRIGHT24                                     XA0054DK         
         SR    R1,R1                                           XA0054DK         
         IC    R1,VCSBUF+4    KEY                              XA0054DK         
         SRL   R1,4                                            XA0054DK         
         SLL   R1,28                                           XA0054DK         
         OR    R0,R1                                           XA0054DK         
         O     R0,=X'01000000'  M7.10: THE CAW GOES TO DMKVSI  XA0054DK         
         ST    R0,DMKVCSCW    IN DMKVCSCW (X01 MARKS IT),      XA0054DK         
*                             NOT AT GUEST X48: PAGE 0 IS      XA0054DK         
*                             THE GUESTS STORAGE (A 4-BYTE     XA0054DK         
*                             HOLE IN LINUX DATA, I-256)       XA0054DK         
*  I-287: A VIRTUAL CTCA'S SSCH WAITS IN DMKVCA FOR THE        XA0054DK         
*  OTHER SIDE'S SSCH, WHICH THE LOCK WOULD HOLD BACK (IT       XA0054DK         
*  SPINS ON ITS B233): THE LOCK GOES BEFORE DMKVSI. DMKVSI     XA0054DK         
*  TAKES DMKVCSCW AT ONCE; NOTHING ELSE HERE IS SHARED.        XA0054DK         
         BAL   R9,FINDSN      R6-R8 (R3 KEPT)                  XA0054DK         
         CLI   VDEVTYPE,TYPCTCA                                XA0054DK         
         BNE   SSCHLK                                          XA0054DK         
         TM    VDEVSTAT,VDEVDED                                XA0054DK         
         BO    SSCHLK                                          XA0054DK         
         C     R11,VCSLOCK                                     XA0054DK         
         BNE   SSCHLK                                          XA0054DK         
         XC    VCSLOCK,VCSLOCK                                 XA0054DK         
SSCHLK   OI    ENTFLG(R3),ENTACT                               XA0054DK         
         MVI   VCSOP,C'S'                                      XA0054DK         
         MVC   VMINST(2),SIOOP   SIO VDEV                      XA0054DK         
VCSVSI   STH   R13,VMINST+2                                    XA0054DK         
         GOTO  DMKVSIEX                                        XA0054DK         
*                                                              XA0054DK         
*  A SENSE ID: ENDED HERE, ITS STATUS QUEUED LIKE SSCC1'S      XA0054DK         
SSCHSID  BAL   R9,SIDDO                                        XA0054DK         
         NI    VCSBUF+4,X'F0' THE ORB'S KEY                    XA0054DK         
         OC    VCSCCW(1),VCSBUF+4                              XA0054DK         
         MVC   VCSBUF(8),VCSCCW                                XA0054DK         
         OI    ENTFLG(R3),ENTACT                               XA0054DK         
         B     SSCC1Q                                          XA0054DK         
*                                                              XA0054DK         
VCSTSCH  BAL   R9,OPADDR      TSCH: THE IRB                    XA0054DK         
         ST    R1,VCSADDR                                      XA0054DK         
         TM    ENTFLG(R3),ENTPEND                              XA0054DK         
         BO    TSCHIRB                                         XA0054DK         
         TM    VDEVSTAT,VDEVCHAN+VDEVPEND                      XA0054DK         
         BNZ   TSCHTIO        S/370 STATUS STILL QUEUED        XA0054DK         
         BAL   R9,BLDIRB      NONE: CC 1                       XA0054DK         
         BAL   R9,PUTIRB                                       XA0054DK         
         B     VCSCC1                                          XA0054DK         
TSCHIRB  BAL   R9,UNCVT                                        XA0054DK         
         BAL   R9,BLDIRB                                       XA0054DK         
         BAL   R9,TSCLEAR                                      XA0054DK         
         BAL   R9,PUTIRB                                       XA0054DK         
         B     VCSEXIT                                         XA0054DK         
TSCHTIO  MVI   VCSOP,C'T'     COLLECT IT WITH A TIO            XA0054DK         
         MVC   VMINST(2),TIOOP                                 XA0054DK         
         B     VCSVSI                                          XA0054DK         
*                                                              XA0054DK         
VCSTPI   BAL   R9,OPADDR      TPI                              XA0054DK         
         ST    R1,VCSADDR                                      XA0054DK         
         SR    R1,R1                                           XA0054DK         
TPILOOP  ST    R1,VCSSUB                                       XA0054DK         
         BAL   R9,FINDSUB                                      XA0054DK         
         BNZ   VCSEXIT        NONE QUEUED: CC 0                XA0054DK         
         TM    VDEVSTAT,VDEVCHAN+VDEVPEND                      XA0054DK         
         BNZ   TPITIO                                          XA0054DK         
         L     R1,VCSSUB                                       XA0054DK         
         LA    R1,1(,R1)                                       XA0054DK         
         B     TPILOOP                                         XA0054DK         
TPITIO   MVI   VCSOP,C'P'                                      XA0054DK         
         MVC   VMINST(2),TIOOP                                 XA0054DK         
         B     VCSVSI                                          XA0054DK         
*                                                              XA0054DK         
VCSCSCH  BAL   R9,UNCVT                                        XA0054DK         
         NI    ENTFLG(R3),255-ENTACT-ENTPEND-ENTSOL            XA0054DK         
         OI    ENTFLG(R3),ENTPEND  CLEAR FUNCTION: STATUS      XA0054DK         
         OI    ENTFLG2(R3),ENTCLR  PENDING FOR TSCH            XA0054DK         
         CLI   VMINST+1,X'31' HSCH: THE HALT FUNCTION          XA0054DK         
         BNE   CSCHQ                                           XA0054DK         
         NI    ENTFLG2(R3),255-ENTCLR                          XA0054DK         
         OI    ENTFLG2(R3),ENTHLT                              XA0054DK         
*  AND AN I/O INTERRUPTION, AS THE CHANNEL SUBSYSTEM MAKES     XA0054DK         
*  ONE: LINUX'S CTCM HALTS A CHANNEL AND WAITS FOR IT (LX118:  XA0054DK         
*  CTC0 STUCK IN STARTWAIT). NO DEVICE STATUS, A ZERO CSW.     XA0054DK         
CSCHQ    XC    VCSBUF(8),VCSBUF                                XA0054DK         
         B     SSCC1Q                                          XA0054DK         
*                                                              XA0054DK         
* DMKVCSSE: GOTO FROM DMKVSJ TESTEC (ESA/390 GUEST). R2 =      XA0054DK         
* THE SIO/TIO CONDITION CODE (X'00'-X'30'), R13 = THE DEVICE.  XA0054DK         
*                                                              XA0054DK         
DMKVCSSE L     R12,AVCSSE-DMKVCSSE(,R12)                       XA0054DK         
         XC    DMKVCSCW,DMKVCSCW  I-256: A CAW NOT TAKEN       XA0054DK         
         TM    VMVCSFL,X'80'  OURS ONLY IF DMKVCS SET VCSOP:   XA0054DK         
         BZ    SENOTME        THE IPL SIMULATOR'S OWN SIO      XA0054DK         
         BAL   R9,GETTAB      AND TIO GO BACK                  XA0054DK         
         CLI   VCSOP,0                                         XA0054DK         
         BE    SENOTME                                         XA0054DK         
         STC   R2,VCSCCX      (R10 NOT YET SET)                XA0054DK         
         BAL   R9,GETTAB                                       XA0054DK         
         MVC   VCSCC,VCSCCX                                    XA0054DK         
         CLI   VCSOP,C'S'                                      XA0054DK         
         BE    SSEND                                           XA0054DK         
         CLI   VCSOP,C'T'                                      XA0054DK         
         BE    TSEND                                           XA0054DK         
         CLI   VCSOP,C'P'                                      XA0054DK         
         BE    TPEND                                           XA0054DK         
         B     SEBACK                                          XA0054DK         
SSEND    MVI   VCSOP,0        SSCH                             XA0054DK         
         BAL   R9,GETENT                                       XA0054DK         
         CLI   VCSCC,0                                         XA0054DK         
         BE    SEBACK         STARTED                          XA0054DK         
         CLI   VCSCC,X'10'                                     XA0054DK         
         BE    SSCC1                                           XA0054DK         
         NI    ENTFLG(R3),255-ENTACT                           XA0054DK         
         BAL   R9,UNCVT       NOT STARTED: CC 2, CC 3          XA0054DK         
         B     SEBACK                                          XA0054DK         
*  SIO CC 1, CSW STORED (AN IMMEDIATE COMMAND, E.G. THE        XA0054DK         
*  NOP OF A SENSE ID): A CHANNEL SUBSYSTEM STARTS IT (CC 0)    XA0054DK         
*  AND MAKES THE STATUS PENDING. QUEUED AS A VIRTUAL           XA0054DK         
*  INTERRUPTION, AS DMKVSP DOES: DMKDSP PRESENTS IT            XA0054DK         
*  (DMKVCSIN), OR A TSCH OF A DISABLED GUEST COLLECTS IT       XA0054DK         
*  WITH TIO (LINUX'S CCW_DEVICE_WAIT_IDLE).                    XA0054DK         
SSCC1    LA    R5,X'40'                                        XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,2                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO     THE CSW DMKVSJ STORED            XA0054DK         
SSCC1Q   LA    R15,VCSBUF                                      XA0054DK         
         BAL   R9,QSTAT                                        XA0054DK         
         MVI   VCSCC,0                                         XA0054DK         
         B     SEBACK                                          XA0054DK         
*  QSTAT: R15 -> A CSW FOR DEVICE R13, QUEUED AS ITS PENDING   XA0054DK         
*  I/O INTERRUPTION (SSCC1Q, DMKVCSC1). R14 = THE RETURN.      XA0054DK         
QSTAT    LR    R14,R9                                          XA0054DK         
         BAL   R9,FINDSN      R6-R8: THE DEVICE'S BLOCKS       XA0054DK         
         MVC   VDEVCSW,0(R15) DMKDSP'S CHANNEL-END PATH        XA0054DK         
         OI    VDEVSTAT,VDEVCHAN  (POST) TAKES THE WHOLE CSW   XA0054DK         
         OI    VCHSTAT,VCHCEPND   FROM VDEVCSW; VDEVPEND'S     XA0054DK         
         TM    VCHTYPE,VCHSEL     A SELECTOR CHANNEL NAMES     XA0054DK         
         BZ    *+8                THE DEVICE (DSP001 IF NOT)   XA0054DK         
         STH   R13,VCHCEDEV                                    XA0054DK         
         OI    VCUSTAT,VCUCEPND   ONLY VDEVINTS                XA0054DK         
         L     R2,=A(DMKVIOMK)                                 XA0054DK         
         LH    R4,VDEVADD                                      XA0054DK         
         AR    R4,R4                                           XA0054DK         
         AR    R4,R2                                           XA0054DK         
         OC    VCUDVINT,0(R4)                                  XA0054DK         
         LH    R4,VCUADD                                       XA0054DK         
         SRL   R4,3                                            XA0054DK         
         AR    R4,R2                                           XA0054DK         
         OC    VCHCUINT,0(R4)                                  XA0054DK         
         LH    R4,VCHADD                                       XA0054DK         
         SRL   R4,7                                            XA0054DK         
         AR    R4,R2                                           XA0054DK         
         OC    VMIOINT,0(R4)                                   XA0054DK         
         OI    VMPEND,VMIOPND                                  XA0054DK         
         BR    R14                                             XA0054DK         
TSEND    MVI   VCSOP,0        TSCH                             XA0054DK         
         BAL   R9,GETENT                                       XA0054DK         
         CLI   VCSCC,X'10'    TIO STORED A CSW?                XA0054DK         
         BNE   TSENONE                                         XA0054DK         
         BAL   R9,GETCSW                                       XA0054DK         
         BAL   R9,UNCVT                                        XA0054DK         
         BAL   R9,BLDIRB                                       XA0054DK         
         BAL   R9,TSCLEAR                                      XA0054DK         
         BAL   R9,PUTIRB                                       XA0054DK         
         MVI   VCSCC,0                                         XA0054DK         
         B     SEBACK                                          XA0054DK         
TSENONE  BAL   R9,BLDIRB                                       XA0054DK         
         BAL   R9,PUTIRB                                       XA0054DK         
         MVI   VCSCC,X'10'                                     XA0054DK         
         B     SEBACK                                          XA0054DK         
TPEND    MVI   VCSOP,0        TPI                              XA0054DK         
         CLI   VCSCC,X'10'                                     XA0054DK         
         BNE   TPENONE                                         XA0054DK         
         BAL   R9,GETENT                                       XA0054DK         
         BAL   R9,GETCSW                                       XA0054DK         
         L     R1,VCSSUB                                       XA0054DK         
         O     R1,SSIDW                                        XA0054DK         
         ST    R1,VCSBUF      SUBSYSTEM ID                     XA0054DK         
         MVC   VCSBUF+4(4),ENTIPRM(R3)                         XA0054DK         
         L     R5,VCSADDR                                      XA0054DK         
         LTR   R5,R5                                           XA0054DK         
         BNZ   *+8                                             XA0054DK         
         LA    R5,X'B8'       OPERAND 0: THE LOWCORE           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,2                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         MVI   VCSCC,X'10'                                     XA0054DK         
         B     SEBACK                                          XA0054DK         
TPENONE  MVI   VCSCC,0                                         XA0054DK         
SEBACK   NI    VMPSW+2,X'CF'                                   XA0054DK         
         OC    VMPSW+2(1),VCSCC                                XA0054DK         
         L     R1,VCRLAST                                      XA0054DK         
         MVC   12(1,R1),VMPSW+2                                XA0054DK         
         MVI   13(R1),C'S'                                     XA0054DK         
         NI    VMDSTAT,X'FF'-VMTIO                             XA0054DK         
         NI    VMRSTAT,X'FF'-VMEXWAIT                          XA0054DK         
         C     R11,VCSLOCK    RELEASE THE LOCK (M4B.3)         XA0054DK         
         BNE   *+10                                            XA0054DK         
         XC    VCSLOCK,VCSLOCK                                 XA0054DK         
         GOTO  DMKDSPCH                                        XA0054DK         
SENOTME  L     R15,=V(DMKVSJTE)  DMKVSJ'S OWN EXIT, R2 AS IT   XA0054DK         
         L     R12,=V(DMKVSJEX)  WAS (BASE LAST)               XA0054DK         
         BR    R15                                             XA0054DK         
*                                                              XA0054DK         
* DMKVCSIN: BALR FROM DMKDSP STORECSW. R0 = DEVICE, R4-R5 =    XA0054DK         
* ITS CSW. KEEPS THE STATUS PENDING FOR TSCH; RETURNS R1 =     XA0054DK         
* SUBCHANNEL NUMBER, R3 = INTERRUPTION PARAMETER.              XA0054DK         
*                                                              XA0054DK         
DMKVCSIN STM   R14,R13,VCSSAVI-DMKVCSIN(R15)                   XA0054DK         
         L     R12,AVCSIN-DMKVCSIN(,R15)                       XA0054DK         
         LR    R13,R0                                          XA0054DK         
         BAL   R9,GETTAB                                       XA0054DK         
         BAL   R9,GETENT                                       XA0054DK         
         STM   R4,R5,ENTCSW(R3)                                XA0054DK         
         BAL   R9,PENDING                                      XA0054DK         
         L     R0,ENTIPRM(R3)                                  XA0054DK         
         ST    R0,VCSSAVI+20  R3                               XA0054DK         
         BAL   R9,FINDSN                                       XA0054DK         
         ST    R1,VCSSAVI+12  R1                               XA0054DK         
         LM    R14,R13,VCSSAVI  (R13 TOO: IT IS THE CALLER'S)  XA0054DK         
         BR    R14                                             XA0054DK         
*                                                              XA0054DK         
* DMKVCSSN: BALR. R1 = DEVICE IN, ITS SUBCHANNEL NUMBER OUT.   XA0054DK         
*                                                              XA0054DK         
DMKVCSSN STM   R14,R13,VCSSAVN-DMKVCSSN(R15)                   XA0054DK         
         L     R12,AVCSSN-DMKVCSSN(,R15)                       XA0054DK         
         LR    R13,R1                                          XA0054DK         
         NI    VMVCSFL,X'7F'  IPL IS A SYSTEM RESET: BACK      XA0054DK         
         ICM   R10,15,VMVCSIX-2  TO S/370 I/O UNTIL THE GUEST  XA0054DK         
         N     R10,F65535     USES THE CHANNEL SUBSYSTEM       XA0054DK         
         BZ    SNFIND                                          XA0054DK         
         BAL   R9,GETTAB                                       XA0054DK         
         LA    R3,VCSHDRL(,R10)    SUBSYSTEM, EVERY            XA0054DK         
         LA    R0,VCSNENT          SUBCHANNEL IDLE AND         XA0054DK         
SNRESET  MVI   ENTFLG(R3),0        DISABLED                    XA0054DK         
         LA    R3,ENTLEN(,R3)                                  XA0054DK         
         BCT   R0,SNRESET                                      XA0054DK         
SNFIND   DS    0H                                              XA0054DK         
         BAL   R9,FINDSN                                       XA0054DK         
         ST    R1,VCSSAVN+12                                   XA0054DK         
         LM    R14,R13,VCSSAVN                                 XA0054DK         
         BR    R14                                             XA0054DK         
*                                                              XA0054DK         
* DMKVCSAR: BALR FROM DMKDSP LDRPSW, R11 = THE ESA/390 GUEST   XA0054DK         
* ABOUT TO RUN. THE ACCESS REGISTERS ARE THE GUEST'S AND CP    XA0054DK         
* NEVER SAVED THEM: TWO LINUX GUESTS SHARED ONE SET (THE       XA0054DK         
* SECOND ONE'S INIT RAN WITH THE FIRST ONE'S A0, ITS TLS       XA0054DK         
* POINTER: SIGSEGV). THE SET IN THE CPU BELONGS TO THE TABLE   XA0054DK         
* IN VCSAROWN; ON A SWITCH IT IS SAVED THERE (TABLES ARE       XA0054DK         
* NEVER FREED) AND THIS GUEST'S IS LOADED.                     XA0054DK         
*                                                              XA0054DK         
DMKVCSAR STM   R14,R13,VCSSAVA-DMKVCSAR(R15)                   XA0054DK         
         L     R12,AVCSAR-DMKVCSAR(,R15)                       XA0054DK         
         BAL   R9,GETTAB                                       XA0054DK         
         C     R10,VCSAROWN                                    XA0054DK         
         BE    VCSARX                                          XA0054DK         
         ICM   R1,15,VCSAROWN                                  XA0054DK         
         BZ    VCSARL                                          XA0054DK         
         DC    X'9B0F',AL2(X'1000'+VCSAR-VCSTAB) STAM 0,15     XA0054DK         
VCSARL   DC    X'9A0F',AL2(X'A000'+VCSAR-VCSTAB) LAM 0,15      XA0054DK         
         ST    R10,VCSAROWN                                    XA0054DK         
VCSARX   LM    R14,R13,VCSSAVA                                 XA0054DK         
         BR    R14                                             XA0054DK         
         LTORG ,              WITHIN R12'S 4 KB                XA0054DK         
*                                                              XA0054DK         
* SUBROUTINES, ALL BAL R9.                                     XA0054DK         
*                                                              XA0054DK         
OPADDR   L     R1,VMINST      R1 = THE S-OPERAND ADDRESS       XA0054DK         
         N     R1,F4095                                        XA0054DK         
         SR    R2,R2                                           XA0054DK         
         IC    R2,VMINST+2                                     XA0054DK         
         SRL   R2,4                                            XA0054DK         
         SLL   R2,2                                            XA0054DK         
         LTR   R2,R2                                           XA0054DK         
         BZ    OPADDR1                                         XA0054DK         
         A     R1,VMGPRS(R2)                                   XA0054DK         
OPADDR1  TM    VMFSTAT,VMAM31                                  XA0054DK         
         BO    OPADDR3                                         XA0054DK         
         TM    VMPSW+4,X'80'  ESA/390: THE PSW'S AMODE (A      XA0054DK         
         BO    OPADDR3        STACK ABOVE 16 MB: LX133)        XA0054DK         
         N     R1,XRIGHT24                                     XA0054DK         
OPADDR3  N     R1,X7FFF                                        XA0054DK         
         BR    R9                                              XA0054DK         
STOREOP  ST    R9,VCSLINK     R4 WORDS OF VCSBUF TO THE        XA0054DK         
         BAL   R9,OPADDR      OPERAND: FALLS INTO GUESTIO      XA0054DK         
         LR    R5,R1                                           XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         SR    R0,R0                                           XA0054DK         
         L     R9,VCSLINK                                      XA0054DK         
*  GUESTIO: R4 WORDS BETWEEN GUEST REAL R5 AND CP R6.          XA0054DK         
*  R0 = 0 STORES INTO THE GUEST, R0 = 1 FETCHES.               XA0054DK         
GUESTIO  LR    R1,R5                                           XA0054DK         
         TRANS 2,1,OPT=(BRING,DEFER,AMODE31),ADEX=GIOEND       XA0054DK         
         LTR   R0,R0                                           XA0054DK         
         BNZ   GIOGET                                          XA0054DK         
         MVC   0(4,R2),0(R6)                                   XA0054DK         
         B     GIONEXT                                         XA0054DK         
GIOGET   MVC   0(4,R6),0(R2)                                   XA0054DK         
GIONEXT  LA    R6,4(,R6)                                       XA0054DK         
         AL    R5,F4                                           XA0054DK         
         BCT   R4,GUESTIO                                      XA0054DK         
GIOEND   BR    R9                                              XA0054DK         
         LTORG ,              TRANS'S LITERAL, IN REACH        XA0054DK         
GETCSW   ST    R9,VCSLINK     THE CSW AT GUEST X'40'           XA0054DK         
         LA    R5,X'40'                                        XA0054DK         
         LA    R6,ENTCSW(,R3)                                  XA0054DK         
         LA    R4,2                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         L     R9,VCSLINK                                      XA0054DK         
PENDING  OI    ENTFLG(R3),ENTPEND                              XA0054DK         
         TM    ENTFLG(R3),ENTACT                               XA0054DK         
         BZR   R9                                              XA0054DK         
         OI    ENTFLG(R3),ENTSOL   SOLICITED                   XA0054DK         
         BR    R9                                              XA0054DK         
BLDIRB   XC    VCSBUF(64),VCSBUF  IRB: SCSW, ESW, ECW          XA0054DK         
         LA    R1,VCSBUF                                       XA0054DK         
         B     BLDSCSW                                         XA0054DK         
PUTIRB   L     R5,VCSADDR                                      XA0054DK         
         LA    R6,VCSBUF                                       XA0054DK         
         LA    R4,16                                           XA0054DK         
         SR    R0,R0                                           XA0054DK         
         B     GUESTIO                                         XA0054DK         
BLDSCHIB XC    VCSBUF(64),VCSBUF                               XA0054DK         
         MVC   VCSBUF(4),ENTIPRM(R3)                           XA0054DK         
         SR    R0,R0                                           XA0054DK         
         IC    R0,ENTISC(R3)                                   XA0054DK         
         SLL   R0,3                                            XA0054DK         
         STC   R0,VCSBUF+4                                     XA0054DK         
         MVI   VCSBUF+5,X'01' VALID                            XA0054DK         
         TM    ENTFLG(R3),ENTENAB                              XA0054DK         
         BZ    *+8                                             XA0054DK         
         OI    VCSBUF+5,X'80' ENABLED                          XA0054DK         
         STH   R13,VCSBUF+6   DEVICE NUMBER                    XA0054DK         
         MVC   VCSBUF+8(8),PMCWPATH                            XA0054DK         
         OC    VCSBUF+5(1),ENTPM5(R3)  WHAT MSCH SET           XA0054DK         
         MVC   VCSBUF+12(2),ENTMBI(R3)                         XA0054DK         
         MVC   VCSBUF+27(1),ENTPM27(R3)                        XA0054DK         
         LR    R0,R13                                          XA0054DK         
         SRL   R0,8                                            XA0054DK         
         STC   R0,VCSBUF+16   CHPID: THE CHANNEL               XA0054DK         
         LA    R1,VCSBUF+28                                    XA0054DK         
*  BLDSCSW: THE SCSW AT R1 FROM THE ENTRY AT R3.               XA0054DK         
BLDSCSW  TM    ENTFLG2(R3),ENTHLT                              XA0054DK         
         BZ    BLDSCSW0                                        XA0054DK         
         MVI   2(R1),X'20'    HALT FUNCTION,                   XA0054DK         
         MVI   3(R1),X'01'    STATUS PENDING                   XA0054DK         
         BR    R9                                              XA0054DK         
BLDSCSW0 TM    ENTFLG2(R3),ENTCLR                              XA0054DK         
         BZ    BLDSCSW1                                        XA0054DK         
         MVI   2(R1),X'10'    CLEAR FUNCTION,                  XA0054DK         
         MVI   3(R1),X'01'    STATUS PENDING                   XA0054DK         
         BR    R9                                              XA0054DK         
BLDSCSW1 TM    ENTFLG(R3),ENTPEND                              XA0054DK         
         BZ    SCSWIDLE                                        XA0054DK         
         MVC   4(4,R1),ENTCSW(R3)                              XA0054DK         
         MVI   4(R1),0        CCW ADDRESS                      XA0054DK         
         MVC   8(4,R1),ENTCSW+4(R3)                            XA0054DK         
         TM    ENTFLG(R3),ENTFMT1                              XA0054DK         
         BZ    *+8                                             XA0054DK         
         MVI   1(R1),X'80'    FORMAT-1 CCWS                    XA0054DK         
         TM    ENTFLG(R3),ENTSOL                               XA0054DK         
         BZ    SCSWUNS                                         XA0054DK         
         MVI   2(R1),X'40'    START FUNCTION                   XA0054DK         
         MVI   3(R1),X'01'    STATUS PENDING:                  XA0054DK         
         TM    ENTFLG2(R3),ENTPRIM  PRIMARY (UNLESS A CE       XA0054DK         
         BO    *+8            CAME FIRST),                     XA0054DK         
         OI    3(R1),X'04'                                     XA0054DK         
*  I-276: A STATUS WITH NEITHER CE NOR DE (THE READER'S UNIT   XA0054DK         
*  EXCEPTION AT END OF FILE, DMKVSP'S CC 1 CASE) ENDED THE     XA0054DK         
*  OPERATION AT ONCE: SECONDARY TOO, OR LINUX'S CIO TAKES IT   XA0054DK         
*  FOR INTERMEDIATE AND WAITS FOR A DEVICE END FOREVER.        XA0054DK         
         TM    ENTCSW+4(R3),X'0C'                              XA0054DK         
         BZ    SCSWSEC                                         XA0054DK         
         TM    ENTCSW+4(R3),X'04'  SECONDARY WITH DEVICE END   XA0054DK         
         BZR   R9                                              XA0054DK         
SCSWSEC  OI    3(R1),X'02'                                     XA0054DK         
         BR    R9                                              XA0054DK         
SCSWUNS  MVI   3(R1),X'11'    ALERT, PENDING                   XA0054DK         
         BR    R9                                              XA0054DK         
SCSWIDLE TM    ENTFLG(R3),ENTACT                               XA0054DK         
         BZR   R9                                              XA0054DK         
         MVI   2(R1),X'44'    START, START PENDING             XA0054DK         
         MVI   3(R1),X'80'    SUBCHANNEL ACTIVE                XA0054DK         
         BR    R9                                              XA0054DK         
*  TSCLEAR: TSCH TOOK THE STATUS. A CHANNEL END WITHOUT        XA0054DK         
*  DEVICE END LEAVES THE SUBCHANNEL ACTIVE FOR THE DE.         XA0054DK         
TSCLEAR  NI    ENTFLG(R3),255-ENTPEND                          XA0054DK         
         TM    ENTFLG2(R3),ENTCLR+ENTHLT                       XA0054DK         
         BZ    TSCLR1                                          XA0054DK         
         NI    ENTFLG2(R3),255-ENTCLR-ENTHLT                   XA0054DK         
         BR    R9                                              XA0054DK         
TSCLR1   DS    0H                                              XA0054DK         
         TM    ENTFLG(R3),ENTSOL                               XA0054DK         
         BZ    TSCL2                                           XA0054DK         
         TM    ENTCSW+4(R3),X'04'  DEVICE END?                 XA0054DK         
         BO    TSCL2                                           XA0054DK         
         TM    ENTCSW+4(R3),X'08'  NOR CHANNEL END (UNIT       XA0054DK         
         BZ    TSCL2          CHECK ALONE): ENDED TOO          XA0054DK         
         OI    ENTFLG2(R3),ENTPRIM                             XA0054DK         
         NI    ENTFLG(R3),255-ENTSOL                           XA0054DK         
         BR    R9                                              XA0054DK         
TSCL2    NI    ENTFLG(R3),255-ENTACT-ENTSOL                    XA0054DK         
         NI    ENTFLG2(R3),255-ENTPRIM                         XA0054DK         
         BR    R9                                              XA0054DK         
*  UNCVT: A CHAIN CVTCHN CONVERTED GOES BACK TO FORMAT 1.      XA0054DK         
UNCVT    TM    ENTFLG2(R3),ENTCVT                              XA0054DK         
         BZR   R9                                              XA0054DK         
         ST    R9,VCSLNK3                                      XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,CVTCHN                                       XA0054DK         
         NI    ENTFLG2(R3),255-ENTCVT                          XA0054DK         
         L     R9,VCSLNK3                                      XA0054DK         
         BR    R9                                              XA0054DK         
*  SIDCHK: A LONE SENSE ID (X'E4'), WHICH VM/370'S VIRTUAL     XA0054DK         
*  DEVICES DO NOT KNOW, IS ANSWERED HERE (SSCHSID) FROM THE    XA0054DK         
*  DEVICE TYPE (SIDTAB): LINUX'S CIO RECOGNISES EVERY DEVICE   XA0054DK         
*  THIS WAY. CHAIN IN FORMAT 0 HERE; R8 = VDEVBLOK.            XA0054DK         
SIDCHK   ST    R9,VCSLNK5                                      XA0054DK         
         NI    ENTFLG2(R3),255-ENTSID                          XA0054DK         
         TM    VDEVSTAT,VDEVDED  A DEDICATED DEVICE ANSWERS    XA0054DK         
         BO    SIDCX          ITSELF (9.12B: LCS IS 3088-60)   XA0054DK         
         L     R2,VCRLAST     RING: C'1' SIDCHK REACHED,       XA0054DK         
         MVI   14(R2),C'1'    C'2' TYPE KNOWN, C'3' AN E4      XA0054DK         
         MVC   15(1,R2),VDEVTYPC                               XA0054DK         
         BAL   R9,SIDLOOK                                      XA0054DK         
         LTR   R1,R1                                           XA0054DK         
         BZ    SIDCX          A TYPE WE DO NOT KNOW            XA0054DK         
         L     R2,VCRLAST                                      XA0054DK         
         MVI   14(R2),C'2'                                     XA0054DK         
         LA    R0,SIDTAB      ITS SIDTAB ENTRY, AS AN INDEX    XA0054DK         
         SR    R1,R0                                           XA0054DK         
         SRL   R1,3                                            XA0054DK         
         STC   R1,ENTSIDX(R3)                                  XA0054DK         
         L     R5,ENTCCW(R3)                                   XA0054DK         
         LA    R6,VCSCCW                                       XA0054DK         
         LA    R4,2                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         L     R2,VCRLAST                                      XA0054DK         
         MVC   15(1,R2),VCSCCW                                 XA0054DK         
         TM    VCSCCW+4,X'C0' CHAINED: LEFT ALONE              XA0054DK         
         BNZ   SIDCX                                           XA0054DK         
         CLI   VCSCCW,X'03'   A LONE NOP (LINUX'S PATH         XA0054DK         
         BNE   SIDC4          VERIFICATION) ENDS HERE: THE     XA0054DK         
         MVI   ENTSIDX(R3),255  CONSOLE'S NOP NEVER REACHES    XA0054DK         
         B     SIDC5          DMKVCSSE                         XA0054DK         
SIDC4    CLI   VCSCCW,X'E4'                                    XA0054DK         
         BNE   SIDCX                                           XA0054DK         
SIDC5    MVI   14(R2),C'3'                                     XA0054DK         
         MVC   ENTSIDA(4,R3),VCSCCW                            XA0054DK         
         MVC   ENTSIDC(2,R3),VCSCCW+6                          XA0054DK         
         OI    ENTFLG2(R3),ENTSID                              XA0054DK         
SIDCX    L     R9,VCSLNK5                                      XA0054DK         
         BR    R9                                              XA0054DK         
*  SIDDO: THE SENSE ID DATA STORED; VCSCCW = THE ENDING CSW    XA0054DK         
*  (CCW+8, CHANNEL END AND DEVICE END, THE RESIDUAL COUNT).    XA0054DK         
SIDDO    ST    R9,VCSLNK5                                      XA0054DK         
         NI    ENTFLG2(R3),255-ENTSID                          XA0054DK         
         LH    R7,ENTSIDC(R3)  NOTHING STORED: ALL RESIDUAL    XA0054DK         
         CLI   ENTSIDX(R3),255  THE NOP                        XA0054DK         
         BE    SIDD2                                           XA0054DK         
         CH    R7,H7                                           XA0054DK         
         BL    SIDD2                                           XA0054DK         
         L     R5,ENTSIDA(R3)  LINUX'S SENSEID NEED NOT BE     XA0054DK         
         N     R5,XRIGHT24    WORD-ALIGNED: 3 WORDS AROUND     XA0054DK         
         SRL   R5,2           IT FETCHED, 7 BYTES MERGED IN,   XA0054DK         
         SLL   R5,2                                            XA0054DK         
         LA    R6,VCSVIS      STORED BACK                      XA0054DK         
         LA    R4,3                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         SR    R1,R1                                           XA0054DK         
         IC    R1,ENTSIDX(R3)                                  XA0054DK         
         SLL   R1,3                                            XA0054DK         
         LA    R1,SIDTAB(R1)                                   XA0054DK         
         SR    R2,R2                                           XA0054DK         
         IC    R2,ENTSIDA+3(R3)                                XA0054DK         
         SLL   R2,30                                           XA0054DK         
         SRL   R2,30                                           XA0054DK         
         LA    R2,VCSVIS(R2)                                   XA0054DK         
         MVI   0(R2),X'FF'                                     XA0054DK         
         MVC   1(6,R2),2(R1)                                   XA0054DK         
         L     R5,ENTSIDA(R3)                                  XA0054DK         
         N     R5,XRIGHT24                                     XA0054DK         
         SRL   R5,2                                            XA0054DK         
         SLL   R5,2                                            XA0054DK         
         LA    R6,VCSVIS                                       XA0054DK         
         LA    R4,3                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO                                      XA0054DK         
         LH    R7,ENTSIDC(R3)  RESIDUAL: 7 BYTES STORED        XA0054DK         
         SH    R7,H7                                           XA0054DK         
SIDD2    L     R0,ENTCCW(R3)                                   XA0054DK         
         AL    R0,F8                                           XA0054DK         
         N     R0,XRIGHT24                                     XA0054DK         
         ST    R0,VCSCCW                                       XA0054DK         
         MVI   VCSCCW+4,X'0C'                                  XA0054DK         
         MVI   VCSCCW+5,0                                      XA0054DK         
         STH   R7,VCSCCW+6                                     XA0054DK         
         L     R9,VCSLNK5                                      XA0054DK         
         BR    R9                                              XA0054DK         
SIDLOOK  LA    R1,SIDTAB      R1 = SIDTAB ENTRY OR 0           XA0054DK         
SIDL1    CLI   0(R1),X'FF'                                     XA0054DK         
         BE    SIDL0                                           XA0054DK         
         CLC   0(1,R1),VDEVTYPC                                XA0054DK         
         BNE   SIDL2                                           XA0054DK         
         CLI   1(R1),X'FF'    ANY TYPE OF THE CLASS            XA0054DK         
         BER   R9                                              XA0054DK         
         CLC   1(1,R1),VDEVTYPE                                XA0054DK         
         BER   R9                                              XA0054DK         
SIDL2    LA    R1,8(,R1)                                       XA0054DK         
         B     SIDL1                                           XA0054DK         
SIDL0    SR    R1,R1                                           XA0054DK         
         BR    R9                                              XA0054DK         
*  CVTCHN: THE CHAIN AT ENTCCW, IN PLACE. R0 = 1: FORMAT 1     XA0054DK         
*  TO FORMAT 0; R0 = 0: BACK. FOLLOWS CD/CC AND TIC; A TIC TO  XA0054DK         
*  A CCW ALREADY DONE (SEARCH LOOP) GOES ON PAST THE TIC, FOR  XA0054DK         
*  THE STATUS-MODIFIER PATH. M7.9: ANY LENGTH -- WHAT IS       XA0054DK         
*  DONE IS KEPT AS SEGMENTS (FIRST, LAST CCW), ONE PER TIC     XA0054DK         
*  TARGET, AT MOST 32 OF THEM, NOT AS SINGLE CCWS.             XA0054DK         
CVTCHN   ST    R9,VCSLNK2                                      XA0054DK         
         STC   R0,VCSDIR                                       XA0054DK         
         L     R7,ENTCCW(R3)                                   XA0054DK         
         XC    VCSNVIS,VCSNVIS                                 XA0054DK         
CVNEWSG  L     R1,VCSNVIS     A SEGMENT STARTS AT R7           XA0054DK         
         LA    R0,32                                           XA0054DK         
         CR    R1,R0                                           XA0054DK         
         BNL   CVDONE                                          XA0054DK         
         SLL   R1,3                                            XA0054DK         
         LA    R1,VCSVIS(R1)                                   XA0054DK         
         ST    R7,0(,R1)                                       XA0054DK         
         ST    R7,4(,R1)                                       XA0054DK         
         ST    R1,VCSSEGP                                      XA0054DK         
         L     R1,VCSNVIS                                      XA0054DK         
         LA    R1,1(,R1)                                       XA0054DK         
         ST    R1,VCSNVIS                                      XA0054DK         
         B     CVFETCH                                         XA0054DK         
CVLOOP   BAL   R14,CVSEEN     DONE ALREADY?                    XA0054DK         
         BZ    CVDONE                                          XA0054DK         
         L     R1,VCSSEGP     NO: THE SEGMENT GROWS            XA0054DK         
         ST    R7,4(,R1)                                       XA0054DK         
CVFETCH  LR    R5,R7                                           XA0054DK         
         LA    R6,VCSCCW                                       XA0054DK         
         LA    R4,2                                            XA0054DK         
         LA    R0,1                                            XA0054DK         
         BAL   R9,GUESTIO     FETCH IT                         XA0054DK         
         CLI   VCSDIR,1                                        XA0054DK         
         BNE   CVTO1                                           XA0054DK         
         MVC   VCSCFLG,VCSCCW+1   FORMAT 1 -> 0                XA0054DK         
         MVC   VCSCADR,VCSCCW+4                                XA0054DK         
         MVC   VCSNEW(1),VCSCCW                                XA0054DK         
         MVC   VCSNEW+1(3),VCSCCW+5                            XA0054DK         
         MVC   VCSNEW+4(1),VCSCCW+1                            XA0054DK         
         MVI   VCSNEW+5,0                                      XA0054DK         
         MVC   VCSNEW+6(2),VCSCCW+2                            XA0054DK         
         OC    VCSNEW+6(2),VCSNEW+6  COUNT 0 (LINUX'S PATH-    XA0054DK         
         BNZ   CVSTORE        VERIFICATION NOP) IS A CHANNEL   XA0054DK         
         MVI   VCSNEW+7,1     PROGRAM CHECK IN FORMAT 0:       XA0054DK         
         OI    VCSNEW+4,X'20' COUNT 1, SLI (BACK AS COUNT 1)   XA0054DK         
         B     CVSTORE                                         XA0054DK         
CVTO1    MVC   VCSCFLG,VCSCCW+4   FORMAT 0 -> 1                XA0054DK         
         L     R1,VCSCCW                                       XA0054DK         
         N     R1,XRIGHT24                                     XA0054DK         
         ST    R1,VCSCADR                                      XA0054DK         
         MVC   VCSNEW(1),VCSCCW                                XA0054DK         
         MVC   VCSNEW+1(1),VCSCCW+4                            XA0054DK         
         MVC   VCSNEW+2(2),VCSCCW+6                            XA0054DK         
         MVC   VCSNEW+4(4),VCSCADR                             XA0054DK         
CVSTORE  LR    R5,R7                                           XA0054DK         
         LA    R6,VCSNEW                                       XA0054DK         
         LA    R4,2                                            XA0054DK         
         SR    R0,R0                                           XA0054DK         
         BAL   R9,GUESTIO     STORE IT                         XA0054DK         
         CLI   VCSCCW,X'08'   TIC?                             XA0054DK         
         BNE   CVNOTIC                                         XA0054DK         
         ST    R7,VCSTIC                                       XA0054DK         
         L     R7,VCSCADR     ITS TARGET,                      XA0054DK         
         BAL   R14,CVSEEN                                      XA0054DK         
         BNZ   CVNEWSG        NOT DONE: A NEW SEGMENT          XA0054DK         
         L     R7,VCSTIC      OR, ALREADY DONE, PAST THE TIC   XA0054DK         
         AL    R7,F8                                           XA0054DK         
         B     CVLOOP                                          XA0054DK         
CVNOTIC  TM    VCSCFLG,X'C0'  CHAIN DATA OR COMMAND?           XA0054DK         
         BZ    CVDONE                                          XA0054DK         
         AL    R7,F8                                           XA0054DK         
         B     CVLOOP                                          XA0054DK         
CVDONE   L     R9,VCSLNK2                                      XA0054DK         
         BR    R9                                              XA0054DK         
CVSEEN   L     R1,VCSNVIS     CC 0 IF R7 IS IN A SEGMENT       XA0054DK         
         LTR   R1,R1                                           XA0054DK         
         BZ    CVSEEN9                                         XA0054DK         
         LA    R2,VCSVIS                                       XA0054DK         
CVSEEN1  C     R7,0(,R2)                                       XA0054DK         
         BL    CVSEEN2                                         XA0054DK         
         C     R7,4(,R2)                                       XA0054DK         
         BNH   CVSEENY                                         XA0054DK         
CVSEEN2  LA    R2,8(,R2)                                       XA0054DK         
         BCT   R1,CVSEEN1                                      XA0054DK         
CVSEEN9  LTR   R14,R14        CC NOT 0                         XA0054DK         
         BR    R14                                             XA0054DK         
CVSEENY  CR    R7,R7          CC 0                             XA0054DK         
         BR    R14                                             XA0054DK         
*  GETTAB: R10 = THIS USER'S TABLE. VMVCSIX IS ITS SLOT        XA0054DK         
*  NUMBER IN VCSSLOTS (OWNER VMBLOK, TABLE); A SLOT LEFT BY    XA0054DK         
*  A USER WHO LOGGED OFF IS REUSED BY THE NEXT ONE GIVEN THE   XA0054DK         
*  SAME VMBLOK, SO NO TABLE IS LOST TWICE.                     XA0054DK         
GETTAB   LH    R1,VMVCSIX                                      XA0054DK         
         LTR   R1,R1                                           XA0054DK         
         BNP   GTFIND                                          XA0054DK         
         SLL   R1,3                                            XA0054DK         
         A     R1,AVCSSL8     (VCSSLOTS-8, PAST R12'S REACH)   XA0054DK         
         C     R11,0(,R1)     STILL OURS?                      XA0054DK         
         BNE   GTFIND                                          XA0054DK         
         L     R10,4(,R1)                                      XA0054DK         
         BR    R9                                              XA0054DK         
GTFIND   L     R1,AVCSSLOT    A SLOT THIS VMBLOK HAD, OR       XA0054DK         
         LA    R0,VCSNSLOT    A FREE ONE                       XA0054DK         
GTF1     C     R11,0(,R1)                                      XA0054DK         
         BE    GTREUSE                                         XA0054DK         
         LA    R1,8(,R1)                                       XA0054DK         
         BCT   R0,GTF1                                         XA0054DK         
         L     R1,AVCSSLOT                                     XA0054DK         
         LA    R0,VCSNSLOT                                     XA0054DK         
GTF2     ICM   R10,15,0(R1)                                    XA0054DK         
         BZ    GTNEW                                           XA0054DK         
         LA    R1,8(,R1)                                       XA0054DK         
         BCT   R0,GTF2                                         XA0054DK         
         ABEND 1              MORE ESA/390 USERS THAN SLOTS    XA0054DK         
GTNEW    ST    R11,0(,R1)                                      XA0054DK         
         ST    R1,VCSSLOTW                                     XA0054DK         
         LA    R0,VCSTABSZ                                     XA0054DK         
         CALL  DMKFREE                                         XA0054DK         
         LR    R10,R1                                          XA0054DK         
         L     R1,VCSSLOTW                                     XA0054DK         
         ST    R10,4(,R1)                                      XA0054DK         
         B     GTINIT0                                         XA0054DK         
GTREUSE  L     R10,4(,R1)     THE PREVIOUS USER'S TABLE        XA0054DK         
GTINIT0  LR    R0,R1          SLOT NUMBER INTO VMVCSIX         XA0054DK         
         L     R1,AVCSSL8                                      XA0054DK         
         SR    R0,R1                                           XA0054DK         
         SRL   R0,3                                            XA0054DK         
         STH   R0,VMVCSIX                                      XA0054DK         
         XC    0(256,R10),0(R10)                               XA0054DK         
         XC    256(VCSHDRL-256,R10),256(R10)                   XA0054DK         
         LA    R1,VCSHDRL(,R10)                                XA0054DK         
         LA    R0,VCSNENT                                      XA0054DK         
GTINIT   MVC   0(ENTLEN,R1),EMPTYENT                           XA0054DK         
         LA    R1,ENTLEN(,R1)                                  XA0054DK         
         BCT   R0,GTINIT                                       XA0054DK         
         BR    R9                                              XA0054DK         
GETENT   LA    R3,VCSHDRL(,R10)  R3 = THE ENTRY OF R13         XA0054DK         
         LA    R0,VCSNENT                                      XA0054DK         
GESRCH   CH    R13,0(,R3)                                      XA0054DK         
         BER   R9                                              XA0054DK         
         LA    R3,ENTLEN(,R3)                                  XA0054DK         
         BCT   R0,GESRCH                                       XA0054DK         
         LA    R3,VCSHDRL(,R10)                                XA0054DK         
         LA    R0,VCSNENT                                      XA0054DK         
GEFREE   CLC   0(2,R3),EMPTYENT                                XA0054DK         
         BE    GENEW                                           XA0054DK         
         LA    R3,ENTLEN(,R3)                                  XA0054DK         
         BCT   R0,GEFREE                                       XA0054DK         
         LA    R3,VCSHDRL(,R10)  FULL: REUSE THE FIRST         XA0054DK         
GENEW    XC    0(ENTLEN,R3),0(R3)                              XA0054DK         
         STH   R13,0(,R3)                                      XA0054DK         
         BR    R9                                              XA0054DK         
*  FINDSUB: R1 = SUBCHANNEL N. R6-R8 AND R13 = THE N-TH        XA0054DK         
*  DEVICE IN ADDRESS ORDER, CC 0; CC NOT 0 IF THERE IS NONE.   XA0054DK         
FINDSUB  LR    R0,R1                                           XA0054DK         
         SR    R2,R2                                           XA0054DK         
FSCH     LH    R6,VMCHTBL(R2)                                  XA0054DK         
         LTR   R6,R6                                           XA0054DK         
         BM    FSCHN                                           XA0054DK         
         A     R6,VMCHSTRT                                     XA0054DK         
         SR    R4,R4                                           XA0054DK         
FSCU     LH    R7,VCHCUTBL(R4)                                 XA0054DK         
         LTR   R7,R7                                           XA0054DK         
         BM    FSCUN                                           XA0054DK         
         A     R7,VMCUSTRT                                     XA0054DK         
         SR    R5,R5                                           XA0054DK         
FSDV     LH    R8,VCUDVTBL(R5)                                 XA0054DK         
         LTR   R8,R8                                           XA0054DK         
         BM    FSDVN                                           XA0054DK         
         A     R8,VMDVSTRT                                     XA0054DK         
         TM    VDEVFLAG,VDEVDET                                XA0054DK         
         BO    FSDVN                                           XA0054DK         
         LTR   R0,R0                                           XA0054DK         
         BZ    FSFOUND                                         XA0054DK         
         BCTR  R0,0                                            XA0054DK         
FSDVN    LA    R5,2(,R5)                                       XA0054DK         
         CH    R5,H32                                          XA0054DK         
         BL    FSDV                                            XA0054DK         
FSCUN    LA    R4,2(,R4)                                       XA0054DK         
         CH    R4,H32                                          XA0054DK         
         BL    FSCU                                            XA0054DK         
FSCHN    LA    R2,2(,R2)                                       XA0054DK         
         CH    R2,H32                                          XA0054DK         
         BL    FSCH                                            XA0054DK         
         LTR   R9,R9          NONE: CC NOT 0                   XA0054DK         
         BR    R9                                              XA0054DK         
FSFOUND  LH    R13,VDEVADD                                     XA0054DK         
         AH    R13,VCUADD                                      XA0054DK         
         AH    R13,VCHADD                                      XA0054DK         
         SR    R0,R0          CC 0                             XA0054DK         
         BR    R9                                              XA0054DK         
*  FINDSN: R13 = DEVICE. R1 = ITS SUBCHANNEL NUMBER.           XA0054DK         
FINDSN   SR    R1,R1                                           XA0054DK         
         SR    R2,R2                                           XA0054DK         
FNCH     LH    R6,VMCHTBL(R2)                                  XA0054DK         
         LTR   R6,R6                                           XA0054DK         
         BM    FNCHN                                           XA0054DK         
         A     R6,VMCHSTRT                                     XA0054DK         
         SR    R4,R4                                           XA0054DK         
FNCU     LH    R7,VCHCUTBL(R4)                                 XA0054DK         
         LTR   R7,R7                                           XA0054DK         
         BM    FNCUN                                           XA0054DK         
         A     R7,VMCUSTRT                                     XA0054DK         
         SR    R5,R5                                           XA0054DK         
FNDV     LH    R8,VCUDVTBL(R5)                                 XA0054DK         
         LTR   R8,R8                                           XA0054DK         
         BM    FNDVN                                           XA0054DK         
         A     R8,VMDVSTRT                                     XA0054DK         
         TM    VDEVFLAG,VDEVDET                                XA0054DK         
         BO    FNDVN                                           XA0054DK         
         LH    R0,VDEVADD                                      XA0054DK         
         AH    R0,VCUADD                                       XA0054DK         
         AH    R0,VCHADD                                       XA0054DK         
         CR    R0,R13                                          XA0054DK         
         BER   R9                                              XA0054DK         
         LA    R1,1(,R1)                                       XA0054DK         
FNDVN    LA    R5,2(,R5)                                       XA0054DK         
         CH    R5,H32                                          XA0054DK         
         BL    FNDV                                            XA0054DK         
FNCUN    LA    R4,2(,R4)                                       XA0054DK         
         CH    R4,H32                                          XA0054DK         
         BL    FNCU                                            XA0054DK         
FNCHN    LA    R2,2(,R2)                                       XA0054DK         
         CH    R2,H32                                          XA0054DK         
         BL    FNCH                                            XA0054DK         
         BR    R9                                              XA0054DK         
*                                                              XA0054DK         
AVCSSE   DC    A(DMKVCS)                                       XA0054DK         
         ENTRY DMKVCSCW                                        XA0054DK         
DMKVCSCW DC    F'0'           M7.10: THE CAW OF THE SSCH       XA0054DK         
         ENTRY DMKVCSRG                                        XA0054DK         
DMKVCSRG DC    C'VCRING  '                                     XA0054DK         
VCRNXT   DC    F'0'                                            XA0054DK         
VCSLOCK  DC    F'0'           M7.8: THE VMBLOK IN DMKVCS       XA0054DK         
VCRLAST  DC    A(VCRING)                                       XA0054DK         
AVCRING  DC    A(VCRING)      THE RING: LAST, PAST R12'S 4 KB  XA0054DK         
STFLN3   DC    X'80000000'                                     XA0054DK         
XPFX     DC    X'7FFFF000'                                     XA0054DK         
AVCSIN   DC    A(DMKVCS)                                       XA0054DK         
AVCSSN   DC    A(DMKVCS)                                       XA0054DK         
VCSSAVI  DS    16F                                             XA0054DK         
VCSSAVN  DS    16F                                             XA0054DK         
VCSSAVA  DS    16F                                             XA0054DK         
AVCSAR   DC    A(DMKVCS)                                       XA0054DK         
VCSAROWN DC    F'0'           TABLE WHOSE ARS ARE IN THE CPU   XA0054DK         
VCSCCX   DC    X'00'                                           XA0054DK         
         DS    0F                                              XA0054DK         
VCSSLOTW DC    F'0'                                            XA0054DK         
AVCSSLOT DC    A(VCSSLOTS)    M7.9: THE SLOTS ARE PAST R12'S   XA0054DK         
AVCSSL8  DC    A(VCSSLOTS-8)  4 KB, AFTER THE RING             XA0054DK         
         DS    0F                                              XA0054DK         
SSIDW    DC    X'00010000'                                     XA0054DK         
F65535   DC    F'65535'                                        XA0054DK         
SSIDW0   DC    X'00010000'    SUBCHANNEL 0                     XA0054DK         
X7FFF    DC    X'7FFFFFFF'                                     XA0054DK         
