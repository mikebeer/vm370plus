./ R 00546000          $ 00546100 100                                           
SCANOPT  ST    R6,FORR6       M6: KEEP THE PLIST POINTER       XA0056DK         
         LR    R5,R6          GET ORIGINAL PLIST POINTER       XA0056DK         
./ R 00574000          $ 00574010 010                                           
OPTFND   MVC   OPTFLAG(1),0(R1)    THE OPTION INDICATOR        XA0056DK         
         L     R6,FORR6       (THE PLIST POINTER AGAIN)        XA0056DK         
         CLI   0(R1),C'B'     M6: BLKSIZE N                    XA0056DK         
         BNE   OPTFND2                                         XA0056DK         
         LA    R1,8(,R1)                                       XA0056DK         
         CLC   0(8,R1),=CL8'4096'                              XA0056DK         
         BE    OPTFND2                                         XA0056DK         
         CLC   0(8,R1),=CL8'4K'                                XA0056DK         
         BE    OPTFND2                                         XA0056DK         
         CLC   0(8,R1),=CL8'800'                               XA0056DK         
         BNE   ERR5                                            XA0056DK         
         MVI   OPTFLAG,0      800: THE USUAL FORMAT            XA0056DK         
OPTFND2  DS    0H                                              XA0056DK         
./ R 00602000          $ 00602100 100                                           
         MVC   USRCYL,LIMCYL  M6: AS GIVEN (0: NONE)           XA0056DK         
         SR    R15,R15        WAS THERE A CYLINDER SPEC. ?     XA0056DK         
./ R 00667000          $ 00667010 010                                           
NORELUFD CLI   OPTFLAG,C'B'   M6: (BLKSIZE 4096: EDF           XA0056DK         
         BNE   NORELUF2                                        XA0056DK         
         ICM   R15,15,NUCRSV7 DMSEFS                           XA0056DK         
         BZ    ERR7           NOT LOADED                       XA0056DK         
         MVC   EDFPB(4),DEVADDR   DEVICE, TYPE                 XA0056DK         
         MVC   EDFPB+4(4),USRCYL  CYLINDERS AT MOST            XA0056DK         
         MVC   EDFPB+8(6),INBUF   LABEL                        XA0056DK         
         LA    R0,8           FUNCTION 8: FMT                  XA0056DK         
         LA    R1,EDFPB                                        XA0056DK         
         BALR  R14,R15                                         XA0056DK         
         C     R15,=F'255'                                     XA0056DK         
         BE    ERR7           NOT A 3350 OR 3380               XA0056DK         
         LTR   R15,R15                                         XA0056DK         
         BZ    EDFACC                                          XA0056DK         
         LA    R15,=C'WRIT'                                    XA0056DK         
         B     ERR9                                            XA0056DK         
EDFACC   LH    R15,DEVADDR    THEN ACCESS IT                   XA0056DK         
         LA    R2,EDFCUU+2                                     XA0056DK         
         LA    R3,3                                            XA0056DK         
EDFHX    LR    R14,R15                                         XA0056DK         
         N     R14,=F'15'                                      XA0056DK         
         IC    R14,EDFHEXT(R14)                                XA0056DK         
         STC   R14,0(,R2)                                      XA0056DK         
         SRL   R15,4                                           XA0056DK         
         BCTR  R2,0                                            XA0056DK         
         BCT   R3,EDFHX                                        XA0056DK         
         MVC   EDFMODE(1),ADTM                                 XA0056DK         
         LA    R1,EDFAPL                                       XA0056DK         
         SVC   202                                             XA0056DK         
         DC    AL4(*+4)                                        XA0056DK         
         B     LM1415                                          XA0056DK         
EDFPB    DC    XL16'00'                                        XA0056DK         
FORR6    DC    F'0'                                            XA0056DK         
USRCYL   DC    F'0'                                            XA0056DK         
EDFAPL   DC    CL8'ACCESS'                                     XA0056DK         
EDFCUU   DC    CL8' '                                          XA0056DK         
EDFMODE  DC    CL8' '                                          XA0056DK         
         DC    8X'FF'                                          XA0056DK         
EDFHEXT  DC    C'0123456789ABCDEF'                             XA0056DK         
NORELUF2 CLI   DEVADDR+3,X'09'     A 3330?                     XA0056DK         
./ R 00695000          $ 00695100 100                                           
         DC    CL8'BLKSIZE'   M6                               XA0056DK         
NUMOPTS  EQU   (*-OPTIONS)/8                                   XA0056DK         
