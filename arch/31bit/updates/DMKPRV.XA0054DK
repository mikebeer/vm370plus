./ R 00809000          $ 00809000 100                                           
*  VM/370PLUS: STNSM/STOSM IN BC MODE TOO (GCCLIB, 9.13D)      XA0054DK         
./ I 00841000 $ 00841010 010                                                    
         TM    VMPSTAT,VMV370R  I-258: EC-CAPABLE MACHINE      XA0054DK         
         BZ    SETMASK1       IN EC MODE, NOT ESA/390,         XA0054DK         
         TM    VMPSW+1,X'08'  WITH A BC-STYLE MASK?            XA0054DK         
         BZ    SETMASK1                                        XA0054DK         
         TM    VMFSTAT,VMESA390                                XA0054DK         
         BO    SETMASK1                                        XA0054DK         
         LA    R1,X'B8'       BITS 0, 2-4: INVALID IN EC       XA0054DK         
         NR    R1,R4                                           XA0054DK         
         BZ    SETMASK1                                        XA0054DK         
         LA    R1,X'01'       KEEP THE EXTERNAL MASK           XA0054DK         
         NR    R1,R4                                           XA0054DK         
         SLL   R4,24          THE BC CHANNEL MASKS 0-6         XA0054DK         
         SRL   R4,25                                           XA0054DK         
         LTR   R4,R4                                           XA0054DK         
         BZ    *+8                                             XA0054DK         
         LA    R1,X'02'(,R1)  ANY: THE EC I/O MASK             XA0054DK         
         LR    R4,R1                                           XA0054DK         
