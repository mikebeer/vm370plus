*---------------------------------------------------------------------- CPW04880
*              SERVICE ROUTINES                                         CPW04890
*---------------------------------------------------------------------- CPW04900
*  MUST BE CALLED FROM MAIN LINE.                                       CPW04910
         SPACE 3                                                        CPW04920
*              BITIT                                                    CPW04930
*        CONVERT BYTE IN LOW ORDER POSITION OF R1                       CPW04940
*        TO CHARACTER BIT EQUIVALENT IN R0, R1.                         CPW04950
         SPACE 1                                                        CPW04960
         ENTRY BITIT                                                    CPW04970
         DS    0H                                                       CPW04980
BITIT    EQU   *-20                                                     CPW04990
         USING BITIT,R15                                                CPW05000
         N     R1,F00255                                                CPW05010
         SLDL  R0,31          BIT 7                                     CPW05020
         SRL   R1,7                                                     CPW05030
         SRDL  R0,1           BIT 6                                     CPW05040
         SRL   R1,7                                                     CPW05050
         SRDL  R0,1           BIT 5                                     CPW05060
         SRL   R1,7                                                     CPW05070
         SRDL  R0,4           LEAVE BIT 0                               CPW05080
         SLL   R0,7                                                     CPW05090
         SLDL  R0,1           BIT 1                                     CPW05100
         SLL   R0,7                                                     CPW05110
         SLDL  R0,1           BIT 2                                     CPW05120
         SLL   R0,7                                                     CPW05130
         SLDL  R0,1           BIT 3 (R0 FINISHED)                       CPW05140
         SRL   R1,7           REPOSITION AND FINISH R1                  CPW05150
         SPACE 1                                                        CPW05160
         STM   R14,R1,12(R13)                                           CPW05170
         OC    20(8,R13),CZEROS                                         CPW05180
         LM    R0,R1,20(R13)                                            CPW05190
         SPACE 1                                                        CPW05200
         BR    R14                                                      CPW05210
         DROP  R15                                                      CPW05220
         SPACE 3                                                        CPW05230
*              CONVERT BINARY NUMBER IN R1 TO EXTERNAL HEX REPRESENTATN CPW05240
*        ENTER R1 = VALUE TO BE CONVERTED.                              CPW05250
*        EXIT R0,R1=CHARACTER HEX EQUIVALENT.                           CPW05260
         ENTRY HEXIT                                                    CPW05270
         DS    0H                                                       CPW05280
HEXIT    EQU   *-20                                                     CPW05290
         USING HEXIT,R15                                                CPW05300
         ST    R1,12(,R13)                                              CPW05310
         UNPK  20(9,R13),12(5,R13)                                      CPW05320
         TR    20(8,R13),HEXTAB                                         CPW05330
         SPACE 1                                                        CPW05340
         STM   R14,R15,12(R13)                                          CPW05350
         LM    R0,R1,20(R13)                                            CPW05360
         BR    R14                                                      CPW05370
         DROP  R15                                                      CPW05380
         EJECT                                                          CPW05390
*              CONVERT BINARY NUMBER IN R1 TO EXTERNAL DECIMAL.         CPW05400
*        ENTER R1 = VALUE TO BE CONVERTED.                              CPW05410
*        EXIT R0,R1 CONTAIN CHARACTER VALUE.                            CPW05420
         ENTRY DECIT,DECIT1D,DECIT2D                                    CPW05430
         DS    0H                                                       CPW05440
DECIT    EQU   *-20                                                     CPW05450
         USING DECIT,R15                                                CPW05460
         IF R2,=F'9999999',GT,OR,R2,=F'-999999',LT,THEN                 CPW05470
            MVC   20(8,R13),=8C'*'                                      CPW05480
         IF ELSE                                                        CPW05490
            CVD R1,28(,R13)                                             CPW05500
            MVC 19(9,R13),=X'40202020206B202120'                        CPW05510
            LA  R1,19+9-1(,R13)                                         CPW05520
            EDMK 19(9,R13),28+8-4(R13)                                  CPW05530
            IF M,THEN                                                   CPW05540
               BCTR R1,0                                                CPW05550
               MVI 0(R1),C'-'                                           CPW05560
            IF END                                                      CPW05570
         IF END                                                         CPW05580
         SPACE 1                                                        CPW05590
         STM   R14,R15,12(R13)          FOR THE RECORD.                 CPW05600
         LM    R0,R1,20(R13)  DROP LEADING BLANK.                       CPW05610
         SPACE 1                                                        CPW05620
         BR    R14                                                      CPW05630
         DROP  R15                                                      CPW05640
         SPACE 3                                                        CPW05650
         DS    0H                                                       CPW05660
DECIT1D  EQU *-20             WITH ONE DECIMAL PLACE.                   CPW05670
         USING DECIT1D,R15                                              CPW05680
         MVC 19(9,R13),=X'402020202021204B20'                           CPW05690
         CVD R1,28(,R13)                                                CPW05700
         LA  R1,19+9-3(,R13)                                            CPW05710
         EDMK 19(9,R13),28+8-4(R13)                                     CPW05720
         IF M,THEN                                                      CPW05730
            BCTR R1,0                                                   CPW05740
            MVI 0(R1),C'-'                                              CPW05750
         IF END                                                         CPW05760
         STM R14,R15,12(R13)                                            CPW05770
         LM  R0,R1,20(R13)                                              CPW05780
         BR    R14                                                      CPW05790
         DROP  R15                                                      CPW05800
         SPACE 3                                                        CPW05810
         DS    0H                                                       CPW05820
DECIT2D  EQU *-20             WITH TWO DECIMAL PLACES.                  CPW05830
         USING DECIT2D,R15                                              CPW05840
         MVC 19(9,R13),=X'4020202021204B2020'                           CPW05850
         CVD R1,28(,R13)                                                CPW05860
         LA  R1,19+9-3(,R13)                                            CPW05870
         EDMK 19(9,R13),28+8-4(R13)                                     CPW05880
         IF M,THEN                                                      CPW05890
            BCTR R1,0                                                   CPW05900
            MVI 0(R1),C'-'                                              CPW05910
         IF END                                                         CPW05920
         STM R14,R15,12(R13)                                            CPW05930
         LM  R0,R1,20(R13)                                              CPW05940
         BR    R14                                                      CPW05950
         DROP  R15                                                      CPW05960
         SPACE 3                                                        CPW05970
*              LITERAL POOL FOR SERVICE ROUTINES.                       CPW05980
         LTORG                                                          CPW05990
         EJECT                                                          CPW06000
*********************************************************************** CPW06010
