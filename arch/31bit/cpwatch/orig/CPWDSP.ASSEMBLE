DSP TITLE 'CPWDSP -                                DISPLAY CHAIN, ETC.' CPW00010
         COPY  CPWPRM                                                   CPW00020
DSP      MODULE                                                         CPW00030
*---------------------------------------------------------------------- CPW00040
*              SET DATE IN MENU PANEL                                   CPW00050
*---------------------------------------------------------------------- CPW00060
         SPACE 1                                                        CPW00070
IMENU    PROC BEGIN                                                     CPW00080
         L     R1,=A(CPWDSPDT)                                          CPW00090
         L     R2,=V(CPWASM)  LAST ASSEMBLY DATE AND TIME               CPW00100
         MVC   0(L'CPWDSPDT,R1),0(R2)                                   CPW00110
         PROC END                                                       CPW00120
         SPACE 3                                                        CPW00130
         EJECT                                                          CPW00140
*********************************************************************** CPW00150
*              SERVICE ROUTINES.                                        CPW00160
*********************************************************************** CPW00170
         SPACE 2                                                        CPW00180
*        GET THE NEXT SCREEN (EMPTY) OF A DISPLAY.                      CPW00190
*        ENTER WITH R1 -> DSPSECT FOR THIS DISPLAY.                     CPW00200
*              R0 -> CURRENT SCRSECT, OR = 0 IF FIRST.                  CPW00210
*        EXIT WITH R0 -> NEW SCRSECT FOR THIS DISPLAY.                  CPW00220
NEWSCR   PROC  BEGIN                                                    CPW00230
         LR    R9,R1          SAVE DSPSECT                              CPW00240
         USING DSPSECT,R9                                               CPW00250
         LR    R8,R0         SAVE SCRSECT.                              CPW00260
         IF R8,NZ,THEN ADDING ANOTHER SCREEN..                          CPW00270
            USING SCRSECT,R8                                            CPW00280
            L   R10,SCRNEXT                                             CPW00290
            DROP R8                                                     CPW00300
         IF ELSE                                                        CPW00310
            L   R10,DSPFSCR                                             CPW00320
            ZAP DSPSCRC,=P'0' ZERO PAGES SO FAR.                        CPW00330
         IF END                                                         CPW00340
         IF R10,Z,THEN WE NEED ANOTHER PAGE.                            CPW00350
            ICM R10,B'1111',ADSPFREE     GET ONE OFF FREE CHAIN.        CPW00360
            IF NZ,THEN THERE IS ONE.                                    CPW00370
*              UNHOOK IT FROM FREE CHAIN.                               CPW00380
               MVC ADSPFREE,SCRNEXT-SCRSECT(R10)                        CPW00390
               SPACE 1                                                  CPW00400
            IF ELSE  WE HAVE TO MAKE ANOTHER FROM FREE STORAGE.         CPW00410
*                    GET SPACE.                                         CPW00420
               LA  R0,SCRSECTL                                          CPW00430
               SVC SVCGETM                                              CPW00440
               LR  R10,R1                                               CPW00450
            IF END                                                      CPW00460
            USING SCRSECT,R10                                           CPW00470
            XC  SCRNEXT,SCRNEXT                                         CPW00480
            DROP R10                                                    CPW00490
         IF END                                                         CPW00500
         SPACE 1                                                        CPW00510
*              CHAIN OFF OLD SCREEN, IF ANY.                            CPW00520
         IF R8,NZ,THEN                                                  CPW00530
            ST  R10,SCRNEXT-SCRSECT(,R8)                                CPW00540
            MVC SCRMORE-SCRSECT(L'SCRMORE,R8),=CL(L'SCRMORE)'MORE'      CPW00550
         IF ELSE                                                        CPW00560
            ST  R10,DSPFSCR                                             CPW00570
         IF END                                                         CPW00580
         MVC SCRMORE-SCRSECT(L'SCRMORE,R10),BLANKL                      CPW00590
         SPACE 1                                                        CPW00600
*              BUILD TOP LINE.                                          CPW00610
         USING SCRSECT,R10                                              CPW00620
         LA    R2,SCREEN                                                CPW00630
         LA    R3,L'SCREEN                                              CPW00640
         IF R8,NZ,THEN                                                  CPW00650
            L   R4,DSPFSCR                                              CPW00660
            LA  R4,SCREEN-SCRSECT(,R4)                                  CPW00670
            LA  R5,SCRMORE-SCREEN       PROPAGATE LINE 1.               CPW00680
         IF ELSE                                                        CPW00690
            SR  R4,R4                                                   CPW00700
            SR  R5,R5                                                   CPW00710
         IF END                                                         CPW00720
         ICM R5,B'1000',=X'40'          PAD WITH BLANKS.                CPW00730
         MVCL  R2,R4                                                    CPW00740
*              MOVE IN TIME, ETC.                                       CPW00750
         MVC   SCRTIME,CTIME                                            CPW00760
         MVC   SCRDATE,CDATE                                            CPW00770
         MVC   SCRINTVL,INTVL                                           CPW00780
         SPACE 1                                                        CPW00790
*              COUNT IT AND DISPLAY COUNT                               CPW00800
         AP    DSPSCRC,=P'1'                                            CPW00810
         MVC   SCRPAGN,=X'40202120'                                     CPW00820
         ED    SCRPAGN,DSPSCRC                                          CPW00830
         SPACE 1                                                        CPW00840
         LR    R0,R10                                                   CPW00850
         PROC  END,RETURN=(0)                                           CPW00860
         EJECT                                                          CPW00870
*---------------------------------------------------------------------- CPW00880
*        DROP REMAINING SCREENS FROM DISPLAY.                           CPW00890
*---------------------------------------------------------------------- CPW00900
*        ENTER WITH R1 -> DSPSECT,                                      CPW00910
*              R0 -> LAST CCWSECT USED, OR = 0 IF NONE.                 CPW00920
*        RETURN REGS UNCHANGED,                                         CPW00930
*              REMAINING SCREENS RETURNED TO FREE CHAIN,                CPW00940
*              NO DEVICE CCW POINTERS POINTING TO DELETED SCREENS.      CPW00950
LASTSCR  PROC  BEGIN                                                    CPW00960
         LR    R9,R1                                                    CPW00970
         USING DSPSECT,R9                                               CPW00980
         LR    R10,R0                                                   CPW00990
         USING SCRSECT,R10                                              CPW01000
         SPACE 1                                                        CPW01010
         IF R10,Z,THEN KNOCK ALL LISTNERS OFF THIS DISPLAY.             CPW01020
         IF ELSE              JUST OFF SCREENS.                         CPW01030
            LR  R8,R10        SAVE LAST SCREEN ADDRESS.                 CPW01040
            L   R10,SCRNEXT                                             CPW01050
            LR  R6,R10        LAST DROPPED SCREEN ADDRESS.              CPW01060
            DO WHILE,R10,NZ                                             CPW01070
*                   MAKE SURE NOBODY'S POINTING TO HIM.                 CPW01080
  AGO .NODROP                                                           CPW01090
              LA    R7,DEVICES                                          CPW01100
              USING DEVSECT,R7                                          CPW01110
              DO WHILE,CLC,DEVADDR,HEXFS,NE                             CPW01120
                 IF C,R10,DEVPAG,EQ,THEN                                CPW01130
*                   NOTE THAT DEVPAG IS NORMALLY MANIPULATED BY IOINTER CPW01140
*                   WHICH MAY INTERRUPT US.                             CPW01150
                    LR  R2,R10          GO BACK TO LAST REMAINING PAGE. CPW01160
                    LR  R3,R8                                           CPW01170
                    CS  R2,R3,DEVPAG (IF IT DOESN'T GO, IGNORE)         CPW01180
                  IF END                                                CPW01190
                  LA  R7,DEVNEXT                                        CPW01200
               DO END                                                   CPW01210
               DROP R7                                                  CPW01220
.NODROP ANOP                                                            CPW01230
               LR  R6,R10     HE'S DONE SUCCESSFULLY.                   CPW01240
               L   R10,SCRNEXT   AND PROCESS NEXT ONE.                  CPW01250
            DO END                                                      CPW01260
            DROP R10                                                    CPW01270
            IF R6,NZ,THEN WE HAVE DROPPED SOME SCREENS                  CPW01280
*              ATTACH CHAIN, ENTIRE, AT HEAD OF FREE CHAIN.             CPW01290
               MVC SCRNEXT-SCRSECT(L'SCRNEXT,R6),ADSPFREE               CPW01300
               MVC ADSPFREE,SCRNEXT-SCRSECT(R8)                         CPW01310
            IF END                                                      CPW01320
            USING SCRSECT,R8                                            CPW01330
            XC SCRNEXT,SCRNEXT                                          CPW01340
         IF END                                                         CPW01350
         SPACE 3                                                        CPW01360
         PROC  END                                                      CPW01370
         EJECT                                                          CPW01380
*********************************************************************** CPW01390
*              BUILD CLOCK SCREEN.                                      CPW01400
*********************************************************************** CPW01410
         SPACE 1                                                        CPW01420
CLOCK    PROC  BEGIN                                                    CPW01430
         SPACE 1                                                        CPW01440
         L     R9,=A(DSPCLOCK)                                          CPW01450
         USING DSPSECT,R9                                               CPW01460
         L     R10,DSPFSCR                                              CPW01470
         USING SCRSECT,R10                                              CPW01480
         SPACE 1                                                        CPW01490
         IF (CLC,SCRTIME(5),CTIME,NE,OR,                               +CPW01500
               TM,DSPFLAGS,DSPNEW,O),AND,                              +CPW01510
               CP,LISTNRS,=P'0',GT,THEN                                 CPW01520
            SPACE 1                                                     CPW01530
            OI    DSPFLAGS,DSPNEW FLAG AS NEW SCREEN.                   CPW01540
            SPACE 1                                                     CPW01550
*              INITIALIZE SCREEN.                                       CPW01560
            LA    R2,SCREEN                                             CPW01570
            LA    R3,L'SCREEN                                           CPW01580
            SR    R4,R4                                                 CPW01590
            SR    R5,R5                                                 CPW01600
            ICM   R5,B'1000',BLANKL                                     CPW01610
            MVCL R2,R4                                                  CPW01620
            MVC SCRTIME(5),CTIME                                        CPW01630
            MVC SCRDATE,CDATE                                           CPW01640
            SPACE 3                                                     CPW01650
            SR    R1,R1          REL LINE NUMBER.                       CPW01660
            LA    R3,SCRTIME       SOURCE                               CPW01670
            LA    R4,5           NUMBER OF BYTES.                       CPW01680
            LA    R8,SCREEN+400+6          BEGIN OF OUTPUT AREA.        CPW01690
*              IF LEADING BLANK, RE-CENTRE OUTPUT.                      CPW01700
            IF CLI,0(R3),C' ',EQ,THEN                                   CPW01710
               LA  R3,1(,R3)                                            CPW01720
               BCTR R4,0                                                CPW01730
               LA  R8,7(,R8)                                            CPW01740
            IF END                                                      CPW01750
            LA    R9,12          LOOP CONTROL - NUMBER OF LINES.        CPW01760
CLOOP       EQU   *                                                     CPW01770
               CALL BLOKLTR,LOCAL=YES                                   CPW01780
               SPACE 1                                                  CPW01790
               LA  R1,1(,R1)     NEXT LINE                              CPW01800
               LA  R8,80(,R8)                                           CPW01810
            BCT   R9,CLOOP                                              CPW01820
            SPACE 1                                                     CPW01830
         IF END                                                         CPW01840
         SPACE 1                                                        CPW01850
         PROC  END                                                      CPW01860
         SPACE 12                                                       CPW01870
*                                                                       CPW01880
* OPERATION OF THE BLOCK LETTER GENERATION SUBROUTINE -                 CPW01890
*                                                                       CPW01900
* ENTRY CONDITIONS -                                                    CPW01910
*                                                                       CPW01920
*        GPR1  = RELATIVE LINE NUMBER OF THE 12 LINE MATRIX (0-11)      CPW01930
*        GPR3  = ADDRESS OF THE CHARACTER STRING TO BE TRANSLATED       CPW01940
*        GPR4  = NUMBER OF CHARACTERS TO BE TRANSLATED                  CPW01950
*        GPR6  = RETURN ADDRESS                                         CPW01960
*  RETURN ADDRESS CHANGED TO R14. GEO.                                  CPW01970
*        GPR8  = ADDRESS OF OUTPUT AREA FOR TRANSLATION                 CPW01980
*                                                                       CPW01990
*        UPON ENTRY, THE OUTPUT AREA POINTED TO BY GPR8 SHOULD HAVE     CPW02000
*        BEEN CLEARED TO BLANKS BY THE CALLER.  THE OUTPUT AREA MUST BE CPW02010
*        LONG ENOUGH TO HOLD 12 CHARACTERS FOR EACH CHARACTER           CPW02020
*        TRANSLATED, PLUS 2 SPACES BETWEEN EACH BLOK LETTER. FOR        CPW02030
*        EXAMPLE, IF 5 CHARACTERS ARE TO BE TRANSLATED, THE OUTPUT AREA CPW02040
*        FOR THE TRANSLATOR MUST BE AT LEAST (5*12)+(4*2)= 68 BYTES     CPW02050
*        LONG.  IT IS THE RESPONSIBILITY OF THE CALLER TO INSURE THAT   CPW02060
*        THE OUTPUT AREAS FOR THE 12 LINES ARE VERTICALLY ALIGNED ON    CPW02070
*        THE PAGE WHEN THEY ARE FINALLY PRINTED                         CPW02080
*                                                                       CPW02090
* EXIT CONDITIONS -                                                     CPW02100
*                                                                       CPW02110
*        NORMAL -                                                       CPW02120
*        THE OUTPUT AREA IS FILLED WITH A LINE OF CHARACTERS, ONE       CPW02130
*        GROUP OF 12 FOR EACH OF THE LETTERS TRANSLATED                 CPW02140
*                                                                       CPW02150
*        ERROR -                                                        CPW02160
*        NONE                                                           CPW02170
*                                                                       CPW02180
* REGISTER USAGE -                                                      CPW02190
*                                                                       CPW02200
*        GPR0  = CHARACTER REGISTER - HOLDS THE CHARACTER TO BE TRANS-  CPW02210
*                LATED                                                  CPW02220
*        GPR1  = RELATIVE LINE NUMBER (0-11) IN MATRIX                  CPW02230
*        GPR2  - NOT USED                                               CPW02240
*        GPR3  = ADDRESS OF NEXT LETTER TO TRANSLATE                    CPW02250
*        GPR4  = NUMBER OF LETTERS REMAINING TO BE TRANSLATED           CPW02260
*        GPR5  = SHIFT REGISTER FOR PATTERN DETERMINATION               CPW02270
*        GPR6  = RETURN ADDRESS                                         CPW02280
*        GPR7  - NOT USED                                               CPW02290
*        GPR8  = ADDRESS OF LOCATION FOR NEXT 12 BYTE PATTERN           CPW02300
*        GPR9  = INDEX REGISTER FOR LINE AND PATTERN TABLES             CPW02310
*        GPR10 = INDEX FOR NEXT BYTE STORE ADDRESS                      CPW02320
*        GPR11-13 - NOT USED                                            CPW02330
*        GPR14,15 - BXLE LOOP CONTROL                                   CPW02340
*                                                                       CPW02350
*        NOTE THAT GPR14-0 ARE SAVED AND RESTORED, REGISTERS 3-5 AND    CPW02360
*        8-10 WILL BE DESTROYED, AND THE OTHERS WILL BE UNCHANGED       CPW02370
*   NOTE THAT NO REGS ARE NOW DESTROYED. GEO.                           CPW02380
*                                                                       CPW02390
         EJECT                                                          CPW02400
*                                                                       CPW02410
* NOTES -                                                               CPW02420
*                                                                       CPW02430
*        THIS ROUTINE IS AN ADAPTATION OF THE OS/360 MODULE 'IEFSD095   CPW02440
*        BLOCK LETTER AND NUMBER ROUTINE'                               CPW02450
*                                                                       CPW02460
* OPERATION -                                                           CPW02470
*                                                                       CPW02480
*        1. THE PATTERN TO BE STORED FOR A GIVEN LETTER                 CPW02490
*           OR NUMBER IS DETERMINED BY INDEXING INTO A PATTERN TABLE    CPW02500
*           BASED ON THE HEXADECIMAL VALUE OF THE CHARACTER.  WHEN      CPW02510
*           THE PROPER ENTRY IS FOUND, IT IS FURTHER INDEXED BY THE     CPW02520
*           RELATIVE LINE NUMBER THAT IS BEING PRODUCED.  THE RESULTING CPW02530
*           NUMBER IS USED TO INDEX INTO A BIT TABLE WHERE EACH ENTRY   CPW02540
*           IS TWELVE BITS LONG AND INDICATES VIA A ONE OR ZERO BIT     CPW02550
*           WHETHER OR NOT A CHARACTER IS TO BE STORED IN A COLUMN OF   CPW02560
*           OF THAT ROW OF THE MATRIX                                   CPW02570
*                                                                       CPW02580
*        2. THE BIT MAP IS INSERTED INTO THE HIGH ORDER HALFWORD        CPW02590
*           OF A REGISTER, WHICH IS THEN SHIFTED AND TESTED VIA A BXH   CPW02600
*           LOOP.  IF A ONE BIT IS SHIFTED INTO THE HIGH ORDER (0)      CPW02610
*           POSITION OF THE REGISTER, A CHARACTER IS STORED IN THE      CPW02620
*           CORRESPONDING COLUMN OF THE MATRIX; IF NO BIT IS SHIFTED,   CPW02630
*           NO CHARACTER IS STORED                                      CPW02640
*                                                                       CPW02650
*        3. AS THE REGISTER IS SHIFTED AND TESTED, THE COLUMN INDEX IS  CPW02660
*           INCREMENTED AND ALWAYS POINTS TO THE NEXT POSITION TO BE    CPW02670
*           FILLED; THEREFOR, IF NO CHARACTER IS STORED, THE COLUMN     CPW02680
*           REMAINS BLANK                                               CPW02690
*                                                                       CPW02700
*        4. AFTER THE 12TH COLUMN HAS BEEN PROCESSED, THE TRANSLATION   CPW02710
*           COUNT IS DECREMENTED AND TESTED AND ANY FURTHER LETTERS ARE CPW02720
*           TRANSLATED IN THE SAME MANNER                               CPW02730
*                                                                       CPW02740
*.                                                                      CPW02750
         EJECT                                                          CPW02760
BLOKLTR  PROC  BEGIN      GENERATE BLOCK LETTERS FOR THE PAGE SEPARATOR CPW02770
         SPACE 2                                                        CPW02780
* GEO    STM   R14,R0,SAVEWRK2     SAVE REGS 14, 15, AND 0              CPW02790
*        STM   R14,R12,12(R13)                                    GEO   CPW02800
         SR    R0,R0               CLEAR CHARACTER REGISTER             CPW02810
         LA    R14,1               GENERAL INCREMENT REGISTER           CPW02820
         LA    R15,11              OFFSET OF LAST MATRIX CHARACTER      CPW02830
GETCHAR  SR    R10,R10             OFFSET OF 1ST MATRIX CHARACTER       CPW02840
         IC    R0,0(,R3)           PICK UP NEXT CHARACTER               CPW02850
         LR    R9,R0               AND SAVE IT                          CPW02860
         O     R9,=A(X'C0')        FORCE INTO THE RANGE OF UPPER CASE   CPW02870
         S     R9,=A(X'C0')   AND BACK UP FOR IT.                       CPW02880
         IC    R9,CHARTABL(R9)       GET OFFSET FOR CHARACTER PATTERN   CPW02890
*        IC    R9,CHARTABL-X'C0'(R9) GET OFFSET FOR CHARACTER PATTERN   CPW02900
         LTR   R5,R9               WAS CHARACTER A BLANK?               CPW02910
         BZ    NEXTCHAR            YES -- SKIP TO NEXT CHARACTER        CPW02920
         AR    R5,R5               MULTIPLY OFFSET BY 2                 CPW02930
         LA    R5,CHARPATN-12(R5)  AND POINT TO CHARACTER PATTERN       CPW02940
         IC    R9,0(R1,R5)         GET OFFSET INTO LINE PATTERN TABLE   CPW02950
         LH    R5,LINEPATN(R9)     AND GET LINE PATTERN IN R5           CPW02960
         SLL   R5,19               SHIFT LINE PATTERN INTO BITS 1-12    CPW02970
         AR    R5,R14              AND INSERT LOW ORDER 1               CPW02980
         SPACE 3                                                        CPW02990
BLOKLOOP BXH   R5,R5,*+8           TEST FOR A ONE BIT SHIFTED INTO HIGH CPW03000
*              ORDER POSITION -- IF BIT WAS SHIFTED, BRANCH WILL NOT    CPW03010
*              BE TAKEN, SINCE RESULTING SUM IS NEGATIVE, AND A CHAR-   CPW03020
*        ACTER WILL BE STORED. IF BIT WAS NOT SHIFTED, SUM WILL BE POS- CPW03030
*        ITIVE, AND ONE GREATER THAN LAST VALUE IN R5                   CPW03040
         STC   R0,0(R10,R8)        STORE MATRIX CHARACTER               CPW03050
         BXLE  R10,R14,BLOKLOOP    POINT TO SLOT FOR NEXT CHAR          CPW03060
*                                  ACTER, AND LOOP 11 MORE TIMES        CPW03070
NEXTCHAR AR    R3,R14              POINT TO NEXT CHARACTER TO TRANSLATE CPW03080
         LA    R8,14(,R8)          POINT TO NEXT SLOT IN WORKAREA       CPW03090
         BCT   R4,GETCHAR          GET NEXT CHARACTER, IF THERE IS ONE  CPW03100
         SPACE 2                                                        CPW03110
* GEO    LM    R14,R15,SAVEWRK2    RESTORE REGISTERS 14 AND 15          CPW03120
* GEO    BR    R6                  AND RETURN TO CALLER                 CPW03130
*        LM    R14,R12,12(R13)                                    GEO   CPW03140
*        BR    R14                                                GEO   CPW03150
         EJECT                                                          CPW03160
         DATA                                                           CPW03170
CHARTABL EQU   *  TABLE OF OFFSETS INTO CHARPATN TABLE --               CPW03180
*              SINCE EACH ENTRY IN THE CHARPATN TABLE IS 12 BYTES,      CPW03190
*              THESE INDICES ARE REALLY ONLY HALF AS BIG AS THE ACTUAL  CPW03200
*              OFFSET.  AFTER THE INDEX IS FOUND, IT IS MULTIPLIED BY 2 CPW03210
         SPACE 3                                                        CPW03220
         DC    X'00'               BLANK                                CPW03230
         DC    AL1(((A-XX)/2),((B-XX)/2),((C-XX)/2),((D-XX)/2))         CPW03240
         DC    AL1(((E-XX)/2),((F-XX)/2),((G-XX)/2),((H-XX)/2))         CPW03250
         DC    AL1((I-XX)/2)                                            CPW03260
         DC    7X'00'              UNDEFINED GRAPHICS - FORCED TO       CPW03270
*                                  BLANKS                               CPW03280
         DC    AL1(((J-XX)/2),((K-XX)/2),((L-XX)/2),((M-XX)/2))         CPW03290
         DC    AL1(((N-XX)/2),((O-XX)/2),((P-XX)/2),((Q-XX)/2))         CPW03300
         DC    AL1((R-XX)/2)                                            CPW03310
         DC    8X'00'              UNDEFINED GRAPHICS - FORCED TO       CPW03320
*                                  BLANKS                               CPW03330
         DC    AL1(((S-XX)/2),((T-XX)/2),((U-XX)/2),((V-XX)/2))         CPW03340
         DC    AL1(((W-XX)/2),((X-XX)/2),((Y-XX)/2),((Z-XX)/2))         CPW03350
         DC    6X'00'              UNDEFINED GRAPHICS - FORCED TO       CPW03360
*                                  BLANKS                               CPW03370
         DC    AL1(((ZERO-XX)/2),((ONE-XX)/2),((TWO-XX)/2))             CPW03380
         DC    AL1(((THREE-XX)/2),((FOUR-XX)/2),((FIVE-XX)/2))          CPW03390
         DC    AL1(((SIX-XX)/2),((SEVEN-XX)/2),((EIGHT-XX)/2))          CPW03400
         DC    AL1((NINE-XX)/2)                                         CPW03410
         DC    AL1((COLON-XX)/2)                                  GEO   CPW03420
         DC    5X'00'                                             GEO   CPW03430
* GEO    DC    6X'00'              UNDEFINED GRAPHICS - FORCED TO       CPW03440
*                                  BLANKS                               CPW03450
         SPACE 3                                                        CPW03460
*********************************************************************** CPW03470
*                                                                     * CPW03480
*        FOLLOWING IS THE CHARACTER PARM LIST CONTAINING 444 BYTES    * CPW03490
*        WHERE EACH BYTE IS THE OFF SET FROM L1 IN THE LINE PARAMETER * CPW03500
*        LIST WHERE ONE LINE PATTERN OF A PARTICULAL CHARACTER IS     * CPW03510
*        STORED . A CHARACTER IS REPRESENTED BY 12 ORDERED LINE       * CPW03520
*        PATTERNS .FOR EXAMPLE A IS REPRESENTED BY THE  FOLLOWING     * CPW03530
*        ORDERED LINE PATTERNS  L2,L1,L5,L5,L5,L1,L1,L5,L5,L5,L5,L5   * CPW03540
*        AND WILL APPEAR ON THE PRINTER AS FOLLOWS                    * CPW03550
*                                                                     * CPW03560
*                             AAAAAAAAAA                              * CPW03570
*                            AAAAAAAAAAAA                             * CPW03580
*                            AA        AA                             * CPW03590
*                            AA        AA                             * CPW03600
*                            AA        AA                             * CPW03610
*                            AAAAAAAAAAAA                             * CPW03620
*                            AAAAAAAAAAAA                             * CPW03630
*                            AA        AA                             * CPW03640
*                            AA        AA                             * CPW03650
*                            AA        AA                             * CPW03660
*                            AA        AA                             * CPW03670
*                            AA        AA                             * CPW03680
*                                                                     * CPW03690
*********************************************************************** CPW03700
CHARPATN EQU   *                                                        CPW03710
XX       EQU   *-12                JUST FOR EASE OF TYPING              CPW03720
A        DC    X'020008080800000808080808'                              CPW03730
B        DC    X'2C000808322A2A320808002C'                              CPW03740
C        DC    X'020008262626262626080002'                              CPW03750
D        DC    X'282A32080808080808322A28'                              CPW03760
E        DC    X'000026262668682626260000'                              CPW03770
F        DC    X'000026262668682626262626'                              CPW03780
G        DC    X'020008262626343408080002'                              CPW03790
H        DC    X'080808080800000808080808'                              CPW03800
I        DC    X'020214141414141414140202'                              CPW03810
J        DC    X'66660A0A0A0A0A0A3A3A686A'                              CPW03820
K        DC    X'08322E3C3A36363A3C2E3208'                              CPW03830
L        DC    X'262626262626262626260000'                              CPW03840
M        DC    X'083E40424446080808080808'                              CPW03850
N        DC    X'086C6E484A464E5052540876'                              CPW03860
O        DC    X'000008080808080808080000'                              CPW03870
P        DC    X'2C00080808002C2626262626'                              CPW03880
Q        DC    X'020008080808084E50522C56'                              CPW03890
R        DC    X'2C00080808002C3A3C2E3208'                              CPW03900
S        DC    X'02000826585A5C5E64080002'                              CPW03910
T        DC    X'000014141414141414141414'                              CPW03920
U        DC    X'080808080808080808080002'                              CPW03930
V        DC    X'080808080808083062206014'                              CPW03940
W        DC    X'080808080808464442403E08'                              CPW03950
X        DC    X'080830622060602062300808'                              CPW03960
