*********************************************************************** CPW06030
         SPACE 1                                                        CPW06040
CPWDSPS  CSECT                                                          CPW06050
         ENTRY DSPLAYS                                                  CPW06060
DSPLAYS  DS    0D                                                       CPW06070
DSPBEGIN DSPENTRY SCRMENU,FLAGS=DSPNC                                   CPW06080
DSPSYS   DSPENTRY ,                                                     CPW06090
DSPTRM   DSPENTRY ,                                                     CPW06100
DSPSDV   DSPENTRY ,                                                     CPW06110
DSPALL   DSPENTRY ,                                                     CPW06120
         PRINT GEN                                                      CPW06130
DSPACT   DSPENTRY ,DSPBEGIN                                             CPW06140
DSPSYA   DSPENTRY ,DSPSYA,FLAGS=DSPNC     FREE STANDING                 CPW06150
DSPSYX   DSPENTRY ,DSPSYX,FLAGS=DSPNC     FREE STANDING                 CPW06160
         PRINT NOGEN                                                    CPW06170
DSPCLOCK DSPENTRY SCRCLOCK,DSPBEGIN     FREE STANDING                   CPW06180
         EJECT                                                          CPW06190
