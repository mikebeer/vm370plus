         MACRO                                                          00001000
&NAME    CPWSUP                                                         00002000
         LCLB  &DSECT                                                   00003000
&DSECT   SETB  ('&SYSECT' NE 'CPWSUP')                                  00004000
         AIF   (NOT &DSECT).NODS1                                       00005000
CPWSUP   DSECT                                                          00006000
.NODS1   ANOP                                                           00007000
         USING *,R0                                                     00008000
*              CPWATCH LOWCORE AND SVC DEFINITIONS.                     00009000
         SPACE 3                                                        00010000
*---------------------------------------------------------------------- 00011000
*              SVC TABLE.                                               00012000
*---------------------------------------------------------------------- 00013000
         SPACE 1                                                        00014000
SVCWAIT  EQU   0              WAIT MAINLINE ON INTERVAL TIMER           00015000
SVCTIMES EQU   4              SET INTERVAL TIMER                        00016000
SVCWTO   EQU   8              WRITE TO CONSOLE.                         00017000
SVCDCP   EQU   12             DISPLAY REAL STORAGE.                     00018000
SVCGETM  EQU   16             GETMAIN                                   00019000
SVCPAGE  EQU   01             PAGE ALIGNED(GETMAIN MODIFIER).           00020000
SVCFREEM EQU   20             FREEMAIN                                  00021000
SVCMARK  EQU   24             DISPLAY CURRENT PSW ON CONSOLE            00022000
SVCSTOP  EQU   25             SVCMARK + WAIT ON CONSOLE.                00023000
SVCDISP  EQU   28             DISPATCH Q'D I/O.                         00024000
SVCMAX   EQU   48             MAXIMUM SVC GENERATED.                    00025000
         EJECT                                                          00026000
*---------------------------------------------------------------------- 00027000
*              L O W   C O R E   D E F I N I T I O N                    00028000
*---------------------------------------------------------------------- 00029000
         SPACE 2                                                        00030000
RSTNWPSW DS    D                                                        00031000
         DS    2D                                                       00032000
EXTOPSW  DS    D                                                        00033000
SVCOLD   DS    D                                                        00034000
PGMOPSW  DS    D                                                        00035000
MCHOPSW  DS    D                                                        00036000
IOOLD    DS    D                                                        00037000
CPCSW    DS    D                                                        00038000
CPCAW    DS    F                                                        00039000
         DS    F                                                        00040000
CPTIMER  DS    F                                                        00041000
         DS    F                                                        00042000
         DS    0D                                                       00043000
EXTNPSW  DS    D                                                        00044000
SVCNEW   DS    D                                                        00045000
PGMNPSW  DS    D                                                        00046000
MCHNPSW  DS    D                                                        00047000
IONEW    DS    D                                                        00048000
         DS    CL(256-*+CPWSUP)                                         00049000
         SPACE 3                                                        00050000
*********************************************************************** 00051000
*              C O M M O N                                              00052000
*********************************************************************** 00053000
         SPACE 1                                                        00054000
AHICORE  DC    A(16*4096)     UPDATED AT IPL.                           00055000
