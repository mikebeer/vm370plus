         SPACE 1                                                        00057000
AFREECH  DC    A(*-*,0)       FREE STORAGE ANCHOR ELEMENT.              00058000
ASAVECH  DC    A(*-*,*-*,0)   BEGIN OF SAVE AREA CHAIN.                 00059000
         AIF   (&DSECT).DS2                                             00060000
         ENTRY AFREECH,SVCSAVE                                          00061000
.DS2     ANOP                                                           00062000
         SPACE 1                                                        00063000
ARDVTAB  DC    A(*-*)         A(MY RDEV TABLE)                          00064000
AARIODV  DC    A(0)           BECOMES A(FIRST RDEVBLOK)                 00065000
RIODC    DC    A(0)           REPLACED W/DEVICE COUNT AT IPL.           00066000
         SPACE 1                                                        00067000
AUSRTAB  DC    A(*-*)         TABLE OF LOGGED ON USER DATA              00068000
AUSRFREE DC    A(*-*)         AVAILABLE USER TABLE ENTRIES.             00069000
         SPACE 1                                                        00070000
ASYMBUFF  DC    A(*-*)        SYMBOL TABLE PAGE BUFFER.                 00071000
         SPACE 1                                                        00072000
ADSPLAY  DC    V(DSPLAYS)     DISPLAY TABLE.                            00073000
ADSPCLOK DC    V(DSPCLOCK)                                              00074000
ADSPFREE DC    A(*-*)                                                   00075000
AEXDIAG  DC    A(0)           DIAGNOSE BUFFER.
         AIF   (&DSECT).DS3                                             00076000
ADEVICES DC    A(DEVICES)     A(VDEVICE TABLE)                          00077000
         SPACE 1
CALL     B     *-*            CALL ROUTINE (FUTURE USE)
         AGO   .NODS3                                                   00078000
.DS3     ANOP                                                           00079000
ADEVICES DS    A              A(VDEVICE TABLE)                          00080000
         SPACE 1
CALL     B     *-*            CALL ROUTINE (FUTURE USE)
.NODS3   ANOP
         SPACE 1
         DC    4A(0)          FUTURE
         SPACE 1                                                        00082000
CORESIZE DC    F'0'           MAX REAL CORE (@DMKSYSRM)
AASYSLC  DC    A(*-*)         ASYSLC, A(DMKSYSLC).
ACPWSECT DC    A(*-*)         SYSTEM STUFF.
ADSPNP   DC    A(0)           A(DMKDSPNP), FROM SYMBOL TABLE.
HIFIXED  DC    A(0)           END OF FIXED CP CORE; FROM APAGCP IN PSA
         DC    A(0)           FOR FUTURE USE
         SPACE 1                                                        00084000
MYID     DC    CL8'*'         FILLED IN W/DIAG 0                        00085000
         SPACE 1                                                        00086000
         DS    0D                                                       00087000
