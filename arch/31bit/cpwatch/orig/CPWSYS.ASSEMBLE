                  LA  R1,1(,R1)                                         CPW07610
                  SRA R1,1                                              CPW07620
                  SPACE 1                                               CPW07630
                  CALL DECIT                                            CPW07640
                  MVC L'CHAN0L-4-2(4,R4),28-4(R13)                      CPW07650
                  MVC L'CHAN0L-2(2,R4),=C'/S'                           CPW07660
                  SPACE 1                                               CPW07670
                  LA  R4,L'SCRLINE(,R4) NEXT LINE.                      CPW07680
*              IF END                                                   CPW07690
               SPACE 1                                                  CPW07700
