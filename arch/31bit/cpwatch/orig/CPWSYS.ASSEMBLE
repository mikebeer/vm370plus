SYS      TITLE '                                        CPWATCH'        CPW00010
         COPY  CPWPRM                                                   CPW00020
SYS      MODULE PRINT=YES                                               CPW00030
         EJECT                                                          CPW00040
*********************************************************************** CPW00050
*              DISPLAY LOW CORE AND SYSTEM STUFF.                       CPW00060
*********************************************************************** CPW00070
         SPACE 1                                                        CPW00080
SYSDCP   PROC  BEGIN                                                    CPW00090
         L     R8,ACPWSECT                                              CPW00100
         USING CPWSECT,R8                                               CPW00110
         IF R8,Z,THEN  IF DATA AREA NOT ALLOCATED, ALLOCATE & INIT.     CPW00120
            LA   R0,CPWSECTL                                            CPW00130
            SVC  SVCGETM                                                CPW00140
            LR   R8,R1                                                  CPW00150
            ST   R8,ACPWSECT                                            CPW00160
            SPACE 1                                                     CPW00170
            XC   CPWSECT(256),CPWSECT                                   CPW00180
            XC   CPWSECT+256(CPWSECTL-256),CPWSECT+256                  CPW00190
            ZAP  CPACTV,=P'0'                                           CPW00200
            ZAP  CPINACT,=P'0'                                          CPW00210
            ZAP  CPSLEEP,=P'0'                                          CPW00220
            ZAP  CPQ1,=P'0'                                             CPW00230
            ZAP  CPQ2,=P'0'                                             CPW00240
            ZAP  CPQ3,=P'0'                                             CPW00250
            ZAP  CPEL,=P'0'                                             CPW00260
            SPACE 3                                                     CPW00270
*              PICK UP ADDRESSES FROM SYM TABLE.                        CPW00280
            L   R4,ASYMBUFF                                             CPW00290
            USING SYMTAB,R4                                             CPW00300
            DO WHILE,CLC,SYMNAME,ZEROS,NE                               CPW00310
               IF CLC,SYMNAME,=C'DMKPTRPR',EQ,THEN                      CPW00320
                  MVC CPAPTRPR,SYMADDR                                  CPW00330
               IF END                                                   CPW00340
               IF CLC,SYMNAME,=C'DMKPTRFF',EQ,THEN                      CPW00350
                  MVC CPAPTRFF,SYMADDR                                  CPW00360
               IF END                                                   CPW00370
               IF CLC,SYMNAME,=C'DMKPTRSS',EQ,THEN                      CPW00380
                  MVC CPAPTRSS,SYMADDR                                  CPW00390
               IF END                                                   CPW00400
               IF CLC,SYMNAME,=C'DMKPTRSC',EQ,THEN                      CPW00410
                  MVC CPAPTRSC,SYMADDR                                  CPW00420
               IF END                                                   CPW00430
               SPACE 1                                                  CPW00440
               LA  R4,SYMLEN(,R4)                                       CPW00450
            DO END                                                      CPW00460
            DROP R4                                                     CPW00470
         IF END                                                         CPW00480
         EJECT                                                          CPW00490
*              PICK UP ONLY OR MAIN PROCESSOR PSA DATA.                 CPW00500
PAG      DCPLIST PSA,(PFXA,PREFIXA),(PFXB,PREFIXB),(XAPP,APSTAT1),     +CPW00510
               (CPIDL,IDLEWAIT),(,IDLEWAIT+4),                         +CPW00520
               (CPPAG,PAGEWAIT),(,PAGEWAIT+4),                         +CPW00530
               (CPION,IONTWAIT),(,IONTWAIT+4),                         +CPW00540
               (CPROB,PROBTIME),(,PROBTIME+4),                         +CPW00550
               (CPPGRI,PGREAD),(CPPGWRI,PGWRITE),                      +CPW00560
               (CPSVC,PSASVCCT)                                         CPW00570
         DCP   PAG,BASE=0                                               CPW00580
         SPACE 1                                                        CPW00590
*              SAVE ATTACHED PROCESSOR STATUS AND LOCATION, IF ANY.     CPW00600
         MVC   XPREFIXA,PFXA                                            CPW00610
         MVC   XPREFIXB,PFXB                                            CPW00620
         MVC   OAPSTAT1,XAPSTAT1        SAVE LAST SNAP ONE.             CPW00630
         MVC   XAPSTAT1,XAPP                                            CPW00640
         MVC   XAPSTAT2,XAPP+(APSTAT2-APSTAT1)                          CPW00650
         SPACE 1                                                        CPW00660
         LM  R0,R1,CPIDLED                                              CPW00670
         DSUB R0,CPIDL                                                  CPW00680
         MVC CPIDLED,CPIDL                                              CPW00690
         SRDL R0,12                                                     CPW00700
         ST   R1,CPIDLEF                                                CPW00710
         SPACE 1                                                        CPW00720
         LM  R0,R1,CPPAGED                                              CPW00730
         DSUB R0,CPPAG                                                  CPW00740
         MVC CPPAGED,CPPAG                                              CPW00750
         SRDL R0,12                                                     CPW00760
         ST  R1,CPPAGEF                                                 CPW00770
         SPACE 1                                                        CPW00780
         LM  R0,R1,CPIONTD                                              CPW00790
         DSUB R0,CPION                                                  CPW00800
         MVC CPIONTD,CPION                                              CPW00810
         SRDL  R0,12                                                    CPW00820
         ST    R1,CPIONTF                                               CPW00830
         SPACE 1                                                        CPW00840
         LM    R0,R1,CPPROBD                                            CPW00850
         DSUB  R0,CPROB                                                 CPW00860
         MVC   CPPROBD,CPROB                                            CPW00870
         SRDL  R0,12                                                    CPW00880
         ST    R1,CPPROBF                                               CPW00890
         SPACE 1                                                        CPW00900
         L     R1,CPSVC                                                 CPW00910
         S     R1,CPSVCCT                                               CPW00920
         ST    R1,CPSVCF                                                CPW00930
         MVC   CPSVCCT,CPSVC                                            CPW00940
         SPACE 3                                                        CPW00950
         L     R1,CPPGRI      TOTAL PAGE READS TO DATE.                 CPW00960
         L     R2,CPGREAD                                               CPW00970
         ST    R1,CPGREAD                                               CPW00980
         SR    R1,R2                                                    CPW00990
         ST    R1,CPDPGR      INCREASE IN PAGE READS                    CPW01000
         SPACE 1                                                        CPW01010
         L     R1,CPPGWRI     TOTAL PAGE WRITES TO DATE.                CPW01020
         L     R2,CPGWRITE                                              CPW01030
         ST    R1,CPGWRITE                                              CPW01040
         SR    R1,R2                                                    CPW01050
         ST    R1,CPDPGW      INCREASE                                  CPW01060
         SPACE 3                                                        CPW01070
*              PICK UP STUFF FROM ABSOLUTE PSA.                         CPW01080
*        NOTE PREFIXA = 0 IF RUNNING UNIPROCESSOR;                      CPW01090
*   IF RUNNING ATTACHED PROCESSOR, ALLOWS ACCESS TO ABSOLUTE PAGE 0     CPW01100
*   FOR STUFF WHICH IS IN ABSOLUTE PAGE 0(ABSOLUTE PSA), USE PREFIXA    CPW01110
*   REGARDLESS OF WHETHER WE ARE RUNNING AP OR UP - THEN IT WILL ALWAYS CPW01120
*   WORK.                                                               CPW01130
ABSPSA   DCPLIST PSA,(PGW,PAGELOAD)                                     CPW01140
         L     R4,XPREFIXA                                              CPW01150
         DCP   ABSPSA,BASE=(R4)                                         CPW01160
         SPACE 1                                                        CPW01170
         MVC CPGLOAD,PGW                                                CPW01180
         MVC CPGRATE,PGW+2                                              CPW01190
         SPACE 3                                                        CPW01200
*                             PICK UP ATTACHED PROCESSOR GOOD STUFF.    CPW01210
         IF TM,XAPSTAT1,APUOPER,O,THEN                                  CPW01220
            L   R4,XPREFIXB   A(AP PSA)                                 CPW01230
            SPACE 1                                                     CPW01240
            DCP   PAG,BASE=(R4)                                         CPW01250
            SPACE 1                                                     CPW01260
            LM  R0,R1,APIDLED                                           CPW01270
            DSUB R0,CPIDL                                               CPW01280
            MVC APIDLED,CPIDL                                           CPW01290
            SRDL R0,12                                                  CPW01300
            ST   R1,APIDLEF                                             CPW01310
            SPACE 1                                                     CPW01320
            LM  R0,R1,APPAGED                                           CPW01330
            DSUB R0,CPPAG                                               CPW01340
            MVC APPAGED,CPPAG                                           CPW01350
            SRDL R0,12                                                  CPW01360
            ST  R1,APPAGEF                                              CPW01370
            SPACE 1                                                     CPW01380
            LM  R0,R1,APIONTD                                           CPW01390
            DSUB R0,CPION                                               CPW01400
            MVC APIONTD,CPION                                           CPW01410
            SRDL  R0,12                                                 CPW01420
            ST    R1,APIONTF                                            CPW01430
            SPACE 1                                                     CPW01440
            LM    R0,R1,APPROBD                                         CPW01450
            DSUB  R0,CPROB                                              CPW01460
            MVC   APPROBD,CPROB                                         CPW01470
            SRDL  R0,12                                                 CPW01480
            ST    R1,APPROBF                                            CPW01490
            SPACE 1                                                     CPW01500
            L     R1,CPSVC                                              CPW01510
            S     R1,APSVCCT                                            CPW01520
            ST    R1,APSVCF                                             CPW01530
            MVC   APSVCCT,CPSVC                                         CPW01540
            SPACE 1                                                     CPW01550
         IF END                                                         CPW01560
         IF TM,XAPSTAT1,APUOPER,Z,OR,                                  +CPW01570
               TM,OAPSTAT1,APUOPER,Z,THEN NO VALID DIFFERENCES.         CPW01580
            XC  APIDLEF,APIDLEF CLEAR ANY DIFFERENCES - THEY'RE WRONG.  CPW01590
            XC  APPAGEF,APPAGEF                                         CPW01600
            XC  APIONTF,APIONTF                                         CPW01610
            XC  APPROBF,APPROBF                                         CPW01620
            XC  APSVCF,APSVCF                                           CPW01630
         IF END                                                         CPW01640
         SPACE 3                                                        CPW01650
         L     R7,AASYSLC                                               CPW01660
LOCLST   DCPLIST SYSLOCS,(NON,DMKSYSNM),(NMA,DMKSYSMA),                +CPW01670
               (NMU,DMKSYSMU),(NDI,DMKSYSND)                            CPW01680
         DCP   LOCLST,BASE=(R7)                                         CPW01690
         SPACE 1                                                        CPW01700
         MVC   CPUSRS,NON                                               CPW01710
         MVC   CPDIAL,NDI                                               CPW01720
         MVC   CPMAXA,NMA                                               CPW01730
         MVC   CPMAXU,NMU                                               CPW01740
         SPACE 1                                                        CPW01750
         MVC CPFREE,ADSPNP    FETCH FREE PAGES.                         CPW01760
         OI  CPFREE,X'80'                                               CPW01770
         LA  R0,0                                                       CPW01780
         LA  R1,CPFREE                                                  CPW01790
         SVC SVCDCP                                                     CPW01800
         SPACE 3                                                        CPW01810
*              PAGING STUFF                                             CPW01820
         MVC CPDPTRPR,CPTPTRPR          SAVE OLD TOTAL                  CPW01830
         MVC CPTPTRPR,CPAPTRPR          MOVE IN  ADDRESS                CPW01840
         MVC CPDPTRFF,CPTPTRFF                                          CPW01850
         MVC CPTPTRFF,CPAPTRFF                                          CPW01860
         MVC CPDPTRSS,CPTPTRSS                                          CPW01870
         MVC CPTPTRSS,CPAPTRSS                                          CPW01880
         MVC CPTPTRSC,CPAPTRSC                                          CPW01890
         SPACE 1                                                        CPW01900
         XC    CPTPTR00,CPTPTR00        ZERO OFFSET                     CPW01910
         OI  CPTPTRSC,X'80'   MARK END.                                 CPW01920
         SR  R0,R0                                                      CPW01930
         LA  R1,CPTPTR00                                                CPW01940
         SVC SVCDCP                                                     CPW01950
         SPACE 1                                                        CPW01960
*                             CALCULATE DIFFERENCES WHERE SIGNIFICANT.  CPW01970
         L   R1,CPTPTRPR                                                CPW01980
         S   R1,CPDPTRPR                                                CPW01990
         ST  R1,CPDPTRPR                                                CPW02000
         SPACE 1                                                        CPW02010
         L   R1,CPTPTRFF                                                CPW02020
         S   R1,CPDPTRFF                                                CPW02030
         ST  R1,CPDPTRFF                                                CPW02040
         SPACE 1                                                        CPW02050
         L   R1,CPTPTRSS                                                CPW02060
         S   R1,CPDPTRSS                                                CPW02070
         ST  R1,CPDPTRSS                                                CPW02080
         SPACE 1                                                        CPW02090
         SPACE 3                                                        CPW02100
         IF CP,SNAPS,=P'1',EQ,THEN (SOME THINGS WON'T BE REAL)          CPW02110
            XC  CPIDLEF,CPIDLEF         MAIN PROCESSOR                  CPW02120
            XC  CPPAGEF,CPPAGEF                                         CPW02130
            XC  CPIONTF,CPIONTF                                         CPW02140
            XC  CPPROBF,CPPROBF                                         CPW02150
            SPACE 1                                                     CPW02160
            XC  APIDLEF,APIDLEF         ATTACHED PROCESSOR              CPW02170
            XC  APPAGEF,APPAGEF                                         CPW02180
            XC  APIONTF,APIONTF                                         CPW02190
            XC  APPROBF,APPROBF                                         CPW02200
            SPACE 1                                                     CPW02210
            XC  CPDPTRPR,CPDPTRPR                                       CPW02220
            XC  CPDPTRFF,CPDPTRFF                                       CPW02230
            XC  CPDPTRSS,CPDPTRSS                                       CPW02240
            XC  CPDPGR,CPDPGR                                           CPW02250
            XC  CPDPGW,CPDPGW                                           CPW02260
         IF END                                                         CPW02270
         PROC  END                                                      CPW02280
         EJECT                                                          CPW02290
*********************************************************************** CPW02300
*              B U I L D   S Y S T E M   P A G E                        CPW02310
*********************************************************************** CPW02320
*              SYSTEM PAGE.                                             CPW02330
SYSPAGE  PROC  BEGIN                                                    CPW02340
         L     R8,ACPWSECT                                              CPW02350
         USING CPWSECT,R8                                               CPW02360
         SPACE 1                                                        CPW02370
   DATA                                                                 CPW02380
SCRSECT  DSECT                                                          CPW02390
         ORG   SCRLINE3                                                 CPW02400
         SPACE 1                                                        CPW02410
*              CPU USAGE COLUMN                                         CPW02420
CPUCOL   DS    CL21                                                     CPW02430
         ORG   CPUCOL+2*L'SCRLINE                                       CPW02440
OPROB    DS    CL17'Problem 999% 999%'                                  CPW02450
         ORG   CPUCOL+3*L'SCRLINE                                       CPW02460
OPAG     DS    CL17'Page Wait 999%'                                     CPW02470
         ORG   CPUCOL+4*L'SCRLINE                                       CPW02480
OIO      DS    CL17'I/O Wait 999%'                                      CPW02490
         ORG   CPUCOL+5*L'SCRLINE                                       CPW02500
OIDL     DS    CL17'Idle Wait 999%'                                     CPW02510
         ORG   CPUCOL+6*L'SCRLINE                                       CPW02520
OVERH    DS    CL17'Overhead 999%'                                      CPW02530
         SPACE 1                                                        CPW02540
         ORG   CPUCOL+8*L'SCRLINE                                       CPW02550
OCPUB    DS    CL17'CPU Busy 999%'                                      CPW02560
         ORG   CPUCOL+9*L'SCRLINE                                       CPW02570
OCPUI    DS    CL17'CPU Idle 999%'                                      CPW02580
         SPACE 1                                                        CPW02590
         ORG   CPUCOL+11*L'SCRLINE                                      CPW02600
OTOTLI   DS    CL17'TOTAL, APU+CPU:'                                    CPW02610
         ORG   OTOTLI+L'SCRLINE                                         CPW02620
OPROBF   DS    CL17'PROB 999%'                                          CPW02630
         ORG   OPROBF+L'SCRLINE                                         CPW02640
OTOTF    DS    CL17'BUSY 999%'                                          CPW02650
         SPACE 1                                                        CPW02660
         ORG   CPUCOL+15*L'SCRLINE                                      CPW02670
SVCRATE  DS    CL17'SVC      99999'                                     CPW02680
         ORG                                                            CPW02690
         SPACE 6                                                        CPW02700
*        STORAGE COLUMN                                                 CPW02710
         ORG   CPUCOL+L'CPUCOL                                          CPW02720
STORCOL  DS    CL21                                                     CPW02730
         ORG   STORCOL+2*L'SCRLINE                                      CPW02740
REALCORE DS    CL18'REAL CORE 99999'                                    CPW02750
         ORG   STORCOL+3*L'SCRLINE                                      CPW02760
FREECORE DS    CL18'FREE CORE 99999'                                    CPW02770
         ORG   STORCOL+5*L'SCRLINE                                      CPW02780
PAGER    DS    CL17'PAGE TURN 9999/S'                                   CPW02790
         ORG   STORCOL+6*L'SCRLINE                                      CPW02800
PAGEL    DS    CL17'PAGE LOAD 999%'                                     CPW02810
         ORG   STORCOL+8*L'SCRLINE                                      CPW02820
PAGEREQ  DS    CL17'PAGE REQ 999.9/S'                                   CPW02830
         ORG   STORCOL+9*L'SCRLINE                                      CPW02840
STEALS   DS    CL17'STEALS 999.9/S'                                     CPW02850
         ORG   STORCOL+10*L'SCRLINE                                     CPW02860
FLUSHES  DS    CL17'FLUSHES 999.9/S'                                    CPW02870
         ORG   STORCOL+11*L'SCRLINE                                     CPW02880
PAGEREC  DS    CL17'RECLAIMS 999.9/S'                                   CPW02890
         ORG   STORCOL+13*L'SCRLINE                                     CPW02900
SRES     DS    CL17'RES SHARE 99999K'                                   CPW02910
         ORG                                                            CPW02920
         SPACE 6                                                        CPW02930
*              QUEUES COLUMN                                            CPW02940
         ORG   STORCOL+L'STORCOL                                        CPW02950
QUECOL   DS    CL21                                                     CPW02960
         ORG   QUECOL+2*L'SCRLINE                                       CPW02970
LOGGON   DS    CL17'LOGGED ON 9999'                                     CPW02980
         ORG   QUECOL+3*L'SCRLINE                                       CPW02990
DIALLED  DS    CL17'DIALLED 9999'                                       CPW03000
         ORG   QUECOL+5*L'SCRLINE                                       CPW03010
ACTIVE   DS    CL17'ACTIVE 9999'                                        CPW03020
         ORG   QUECOL+6*L'SCRLINE                                       CPW03030
INACTIVE DS    CL17'INACTIVE 9999'                                      CPW03040
         ORG   QUECOL+7*L'SCRLINE                                       CPW03050
ASLEEP   DS    CL17'ASLEEP 9999'                                        CPW03060
         ORG   QUECOL+9*L'SCRLINE                                       CPW03070
QUE1     DS    CL17'QUEUE1 99999'                                       CPW03080
         ORG   QUECOL+10*L'SCRLINE                                      CPW03090
QUE2     DS    CL17'QUEUE2 99999'                                       CPW03100
         ORG   QUECOL+11*L'SCRLINE                                      CPW03110
QUE3     DS    CL17'QUEUE3 99999'                                       CPW03120
         ORG   QUECOL+12*L'SCRLINE                                      CPW03130
QUEL     DS    CL17'ELIGIBLE 99999'                                     CPW03140
         ORG                                                            CPW03150
         SPACE 6                                                        CPW03160
*              CHANNELS COLUMN                                          CPW03170
         ORG   QUECOL+L'QUECOL                                          CPW03180
CHANCOL  DS    CL17'CHANNELS'                                           CPW03190
         ORG   CHANCOL+2*L'SCRLINE                                      CPW03200
CHAN0L   DS    CL17'CHAN 0   9999/S'                                    CPW03210
         ORG                                                            CPW03220
*        (NOTE THAT CHANNELS COULD EXTEND DOWN FOR 16 LINES)            CPW03230
         SPACE 6                                                        CPW03240
*              CPU IDENTIFICATION MESSAGE.                              CPW03250
         ORG   SCREEND-2*L'SCRLINE                                      CPW03260
         DS    CL26                                                     CPW03270
CPUI     DC    C'CPU MODEL XXXX SERIAL XXXXXX'                          CPW03280
         ORG   CPUI+10                                                  CPW03290
CPUMODL  DS    CL4                                                      CPW03300
         DS    CL8                                                      CPW03310
CPUSERL  DS    CL6                                                      CPW03320
         SPACE 2                                                        CPW03330
*              VM IDENTIFICATION MESSAGE.                               CPW03340
         ORG   SCREEND-L'SCRLINE                                        CPW03350
         DS    CL14                                                     CPW03360
CPSYSREL DS    CL(L'CPREL)                                              CPW03370
CPUP     DC    C' HAS BEEN UP .... DAYS .. HOURS .. MIN'                CPW03380
         ORG   CPUP+13                                                  CPW03390
CPUPD    DS    CL4                                                      CPW03400
         DS    CL6                                                      CPW03410
CPUPH    DS    CL2                                                      CPW03420
         DS    CL7                                                      CPW03430
CPUPM    DS    CL2                                                      CPW03440
         ORG                                                            CPW03450
         SPACE 3                                                        CPW03460
         PROC                                                           CPW03470
         L     R9,=V(DSPSYS)                                            CPW03480
         USING DSPSECT,R9                                               CPW03490
         SR    R10,R10                                                  CPW03500
         IF CP,LISTNRS,=P'0',GT,THEN                                    CPW03510
            OI  DSPFLAGS,DSPNEW                                         CPW03520
            SPACE 1                                                     CPW03530
            LR  R1,R9                                                   CPW03540
            LR  R0,R10                                                  CPW03550
            CALL NEWSCR                                                 CPW03560
            LR  R10,R0        NEW SCREEN.                               CPW03570
            USING SCRSECT,R10                                           CPW03580
            DATA                                                        CPW03590
SYSTIT      DC  C'CPWATCH SYSTEM STATUS'                                CPW03600
SYSOFS      EQU  (80-L'SYSTIT)/2                                        CPW03610
            PROC                                                        CPW03620
            MVC SCREEN+SYSOFS(L'SYSTIT),SYSTIT                          CPW03630
            EJECT                                                       CPW03640
*              CPU USAGE COLUMN.                                        CPW03650
            IF TM,XAPSTAT1,APUOPER+APUNONLN,NZ,THEN                     CPW03660
               MVC CPUCOL,=CL(L'CPUCOL)'USAGE:   APU  CPU'              CPW03670
            IF ELSE                                                     CPW03680
               MVC CPUCOL,=CL(L'CPUCOL)'CPU USAGE'                      CPW03690
            IF END                                                      CPW03700
            SPACE 1                                                     CPW03710
            MVC OPROB,=CL(L'OPROB)'PROBLEM'                             CPW03720
            L   R1,CPPROBF    PROBLEM STATE, IN USEC.                   CPW03730
            SR  R0,R0                                                   CPW03740
            D   R0,SNAPINT    / CLOCK, IN MILLISECONDS                  CPW03750
            SR  R0,R0                                                   CPW03760
            A   R1,=F'5'      ROUND OFF TENTHS OF PERCENT               CPW03770
            D   R0,=F'10'                                               CPW03780
            CALL DECIT                                                  CPW03790
            MVC OPROB+L'OPROB-3-1(3),28-3(R13)                          CPW03800
            MVI OPROB+L'OPROB-1,C'%'                                    CPW03810
            SPACE 1                                                     CPW03820
            IF TM,XAPSTAT1,APUOPER+APUNONLN,NZ,THEN                     CPW03830
               L   R1,APPROBF                                           CPW03840
               SR  R0,R0                                                CPW03850
               D   R0,SNAPINT                                           CPW03860
               SR  R0,R0                                                CPW03870
               A   R1,=F'5'                                             CPW03880
               D   R0,=F'10'                                            CPW03890
               CALL DECIT                                               CPW03900
               MVC OPROB+L'OPROB-5-3(3),28-3(R13)                       CPW03910
            IF END                                                      CPW03920
            SPACE 1                                                     CPW03930
            MVC OPAG,=CL(L'OPAG)'PAGE WAIT'                             CPW03940
            L   R1,CPPAGEF                                              CPW03950
            SR  R0,R0                                                   CPW03960
            D   R0,SNAPINT                                              CPW03970
            SR  R0,R0                                                   CPW03980
            A   R1,=F'5'                                                CPW03990
            D   R0,=F'10'                                               CPW04000
            CALL DECIT                                                  CPW04010
            MVC OPAG+L'OPAG-3-1(3),28-3(R13)                            CPW04020
            MVI OPAG+L'OPAG-1,C'%'                                      CPW04030
            IF TM,XAPSTAT1,APUOPER+APUNONLN,NZ,THEN                     CPW04040
               L   R1,APPAGEF                                           CPW04050
               SR  R0,R0                                                CPW04060
               D   R0,SNAPINT                                           CPW04070
               SR  R0,R0                                                CPW04080
               A   R1,=F'5'                                             CPW04090
               D   R0,=F'10'                                            CPW04100
               CALL DECIT                                               CPW04110
               MVC OPAG+L'OPAG-5-3(3),28-3(R13)                         CPW04120
            IF END                                                      CPW04130
            SPACE 1                                                     CPW04140
            MVC OIO,=CL(L'OPROB)'I/O WAIT'                              CPW04150
            L   R1,CPIONTF                                              CPW04160
            SR  R0,R0                                                   CPW04170
            D   R0,SNAPINT                                              CPW04180
            SR  R0,R0                                                   CPW04190
            A   R1,=F'5'                                                CPW04200
            D   R0,=F'10'                                               CPW04210
            CALL DECIT                                                  CPW04220
            MVC OIO+L'OIO-3-1(3),28-3(R13)                              CPW04230
            MVI OIO+L'OIO-1,C'%'                                        CPW04240
            SPACE 1                                                     CPW04250
            IF TM,XAPSTAT1,APUOPER+APUNONLN,NZ,THEN                     CPW04260
               L   R1,APIONTF                                           CPW04270
