               L  R1,CPCHF(R5)          ACCUMULATE.                     CPW07190
               A  R1,CPCHT(R5)                                          CPW07200
               ST R1,CPCHT(R5)                                          CPW07210
*NORRIE        IF R1,NZ,THEN                                            CPW07220
                  MVC 0(L'CHAN0L,R4),=CL(L'CHAN0L)'CHAN 0'              CPW07230
                  EX  R6,OI   OR IN CHANNEL                             CPW07240
OI                OI  5(R4),0 EXECUTED.                                 CPW07250
                  SPACE 1                                               CPW07260
*                 DISPLAY DIFFERENCE.                                   CPW07270
                  CL  R6,=X'0000000A'                                   CPW07280
                  BNE  XX1                                              CPW07290
                  MVI  5(R4),X'C1'                                      CPW07300
XX1               CNOP 0,4                                              CPW07310
                  CL  R6,=X'0000000B'                                   CPW07320
                  BNE  XX2                                              CPW07330
                  MVI  5(R4),X'C2'                                      CPW07340
XX2               CNOP 0,4                                              CPW07350
                  CL  R6,=X'0000000C'                                   CPW07360
                  BNE  XX3                                              CPW07370
                  MVI  5(R4),X'C3'                                      CPW07380
XX3               CNOP 0,4                                              CPW07390
                  CL  R6,=X'0000000D'                                   CPW07400
                  BNE  XX4                                              CPW07410
                  MVI  5(R4),X'C4'                                      CPW07420
XX4               CNOP 0,4                                              CPW07430
                  CL  R6,=X'0000000E'                                   CPW07440
                  BNE  XX5                                              CPW07450
                  MVI  5(R4),X'C5'                                      CPW07460
XX5               CNOP 0,4                                              CPW07470
                  CL  R6,=X'0000000F'                                   CPW07480
                  BNE  XX6                                              CPW07490
                  MVI  5(R4),X'C6'                                      CPW07500
XX6               CNOP 0,4                                              CPW07510
                  L   R1,CPCHF(R5)                                      CPW07520
                  AR  R7,R1   ACCUMULATE                                CPW07530
                  SPACE 1                                               CPW07540
                  M   R0,=F'2000'     1000 - MSEC, 2 FOR ROUNDING       CPW07550
