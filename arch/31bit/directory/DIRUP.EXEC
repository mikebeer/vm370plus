/* DIRUP EXEC -- 9.34: MAINT may define 256 MB (Debian with Java)     */
'EXECIO * DISKR USER DIRECT A (FINIS STEM D.'
IF RC <> 0 THEN EXIT RC
N = 0
DO I = 1 TO D.0
  P = POS('USER MAINT CPCMS 16M 64M ABCDEFGH', D.I)
  IF P <> 1 THEN ITERATE
  K = POS('16M 64M', D.I)
  D.I = LEFT(D.I, K - 1)'16M 256M ABCDEFGH'SUBSTR(D.I, K + 17)
  N = N + 1
END
IF N <> 1 THEN DO; SAY 'DIRUP: MAINT line not found'; EXIT 8; END
'COPYFILE USER DIRECT A USERB934 DIRECT A (REPLACE'
'ERASE USER DIRECT A'
DO I = 1 TO D.0; QUEUE D.I; END
'EXECIO' D.0 'DISKW USER DIRECT A 0 F 80 (FINIS'
IF RC <> 0 THEN EXIT RC
'DIRECT USER DIRECT A'
SAY 'DIRUP: RC' RC
EXIT RC
