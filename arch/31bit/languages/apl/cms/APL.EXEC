/* APL EXEC -- APL (word glyphs, github.com/mikebeer/apl) on VM/370plus */
/*   APL fn.apl          run an APL script                              */
/*   APL                 interactive (type  )OFF  to leave)             */
/* Runs APLM MODULE: the C89 interpreter cross-built for CMS (M5f).     */
/* (The module has its own name: 'APL' from this EXEC would call the    */
/* EXEC again.)                                                         */
PARSE ARG ARGS
'STATE APLM MODULE *'
IF RC <> 0 THEN DO
  SAY 'APL: APLM MODULE not found -- access the disk that has it'
  EXIT 28
END
IF ARGS = '' THEN 'APLM'
ELSE DO
  QUEUE ARGS              /* CMS would cut each argument to 8 chars */
  'APLM =STACK'
END
EXIT RC
