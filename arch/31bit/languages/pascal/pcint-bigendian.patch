diff --git a/bin/pcint.h b/bin/pcint.h
index 5ac4e97..2cdd300 100644
--- a/bin/pcint.h
+++ b/bin/pcint.h
@@ -75,7 +75,14 @@
 
 #define ADDRSTACK(x)   (void *) (gs -> stack0 + (x))
 
-#define STACK_C(x)     *((char *)(ADDRSTACK (x)))
+/* a char or boolean on the stack is an int whose value is the char:
+   on a big-endian machine (S/390) its byte is the last of the four */
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define CHOFF 3
+#else
+#define CHOFF 0
+#endif
+#define STACK_C(x)     *((char *)(ADDRSTACK (x)) + CHOFF)
 #define STACK_I(x)     *((int *)(ADDRSTACK (x)))
 #define STACK_P(x)     *((void **)(ADDRSTACK (x)))
 #define STACK_R(x)     *((double *)(ADDRSTACK (x)))
