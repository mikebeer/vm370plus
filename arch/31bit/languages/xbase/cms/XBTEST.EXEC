/* XBTEST EXEC -- run xBase tests: XBTEST [C] fn1 fn2 ... (fn PRG, IN) */
/* C: the C89 interpreter (XBASEC XIMAGE), else the cREXX one.          */
ARG LIST
CVER = WORD(LIST, 1) = 'C'
IF CVER THEN LIST = SUBWORD(LIST, 2)
DO I = 1 TO WORDS(LIST)
  F = WORD(LIST, I)
  'MAKEBUF'
  IF CVER THEN QUEUE 'XBASEC' F'.prg'
  ELSE QUEUE F'.prg'
  'STATE' F 'IN *'
  IF RC = 0 THEN DO
    'EXECIO * DISKR' F 'IN * (FINIS STEM IN.'
    DO J = 1 TO IN.0; QUEUE IN.J; END
  END
  QUEUE '/*'
  SAY '=== XBTEST' F
  IF CVER THEN 'XL =STACK'
  ELSE 'RXBVM8 XBASE -a =STACK'
  R = RC
  'DROPBUF'
  SAY '=== END' F 'RC' R
END
EXIT 0
