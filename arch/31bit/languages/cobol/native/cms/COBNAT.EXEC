/* COBNAT EXEC -- build COBLIB TXTLIB: GnuCOBOL's runtime (libcob), the  */
/* GMP subset it uses and the POSIX layer, compiled on VM/370plus by    */
/* GCC380 against GCCLIB31 (9.19).  The sources (mknative.py: already   */
/* preprocessed on the PC) are fn C on mode M; COBNAT FILES lists them. */
/*   COBNAT [fm] [first]   fm: where the sources are (default C)        */
/* Each file: GCC380 -> fn ASSEMBLE (CSECT named $fn) -> ASMAHL -> TEXT */
PARSE UPPER ARG M FIRST .
IF M = '' THEN M = 'C'
'GLOBAL MACLIB GCC31 DMSGPI CMSHRC CMSLIB OSMACRO TSOMAC'
'EXECIO * DISKR COBNAT FILES' M '(FINIS STEM F.'
IF RC <> 0 THEN DO; SAY 'COBNAT: COBNAT FILES' M 'NOT FOUND'; EXIT 28; END
BAD = ''
GO = (FIRST = '')
DO I = 1 TO F.0
  FN = WORD(F.I, 1)
  IF \GO THEN DO; IF FN <> FIRST THEN ITERATE; GO = 1; END
  'STATE' FN 'TEXT' M
  IF RC = 0 THEN ITERATE           /* DONE IN AN EARLIER RUN */
  SAY 'COBNAT:' I'/'F.0 FN TIME()
  CALL COMPILE FN 'COBNAT'
  IF RESULT > 0 & RESULT < 100 THEN DO
    /* GCC380 INTERNAL ERRORS: ONCE MORE WITHOUT OPTIMIZATION */
    SAY 'COBNAT: RC' RESULT 'FROM' FN '-- AGAIN WITH -O0'
    CALL COMPILE FN 'COBNAT0'
  END
  IF RESULT <> 0 THEN DO; SAY 'COBNAT: RC' RESULT 'FROM' FN; BAD = BAD FN; END
END
IF BAD <> '' THEN DO
  SAY 'COBNAT: FAILED:' BAD
  EXIT 8
END
'ERASE COBLIB TXTLIB' M
DO I = 1 TO F.0
  FN = WORD(F.I, 1)
  IF I = 1 THEN 'TXTLIB GEN COBLIB' FN
  ELSE 'TXTLIB ADD COBLIB' FN
  IF RC <> 0 THEN DO; SAY 'COBNAT: TXTLIB RC' RC 'FOR' FN; EXIT 12; END
END
SAY 'COBNAT: COBLIB TXTLIB' M 'BUILT,' F.0 'MEMBERS'
EXIT 0

COMPILE: PROCEDURE EXPOSE M
  ARG F P
  'ERASE' F 'WORK' M
  'FILEDEF SYSPRINT TERM (LRECL 80'
  'FILEDEF SYSTERM TERM (LRECL 80'
  'FILEDEF SYSPARM DISK' P 'PARM' M
  'FILEDEF OUT DISK' F 'WORK' M '(LRECL 80 RECFM F'
  'FILEDEF SYSIN DISK' F 'C' M
  'GCC380'
  R = RC
  'FILEDEF SYSPRINT CLEAR'
  'FILEDEF SYSTERM CLEAR'
  'FILEDEF SYSPARM CLEAR'
  'FILEDEF OUT CLEAR'
  'FILEDEF SYSIN CLEAR'
  IF R > 4 THEN RETURN R
  'ERASE' F 'ASSEMBLE' M
  'RENAME' F 'WORK' M '= ASSEMBLE ='
  /* NAME THE CSECT: TXTLIB REFUSES PRIVATE CODE (AS GCLB31 DOES) */
  'MAKEBUF'
  QUEUE 'SERIAL OFF'
  QUEUE 'LOCATE /         CSECT/'
  QUEUE 'CHANGE /         CSECT/'LEFT('$'LEFT(F, 7), 9)'CSECT/'
  QUEUE 'FILE'
  'EDIT' F 'ASSEMBLE' M
  E = RC
  'DROPBUF'
  IF E <> 0 THEN RETURN 100 + E
  'ASMAHL' F '(NOTERM'
  IF RC <> 0 THEN RETURN 200 + RC
  'ERASE' F 'LISTING' M
  'ERASE' F 'ASSEMBLE' M
RETURN 0
