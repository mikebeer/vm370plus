+++ b/RunCPM/abstraction_cms.h
@@ -0,0 +1,365 @@
+/* abstraction_cms.h -- RunCPM on CMS (VM/370plus 9.33), built with the
+ * GCC 13 toolchain and cmsrt (newlib).
+ *
+ * Drives: CP/M drive X: is the CMS disk with file mode X (user 0 only).
+ * A CP/M file NAME.EXT is the CMS file NAME EXT on that disk, kept as the
+ * plain bytes (binary).  CMS files whose name does not fit 8.3 are not
+ * shown to CP/M.  A file without an extension is the CMS file type $.
+ * The CCP (CCP-DR 60K) is searched on all accessed disks.
+ *
+ * Console: CMS is line-oriented.  A line typed at the terminal is fed to
+ * CP/M character by character, ending in CR; CP/M's echo of what was typed
+ * is suppressed (the terminal shows it already).  No key is ever "waiting"
+ * (console status is 0), so a running program cannot be stopped with ^C
+ * and programs that poll the keyboard wait for a line. */
+#ifndef ABSTRACT_H
+#define ABSTRACT_H
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+#include <fcntl.h>
+#define millis() (clock() / 1000)
+#define usleep(us) ((void)0)   /* CPU speed throttling: not on CMS */
+
+#define HostOS 0x02
+
+FILE *_sys_fopen_r(uint8 *filename);
+int _sys_fseek(FILE *file, long delta, int origin);
+long _sys_ftell(FILE *file);
+long _sys_fread(void *buffer, long size, long count, FILE *file);
+int _sys_fflush(FILE *file);
+int _sys_fclose(FILE *file);
+
+/* "A/0/NAME.EXT" (or "NAME.EXT") -> "a/name.ext(b" for cmsrt's fopen;
+   0 for another user than 0 */
+static char cmsname[64];
+static const char *_cms(const uint8 *p) {
+    char drive = 0, *o = cmsname;
+    if (p[0] && p[1] == '/' ) {
+        if (p[2] != '0') return 0;
+        drive = p[0]; p += 4;
+    }
+    if (drive) { *o++ = tolower(drive); *o++ = '/'; }
+    const uint8 *dot = (const uint8 *)strchr((const char *)p, '.');
+    int n = 0;
+    while (*p && *p != '.' && n < 8) { *o++ = tolower(*p++); n++; }
+    *o++ = '.';
+    if (dot && dot[1]) { p = dot + 1; n = 0; while (*p && n < 8) { *o++ = tolower(*p++); n++; } }
+    else *o++ = '$';
+    strcpy(o, "(b");
+    return cmsname;
+}
+
+uint16 _RamLoad(uint8 *filename, uint16 address, uint16 maxsize) {
+    long l;
+    FILE *file = _sys_fopen_r(filename);
+    if (!file) return 0;
+    _sys_fseek(file, 0, SEEK_END);
+    l = _sys_ftell(file);
+    if (maxsize && l > maxsize) l = maxsize;
+    _sys_fseek(file, 0, SEEK_SET);
+    _sys_fread(_RamSysAddr(address), 1, l, file);
+    _sys_fclose(file);
+    return (uint16)l;
+}
+
+#define FOLDERCHAR '/'
+#define FILEBASE "./"
+
+typedef struct {
+    uint8 dr; uint8 fn[8]; uint8 tp[3];
+    uint8 ex, s1, s2, rc; uint8 al[16];
+    uint8 cr, r0, r1, r2;
+} CPM_FCB;
+
+typedef struct {
+    uint8 dr; uint8 fn[8]; uint8 tp[3];
+    uint8 ex, s1, s2, rc; uint8 al[16];
+} CPM_DIRENTRY;
+
+/* CMS has no empty files: a file CP/M makes exists only once a record is
+   written.  Until then it is "pending" here (BDOS make, then write). */
+#define NPEND 32
+static char pend[NPEND][40];
+static int pend_find(const char *n) {
+    for (int i = 0; i < NPEND; i++) if (pend[i][0] && !strcmp(pend[i], n)) return i;
+    return -1;
+}
+static void pend_add(const char *n) {
+    if (pend_find(n) >= 0) return;
+    for (int i = 0; i < NPEND; i++) if (!pend[i][0]) { strncpy(pend[i], n, 39); return; }
+}
+static void pend_del(const char *n) { int i = pend_find(n); if (i >= 0) pend[i][0] = 0; }
+
+static FILE *_open_cms(uint8 *filename, const char *mode) {
+    const char *n = _cms(filename);
+    if (!n) return NULL;
+    if (pend_find(n) >= 0) {
+        if (mode[0] == 'r' && mode[1] != '+') return NULL;
+        pend_del(n);
+        return fopen(n, "w+b");
+    }
+    return fopen(n, mode);
+}
+FILE *_sys_fopen_r(uint8 *filename) { return _open_cms(filename, "rb"); }
+FILE *_sys_fopen_w(uint8 *filename) { return _open_cms(filename, "wb"); }
+FILE *_sys_fopen_rw(uint8 *filename) { return _open_cms(filename, "r+b"); }
+FILE *_sys_fopen_a(uint8 *filename) { return _open_cms(filename, "ab"); }
+static int _pending(uint8 *filename) { const char *n = _cms(filename); return n && pend_find(n) >= 0; }
+
+uint8 _sys_exists(uint8 *filename) {
+    if (_pending(filename)) return 1;
+    FILE *f = _sys_fopen_r(filename);
+    if (f) fclose(f);
+    return f != NULL;
+}
+
+int _sys_fseek(FILE *file, long delta, int origin) { return fseek(file, delta, origin); }
+long _sys_ftell(FILE *file) { return ftell(file); }
+long _sys_fread(void *buffer, long size, long count, FILE *file) { return fread(buffer, size, count, file); }
+long _sys_fwrite(const void *buffer, long size, long count, FILE *file) { return fwrite(buffer, size, count, file); }
+int _sys_fputc(int ch, FILE *file) { return fputc(ch, file); }
+int _sys_feof(FILE *file) { return feof(file); }
+int _sys_fflush(FILE *file) { return fflush(file); }
+int _sys_fclose(FILE *file) { return fclose(file); }
+
+int _sys_remove(uint8 *filename) {
+    const char *n = _cms(filename);
+    if (n && pend_find(n) >= 0) { pend_del(n); return 0; }
+    return n ? remove(n) : -1;
+}
+
+int _sys_rename(uint8 *name1, uint8 *name2) {
+    char a[64];
+    const char *n = _cms(name1);
+    if (!n) return -1;
+    strcpy(a, n);
+    n = _cms(name2);
+    if (!n) return -1;
+    if (pend_find(a) >= 0) { pend_del(a); pend_add(n); return 0; }
+    return rename(a, n);
+}
+
+int _sys_select(uint8 *disk) { return disk[0] >= 'A' && disk[0] <= 'P'; }
+
+long _sys_filesize(uint8 *filename) {
+    long l = -1;
+    if (_pending(filename)) return 0;
+    FILE *file = _sys_fopen_r(filename);
+    if (file != NULL) {
+        _sys_fseek(file, 0, SEEK_END);
+        l = _sys_ftell(file);
+        _sys_fclose(file);
+    }
+    return l;
+}
+
+int _sys_openfile(uint8 *filename) {
+    if (_pending(filename)) return 1;
+    FILE *file = _sys_fopen_r(filename);
+    if (file != NULL) _sys_fclose(file);
+    return file != NULL;
+}
+
+int _sys_makefile(uint8 *filename) {
+    const char *n = _cms(filename);
+    if (!n) return 0;
+    remove(n);                 /* BDOS make: a new, empty file */
+    pend_add(n);
+    return 1;
+}
+
+int _sys_deletefile(uint8 *filename) { return !_sys_remove(filename); }
+int _sys_renamefile(uint8 *filename, uint8 *newname) { return !_sys_rename(filename, newname); }
+
+#ifdef DEBUGLOG
+void _sys_logbuffer(uint8 *buffer) { fputs((char *)buffer, stderr); }
+#endif
+
+static uint8 _rw128(uint8 *filename, long fpos, int write, uint8 notfound, uint8 seekerr) {
+    uint8 result = 0xff, dmabuf[128];
+    if (!write && _pending(filename)) return seekerr == 0x06 ? 0x01 : 0x01;
+    FILE *file = write ? _sys_fopen_rw(filename) : _sys_fopen_r(filename);
+    if (file == NULL) return notfound;
+    if (write) {
+        /* writing past the end: fill the gap (cmsrt keeps the file whole) */
+        _sys_fseek(file, 0, SEEK_END);
+        long end = _sys_ftell(file);
+        while (end < fpos) { fputc(0x1a, file); end++; }
+        if (!_sys_fseek(file, fpos, 0) && _sys_fwrite(_RamSysAddr(dmaAddr), 1, 128, file))
+            result = 0x00;
+        else
+            result = seekerr;
+    } else {
+        _sys_fseek(file, 0, SEEK_END);
+        long end = _sys_ftell(file);
+        if (fpos < end && !_sys_fseek(file, fpos, 0)) {
+            memset(dmabuf, 0x1a, 128);
+            uint8 n = (uint8)_sys_fread(dmabuf, 1, 128, file);
+            for (int i = 0; i < 128; ++i) _RamWrite(dmaAddr + i, dmabuf[i]);
+            result = n ? 0x00 : 0x01;
+        } else if (seekerr == 0x06) {      /* random read */
+            long ext = 16384 * ((end / 16384) + ((end % 16384) ? 1 : 0));
+            result = fpos >= 65536L * 128 ? 0x06 : fpos < ext ? 0x01 : 0x04;
+        } else
+            result = 0x01;
+    }
+    _sys_fclose(file);
+    return result;
+}
+
+uint8 _sys_readseq(uint8 *filename, long fpos) { return _rw128(filename, fpos, 0, 0x10, 0x01); }
+uint8 _sys_writeseq(uint8 *filename, long fpos) { return _rw128(filename, fpos, 1, 0x10, 0x01); }
+uint8 _sys_readrand(uint8 *filename, long fpos) { return _rw128(filename, fpos, 0, 0x10, 0x06); }
+uint8 _sys_writerand(uint8 *filename, long fpos) { return _rw128(filename, fpos, 1, 0x10, 0x06); }
+
+uint8 _Truncate(char *fn, uint8 rc) {
+    FILE *f = _sys_fopen_r((uint8 *)fn);
+    if (!f) return 0xff;
+    long want = (long)rc * 128;
+    char *buf = malloc(want ? want : 1);
+    long n = buf ? (long)fread(buf, 1, want, f) : 0;
+    fclose(f);
+    if (!buf) return 0xff;
+    f = _sys_fopen_w((uint8 *)fn);
+    if (!f) { free(buf); return 0xff; }
+    fwrite(buf, 1, n, f);
+    fclose(f);
+    free(buf);
+    return 0x00;
+}
+
+void _MakeUserDir() { }
+uint8 _sys_makedisk(uint8 drive) { return (drive < 1 || drive > 16) ? 0xff : 0; }
+
+/* directory search: LISTFILE * * x through cmsrt's opendir */
+struct dirent { unsigned int d_ino; unsigned char d_type; char d_name[20]; };
+struct m8_dir;
+struct m8_dir *opendir(const char *name);
+struct dirent *readdir(struct m8_dir *d);
+int closedir(struct m8_dir *d);
+
+int dirPos;
+static char findNextDirName[128];
+static uint16 fileRecords = 0;
+static uint16 fileExtents = 0;
+static uint16 fileExtentsUsed = 0;
+static uint16 firstFreeAllocBlock;
+
+uint8 _findnext(uint8 isdir) {
+    uint8 result = 0xff;
+    if (allExtents && fileRecords) {
+        _mockupDirEntry(1);
+        return 0;
+    }
+    if (filename[2] != '0' && !allUsers) return 0xff;
+    char m[2] = { filename[0], 0 };
+    struct m8_dir *d = opendir(m);
+    if (!d) return 0xff;
+    struct dirent *e;
+    int i = 0;
+    while ((e = readdir(d)) != NULL) {
+        if (i++ < dirPos) continue;
+        ++dirPos;
+        char *dot = strchr(e->d_name, '.');
+        if (!dot || dot - e->d_name > 8 || strlen(dot + 1) > 3) continue;
+        char sn[20];
+        int k = 0;
+        for (char *p = e->d_name; *p && k < 12; p++) sn[k++] = toupper((unsigned char)*p);
+        sn[k] = 0;
+        if (!strcmp(strchr(sn, '.'), ".$")) *strchr(sn, '.') = 0;
+        snprintf(findNextDirName, sizeof findNextDirName, "%sA/0/%s", FILEBASE, sn);
+        findNextDirName[strlen(FILEBASE)] = filename[0];
+        char *shortName = &findNextDirName[strlen(FILEBASE)];
+        _HostnameToFCBname((uint8 *)shortName, fcbname);
+        if (!match(fcbname, pattern)) continue;
+        if (allUsers) currFindUser = 0;
+        if (isdir) {
+            uint32 bytes = (uint32)_sys_filesize((uint8 *)shortName);
+            if (bytes & (BlkSZ - 1)) bytes = (bytes & ~(BlkSZ - 1)) + BlkSZ;
+            fileRecords = bytes / BlkSZ;
+            fileExtents = fileRecords / BlkEX + ((fileRecords & (BlkEX - 1)) ? 1 : 0);
+            fileExtentsUsed = 0;
+            firstFreeAllocBlock = firstBlockAfterDir;
+            _mockupDirEntry(1);
+        } else {
+            fileRecords = 0; fileExtents = 0; fileExtentsUsed = 0;
+            firstFreeAllocBlock = firstBlockAfterDir;
+        }
+        _RamWrite(tmpFCB, filename[0] - '@');
+        _HostnameToFCB(tmpFCB, (uint8 *)shortName);
+        result = 0x00;
+        break;
+    }
+    closedir(d);
+    return result;
+}
+
+uint8 _findfirst(uint8 isdir) {
+    dirPos = 0;
+    _HostnameToFCBname(filename, pattern);
+    fileRecords = 0; fileExtents = 0; fileExtentsUsed = 0;
+    return _findnext(isdir);
+}
+uint8 _findnextallusers(uint8 isdir) { return _findnext(isdir); }
+uint8 _findfirstallusers(uint8 isdir) {
+    dirPos = 0;
+    strcpy((char *)pattern, "???????????");
+    fileRecords = 0; fileExtents = 0; fileExtentsUsed = 0;
+    return _findnextallusers(isdir);
+}
+
+void _HardwareInit(void) { }
+void _HardwareOut(const uint32 Port, const uint32 Value) { }
+uint32 _HardwareIn(const uint32 Port) { return 0; }
+
+/* console: lines from the terminal, CP/M's echo of them suppressed */
+static char echoq[160];
+static int echo_n, echo_pos, echo_cr;
+
+void _console_init(void) {
+    setvbuf(stdin, NULL, _IONBF, 0);
+}
+void _console_reset(void) { fflush(stdout); }
+
+int _kbhit(void) { return 0; }
+
+uint8 _getch(void) {
+    int c = getchar();
+    if (c == EOF) exit(0);
+    if (c == '\n') c = '\r';
+    if (echo_pos >= echo_n) echo_n = echo_pos = 0;
+    if (echo_n < (int)sizeof echoq) echoq[echo_n++] = (char)c;
+    return (uint8)c;
+}
+
+void _putch(uint8 ch) {
+    if (echo_pos < echo_n && ch == (uint8)echoq[echo_pos]) {
+        if (ch == '\r') echo_cr = 1;
+        echo_pos++;
+        return;
+    }
+    if (echo_cr) {             /* the CR LF after the typed line */
+        echo_cr = 0;
+        if (ch == '\n') return;
+    }
+    if (ch == '\r') return;
+    putchar(ch == 0x1a ? ' ' : ch);
+}
+
+uint8 _getche(void) {
+    uint8 ch = _getch();
+    _putch(ch);
+    return ch;
+}
+
+void _clrscr(void) { }
+
+#endif
