+/* VM/370plus: CPM IMPORT fn ft [fm] / CPM EXPORT fn ft [fm] turn a CMS
+   text file into a CP/M text file (ASCII, CR LF, ^Z) in place, and back */
+static int cms_convert(int import, char *fn, char *ft, char *fm) {
+    char t[40], b[44];
+    snprintf(t, sizeof t, "%s.%s.%s", fn, ft, fm);
+    snprintf(b, sizeof b, "%s/%s.%s(b", fm, fn, ft);
+    FILE *in = fopen(import ? t : b, "r" "b");
+    if (!in) { printf("CPM: %s %s %s not found\n", fn, ft, fm); return 28; }
+    if (import) { fclose(in); in = fopen(t, "r"); }
+    size_t cap = 8192, n = 0; int c;
+    char *d = malloc(cap);
+    while (d && (c = fgetc(in)) != EOF) {
+        if (n + 4 >= cap) d = realloc(d, cap *= 2);
+        if (!d) break;
+        if (import) { if (c == '\n') { d[n++] = '\r'; d[n++] = '\n'; } else d[n++] = c; }
+        else { if (c == 0x1a) break; if (c != '\r') d[n++] = c; }
+    }
+    fclose(in);
+    if (!d) { printf("CPM: no storage\n"); return 104; }
+    if (import) d[n++] = 0x1a;
+    FILE *out = fopen(import ? b : t, "w");
+    if (!out) { printf("CPM: cannot write %s %s %s\n", fn, ft, fm); return 36; }
+    fwrite(d, 1, n, out);
+    fclose(out);
+    free(d);
+    printf("CPM: %s %s %s is now a %s file\n", fn, ft, fm, import ? "CP/M" : "CMS");
+    return 0;
+}
+#endif
