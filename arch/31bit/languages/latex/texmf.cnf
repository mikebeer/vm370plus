% texmf.cnf -- VM/370plus 9.27: the small TeX tree in the Debian guest
TEXMFROOT = /usr/local/texlive
TEXMFDIST = $TEXMFROOT/texmf-dist
TEXMFVAR = $TEXMFROOT/texmf-var
TEXMFSYSVAR = $TEXMFVAR
TEXMFHOME = $TEXMFROOT/texmf-home
TEXMF = {$TEXMFVAR,$TEXMFDIST}
TEXMFDBS = {$TEXMFVAR,$TEXMFDIST}
VARTEXFONTS = $TEXMFVAR/fonts
TEXINPUTS = .;$TEXMF/tex/{latex,generic,}//
TEXINPUTS.tex = .;$TEXMF/tex/{plain,generic,}//
TEXFORMATS = .;$TEXMF/web2c//
TFMFONTS = .;$TEXMF/fonts/tfm//
VFFONTS = .;$TEXMF/fonts/vf//
PKFONTS = .;$TEXMF/fonts/pk/{ljfour,}//
GFFONTS = .;$TEXMF/fonts/gf//
T1FONTS = .;$TEXMF/fonts/type1//
TEXFONTMAPS = .;$TEXMF/fonts/map/{dvips,}//
ENCFONTS = .;$TEXMF/fonts/enc//
TEXPSHEADERS = .;$TEXMF/{dvips,fonts/{enc,type1}}//
TEXCONFIG = .;$TEXMF/dvips//
INDEXSTYLE = .;$TEXMF/makeindex//
TEXPOOL = .;$TEXMF/web2c
MKTEXPK = 0
MKTEXTFM = 0
MKTEXFMT = 0
main_memory = 2000000
font_mem_size = 2000000
font_max = 9000
hash_extra = 200000
pool_size = 3000000
string_vacancies = 90000
max_strings = 200000
pool_free = 47500
buf_size = 200000
trie_size = 1100000
hyph_size = 8191        % prime number of hyphenation exceptions, >610, <65535
max_in_open = 15        % simultaneous input files and error insertions, 
param_size = 20000      % simultaneous macro parameters, also applies to MP
save_size  = 200000     % for saving values outside current group
stack_size = 10000      % simultaneous input sources
dvi_buf_size = 16384 % TeX
error_line = 79
half_error_line = 50
max_print_line = 79
WEB2C = $TEXMF/web2c
TEXINPUTS.pdftex = .;$TEXMF/tex/{plain,generic,}//
TEXINPUTS.latex = .;$TEXMF/tex/{latex,generic,}//
TEXINPUTS.pdflatex = .;$TEXMF/tex/{latex,generic,}//
TEXINPUTS.pdftexini = .;$TEXMF/tex/{latex,generic,}//
