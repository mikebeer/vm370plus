/* PLIC EXEC -- PL/I on VM/370plus CMS (mikebeer/pli, 9.20)            */
/*   PLIC fn       fn PLI -> fn C (PLI2C MODULE, the translator)       */
/*                 -> GCC380 with GCCLIB31 -> fn TEXT -> fn MODULE     */
/* Needs: PLI2C MODULE, PLIRT H and PLICMS H, GCCLIB31 (its headers,   */
/* GCC31 MACLIB, GCCLIB31 TXTLIB and M5G PARM: CMSUSER 195).          */
PARSE ARG FN .
IF FN = '' THEN DO; SAY 'PLIC: give the file name (filetype PLI)'; EXIT 24; END
'STATE' FN 'PLI *'
IF RC <> 0 THEN DO; SAY 'PLIC:' FN 'PLI not found'; EXIT 28; END
QUEUE FN'.pli -o' FN'.c'     /* CMS would cut and upper-case options */
'PLI2C =STACK'
IF RC <> 0 THEN EXIT RC
'EXEC GCC31' FN 'C A ( LIB GCC31 PARM M5G'
IF RC <> 0 THEN EXIT RC
'GLOBAL TXTLIB GCCLIB31'
'LOAD' FN '(CLEAR NOMAP'
IF RC <> 0 THEN EXIT RC
'GENMOD' FN
EXIT RC
