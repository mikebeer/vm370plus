/* DIRUP4 EXEC -- 9.13b: RSCS becomes the NJE gateway (NJEGATE EXEC  */
/* on 19E, through NJE-II in the Debian guest).  CE's RSCS V1 entry */
/* is kept as RSCSV1; RSCS gets IPL CMS and its own 191 (VM50U1     */
/* cylinders 91-100) with a PROFILE EXEC that runs NJEGATE.         */
'EXECIO * DISKR USER DIRECT A (FINIS STEM D.'
if rc <> 0 then exit rc
have = 0; old = 0
do i = 1 to d.0
  if word(d.i, 1) <> 'USER' then iterate
  if word(d.i, 2) = 'RSCS' & word(d.i, 3) = 'RSCS' then old = i
  if word(d.i, 2) = 'RSCS' & word(d.i, 3) = 'NJEGATE' then have = 1
end
if have then do; say 'DIRUP4: RSCS is already the gateway'; exit 0; end
if old = 0 then do; say 'DIRUP4: no USER RSCS RSCS'; exit 8; end
r = subword(left(d.old, 72), 4)
d.old = left('USER RSCSV1 RSCSV1' r, 72)substr(d.old, 73)
e.1  = '*'
e.2  = '* RSCS (9.13b): the NJE gateway.  SENDFILE to a user at another'
e.3  = '* node spools to RSCS with a TAG; NJEGATE EXEC (19E) passes the'
e.4  = '* file to NJE-II in the Debian guest.  AUTOLOG1 starts it.'
e.5  = '* CE''s RSCS V1 is RSCSV1.'
e.6  = '*'
e.7  = 'USER RSCS NJEGATE 8M 16M G'
e.8  = ' OPTION ECMODE'
e.9  = ' IPL CMS'
e.10 = ' CONSOLE 009 3215'
e.11 = ' SPOOL 00C 2540 READER *'
e.12 = ' SPOOL 00D 2540 PUNCH A'
e.13 = ' SPOOL 00E 1403 A'
e.14 = ' LINK MAINT 190 190 RR'
e.15 = ' LINK MAINT 19D 19D RR'
e.16 = ' LINK MAINT 19E 19E RR'
e.17 = ' MDISK 191 3350 091 010 VM50U1 MR ALL WRITE MULT'
'COPYFILE USER DIRECT A USERB913 DIRECT A (REPLACE'
'ERASE USER DIRECT A'
do i = 1 to d.0; queue d.i; end
do i = 1 to 17; queue left(e.i, 80); end
'EXECIO' d.0 + 17 'DISKW USER DIRECT A 0 F 80 (FINIS'
if rc <> 0 then exit rc
'DIRECT USER DIRECT A'
say 'DIRUP4: RC' rc
exit rc
