/* NJEINST EXEC -- 9.13b: install the NJE gateway on MAINT.  On A:   */
/* DIRUP4 EXEC, NJEGATE EXEC, TELL EXEC, RSCSPROF EXEC (the PROFILE  */
/* of RSCS), AL1PROF EXEC (the PROFILE of AUTOLOG1).                 */
'EXEC DIRUP4'
IF RC <> 0 THEN EXIT RC
/* RSCS's 191: format it if it is new, then its PROFILE EXEC        */
'CP LINK RSCS 191 391 MR MULT'
IF RC <> 0 THEN EXIT RC
'EXECIO * CP (STRING QUERY VIRTUAL 391'
PARSE PULL L
IF POS('R/W', L) = 0 THEN DO
  SAY 'NJEINST: RSCS 191 is not R/W:' L
  'CP DETACH 391'
  EXIT 8
END
'SET CMSTYPE HT'
'ACCESS 391 B'
R = RC
'SET CMSTYPE RT'
IF R <> 0 THEN DO
  QUEUE 'YES'
  QUEUE 'RSCS'
  'FORMAT 391 B'
  IF RC <> 0 THEN EXIT RC
END
'COPYFILE RSCSPROF EXEC A PROFILE EXEC B (REPLACE'
'RELEASE B'
'CP DETACH 391'
/* AUTOLOG1 starts RSCS                                             */
'CP LINK AUTOLOG1 191 391 MR'
'ACCESS 391 B'
'COPYFILE AL1PROF EXEC A PROFILE EXEC B (REPLACE'
'RELEASE B'
'CP DETACH 391'
/* NJEGATE on 19E; TELL where it is (19D)                           */
'ACCESS 19E D'
'COPYFILE NJEGATE EXEC A = = D2 (REPLACE'
'RELEASE D'
'ACCESS 19D E'
'COPYFILE TELL EXEC A = = E (REPLACE'
'RELEASE E'
SAY 'NJEINST: done; start the gateway with CP AUTOLOG RSCS NJEGATE'
EXIT 0
