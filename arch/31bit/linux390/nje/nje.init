#!/bin/sh
### BEGIN INIT INFO
# Provides:          nje
# Required-Start:    $network $syslog vmspoold
# Required-Stop:     $network $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: VM/370plus NJE node: NJE-II's njed (9.13b)
### END INIT INFO
N=/usr/local/nje; P=$N/etc/nje.pid
running() { [ -r $P ] && kill -0 $(cat $P) 2>/dev/null; }
case "$1" in
start)   [ -r $N/etc/nje.cf ] || { echo "nje: no $N/etc/nje.cf (njeconf)"; exit 0; }
         running && exit 0
         echo -n "Starting VM/370plus NJE: njed"; (cd $N && setsid $N/bin/njed >/dev/null 2>&1 </dev/null &); echo "." ;;
stop)    echo -n "Stopping VM/370plus NJE: njed"; running && kill $(cat $P) 2>/dev/null; pkill -x njed 2>/dev/null; rm -f $P; echo "." ;;
restart|force-reload) $0 stop; sleep 1; $0 start ;;
status)  pgrep -x njed >/dev/null && echo "njed is running" || { echo "njed is not running"; exit 3; } ;;
*)       echo "usage: $0 start|stop|restart|status"; exit 2 ;;
esac
