#!/usr/bin/python3
"""ask -- vmspoold service (9.10): a question to the AI gateway.

    Q       the question is the input (ASK EXEC writes it; a file given
            with ASK ... (FILE follows it, after a line  --- fn ft ---)
    NEW     forget the user's earlier questions and answers
The answer comes back in lines of at most 79 characters.
"""
import os, sys
sys.path.insert(0, os.environ.get('VMMAIL_LIB', '/usr/local/lib/vmspool'))
import vmask

user = os.environ.get('VMSPOOL_FROM') or 'unknown'
cmd = sys.argv[1].upper() if len(sys.argv) > 1 else ''
if cmd == 'NEW':
    vmask.forget(user)
    print('ask: earlier questions forgotten')
    sys.exit(0)
if cmd != 'Q':
    print('ask: Q (the question on input) or NEW')
    sys.exit(4)
q = sys.stdin.buffer.read().decode('latin-1')
q = '\n'.join(l.rstrip() for l in q.split('\n')).strip()
if not q:
    print('ask: no question')
    sys.exit(4)
try:
    a, secs = vmask.ask(user, q)
except Exception as e:
    print('ask: %s' % e)
    sys.exit(8)
for l in vmask.lines(a):
    print(l)
sys.exit(0)
