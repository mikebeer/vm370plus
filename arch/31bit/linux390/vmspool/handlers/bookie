#!/bin/sh
# bookie -- vmspoold: BookMaster markup from CMS (BOOKIE EXEC, 9.30)
#   TEXT          the input formatted as plain text
#   PS name       PostScript, kept as /var/spool/vmspool/out/<user>/name.ps
#                 and sent back after a  ::PS  line
# bookie.py (languages/bookie) turns the markup into troff; groff formats.
PATH=/usr/local/bin:$PATH
BK=/usr/local/lib/bookie/bookie.py
cmd=$(echo "$1" | tr a-z A-Z)
case "$cmd" in
TEXT) python3 $BK --groff text ;;
PS)   n=$(echo "$2" | tr A-Z a-z); case "$n" in ''|*[!a-z0-9_@#$-]*) echo "bookie: bad name: $2"; exit 4;; esac
      d=/var/spool/vmspool/out/$(echo "$VMSPOOL_FROM" | tr A-Z a-z); mkdir -p $d
      python3 $BK --groff ps -o $d/$n.ps 2>$d/$n.log; rc=$?
      cat $d/$n.log
      echo "bookie: $d/$n.ps, $(wc -c < $d/$n.ps) bytes, $(grep -c '^%%Page:' $d/$n.ps) page(s)"
      [ $rc = 0 ] && { echo "::PS"; cat $d/$n.ps; }
      exit $rc ;;
*) echo "bookie: TEXT, PS name"; exit 4 ;;
esac
