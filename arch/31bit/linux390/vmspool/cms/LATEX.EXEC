/* LATEX EXEC -- LaTeX in the Debian guest, from CMS (9.27)            */
/*   LATEX fn [ft [fm]] [(PDF]     ft default TEX                      */
/* LaTeX (pdfTeX 2023, run twice) and dvips: the PostScript comes     */
/* back as fn PS A (for PSPRINT).  With PDF, pdfLaTeX makes a PDF in  */
/* the Debian guest (/var/spool/vmspool/out/<userid>/fn.pdf).         */
PARSE UPPER ARG LINE
OPT = ''; P = POS('(', LINE)
IF P > 0 THEN DO; OPT = SUBSTR(LINE, P + 1); LINE = LEFT(LINE, P - 1); END
PARSE VAR LINE FN FT FM .
IF FN = '' THEN DO
  SAY 'LATEX: usage: LATEX fn [ft [fm]] [(PDF]'; EXIT 24
END
IF FT = '' THEN FT = 'TEX'
IF FM = '' THEN FM = '*'
PDF = WORDPOS('PDF', OPT) > 0
'STATE' FN FT FM
IF RC <> 0 THEN DO; SAY 'LATEX:' FN FT FM 'not found'; EXIT 28; END
'SET CMSTYPE HT'
'ERASE LXCALL OPTIONS A'
'SET CMSTYPE RT'
QUEUE 'FILE' FN FT FM 'NOTYPE'   /* LXCALL's options in a file: I-277 */
'EXECIO 1 DISKW LXCALL OPTIONS A (FINIS'
IF PDF THEN 'EXEC LXCALL LATEX PDF' FN
ELSE 'EXEC LXCALL LATEX PS' FN
SRC = RC
'EXECIO * DISKR LXCALL RESULT A (FINIS STEM L.'
DO I = 2 TO L.0                 /* messages, then the PostScript       */
  IF STRIP(L.I) = '::PS' THEN LEAVE
  SAY STRIP(L.I, 'T')
END
IF PDF | I > L.0 THEN EXIT SRC
'SET CMSTYPE HT'
'ERASE' FN 'PS A'
'SET CMSTYPE RT'
N = 0
DO J = I + 1 TO L.0
  IF L.J = '' THEN QUEUE ' '; ELSE QUEUE L.J
  N = N + 1
END
IF N > 0 THEN 'EXECIO' N 'DISKW' FN 'PS A (FINIS'
SAY 'LATEX:' FN 'PS A,' N 'lines'
EXIT SRC
