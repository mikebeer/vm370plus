/* LXCALL EXEC -- call a Linux service through the spool bridge (9.25) */
/*   LXCALL service [argument ...]   (options                          */
/* options:  FILE fn [ft [fm]]   the input of the service, from a file */
/*           SERVER userid       the Linux machine (default MAINT, or  */
/*                               GLOBALV LXCALL SERVER)                */
/*           WAIT n              seconds to wait for the answer (900)  */
/*           NOTYPE              keep the answer, do not show it       */
/* The request goes to vmspoold in the Debian guest as a punch file;   */
/* its answer is kept as LXCALL RESULT A (first line VMSPOOL RC n);  */
/* RC of LXCALL is the RC of the service (404: no such service).       */
PARSE ARG SVC ARGS
OPT = ''
P = LASTPOS('(', ARGS)
IF P > 0 THEN DO; OPT = SUBSTR(ARGS, P + 1); ARGS = LEFT(ARGS, P - 1); END
IF SVC = '' | SVC = '?' THEN DO
  SAY 'LXCALL: usage: LXCALL service [arguments] (options'
  SAY '  options: FILE fn ft fm, SERVER userid, WAIT n, NOTYPE'
  EXIT 24
END
SERVER = ''
'GLOBALV SELECT LXCALL GET SERVER'
IF SERVER = '' THEN SERVER = 'MAINT'
FILE = ''; WAIT = 900; TYPE = 1
/* CE's GCCLIB segment ends CMS (DMSITP143T at F2ACD0) when a REXX    */
/* EXEC gets 8 or more arguments: an EXEC calling LXCALL puts its     */
/* options in LXCALL OPTIONS A instead (one line, erased here)        */
'SET CMSTYPE HT'
'STATE LXCALL OPTIONS A'
SRC = RC
'SET CMSTYPE RT'
IF SRC = 0 THEN DO
  'EXECIO 1 DISKR LXCALL OPTIONS A 1 (FINIS STEM O.'
  OPT = OPT O.1
  CALL QUIET 'ERASE LXCALL OPTIONS A'
END
UOPT = TRANSLATE(OPT)
DO WHILE UOPT <> ''
  PARSE VAR UOPT W UOPT
  SELECT
    WHEN W = 'FILE' THEN DO
      PARSE VAR UOPT FN FT FM UOPT
      IF FT = '' THEN FT = 'DATA'
      IF FM = '' THEN FM = '*'
      FILE = FN FT FM
    END
    WHEN W = 'SERVER' THEN PARSE VAR UOPT SERVER UOPT
    WHEN W = 'WAIT' THEN PARSE VAR UOPT WAIT UOPT
    WHEN W = 'NOTYPE' THEN TYPE = 0
    OTHERWISE DO; SAY 'LXCALL: unknown option' W; EXIT 24; END
  END
END
CALL QUIET 'ERASE LXREQ CARDS A'
QUEUE STRIP(SVC 'FROM' USERID() ARGS)
'EXECIO 1 DISKW LXREQ CARDS A (FINIS'
IF FILE <> '' THEN DO          /* the file follows the request card: */
  'STATE' FILE                 /* COPYFILE APPEND, no EXECIO STEM on  */
  IF RC <> 0 THEN DO           /* the user's file                      */
    SAY 'LXCALL:' FILE 'not found'; CALL QUIET 'ERASE LXREQ CARDS A'
    EXIT 28
  END
  CALL QUIET 'COPYFILE' FILE 'LXREQ CARDS A (APPEND'
END
'CP SPOOL PUNCH TO' SERVER 'CLASS A'
'PUNCH LXREQ CARDS A (NOHEADER'
'CP SPOOL PUNCH OFF'
CALL QUIET 'ERASE LXREQ CARDS A'
/* wait with WAKEUP (RDR): RC 3 = a reader file came, RC 2 = time is */
/* up. The reader is asked only when a file came -- BREXX aborted     */
/* (DLMalloc) at the end of LXCALL after many EXECIO CP in a loop.    */
GOT = 0
CALL TIME 'R'
DO FOREVER
  LEFT = WAIT - TRUNC(TIME('E'))
  IF LEFT <= 0 THEN LEAVE
  HMS = RIGHT(LEFT % 3600, 2, '0') || RIGHT(LEFT // 3600 % 60, 2, '0'),
     || RIGHT(LEFT // 60, 2, '0')            /* WAKEUP +hhmmss      */
  'WAKEUP +' || HMS '(RDR QUIET'
  IF RC <> 3 THEN LEAVE
  'MAKEBUF'
  'EXECIO * CP (STRING QUERY READER ALL' USERID()
  DO WHILE QUEUED() > 0
    PARSE PULL ROW
    IF WORD(ROW, 1) = SERVER & WORD(ROW, 10) = 'VMSPOOL' THEN DO
      GOT = 1; SID = WORD(ROW, 2); END
  END
  'DROPBUF'
  IF GOT THEN LEAVE
END
IF \GOT THEN DO; SAY 'LXCALL: no answer from' SERVER; EXIT 8; END
/* 9.18: other files (mail) may be in the reader: the answer first   */
CALL QUIET 'CP ORDER READER' SID
CALL QUIET 'ERASE LXCALL RESULT A'
'READCARD LXCALL RESULT A (NOHEADER'
/* only the first card is read here: BREXX aborted (DLMalloc) at the */
/* end of LXCALL after it had read and written back a long answer     */
'EXECIO 1 DISKR LXCALL RESULT A 1 (FINIS STEM R.'
PARSE VAR R.1 W1 W2 SRC .
IF W1 <> 'VMSPOOL' | W2 <> 'RC' THEN SRC = 0
IF TYPE THEN 'TYPE LXCALL RESULT A 2 *'
EXIT SRC

QUIET: PROCEDURE
  PARSE ARG CMD
  'SET CMSTYPE HT'
  CMD
  'SET CMSTYPE RT'
  RETURN
