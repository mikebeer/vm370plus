/* PSPRINT EXEC -- a PostScript file to a real printer (9.31)          */
/*   PSPRINT fn [ft [fm]] [(BRIDGE [format]]     ft default PS         */
/* Spool (default): the file goes to the virtual printer without page */
/* headers; CP's printer 00E writes it on the PC, where              */
/* tools/psprint.py takes the PostScript out and prints it or makes  */
/* a PDF. Lines must be at most 132 characters.                       */
/* BRIDGE: through the spool bridge to the Debian guest; Ghostscript  */
/* turns it into the printer's format (ps, pdf, ljet4, pxlmono,       */
/* pxlcolor) and sends it to the printer in /etc/vmspool.d/print.conf */
PARSE UPPER ARG LINE
OPT = ''; P = POS('(', LINE)
IF P > 0 THEN DO; OPT = SUBSTR(LINE, P + 1); LINE = LEFT(LINE, P - 1); END
PARSE VAR LINE FN FT FM .
PARSE VAR OPT W1 FMT .
IF FN = '' THEN DO
  SAY 'PSPRINT: usage: PSPRINT fn [ft [fm]] [(BRIDGE [format]]'; EXIT 24
END
IF FT = '' THEN FT = 'PS'
IF FM = '' THEN FM = '*'
'STATE' FN FT FM
IF RC <> 0 THEN DO; SAY 'PSPRINT:' FN FT FM 'not found'; EXIT 28; END
'EXECIO 1 DISKR' FN FT FM '1 (FINIS STEM L.'
IF LEFT(L.1, 4) <> '%!PS' THEN DO
  SAY 'PSPRINT:' FN FT FM 'is not PostScript (no %!PS in line 1)'; EXIT 32
END
IF W1 = 'BRIDGE' THEN DO
  'SET CMSTYPE HT'
  'ERASE LXCALL OPTIONS A'
  'SET CMSTYPE RT'
  QUEUE 'FILE' FN FT FM      /* LXCALL's options in a file: I-277     */
  'EXECIO 1 DISKW LXCALL OPTIONS A (FINIS'
  'EXEC LXCALL PRINT' FMT
  EXIT RC
END
'PRINT' FN FT FM '(LINECOUNT 0'
EXIT RC
