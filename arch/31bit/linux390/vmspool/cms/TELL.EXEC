/* TELL EXEC -- send a message (9.14)                                  */
/*   TELL userid message             CP MSG to a VM/370 user           */
/*   TELL user AT LINUX message      to a user of the Debian guest,    */
/*                                   through the spool bridge          */
/*                                   (user ALL: everybody logged on)   */
/*   TELL user AT NET message        to a user on the internet (MQTT   */
/*                                   topic vm/tell/out/user, 9.32)     */
/*   TELL user AT node message       to a user on an NJE node (RSCS,   */
/*                                   JES2, NJE-II): NJE-II in Debian   */
/*   TELL user [AT LINUX]            with no message: asks for it, and */
/*                                   takes the line exactly as typed   */
/* Linux users answer with  tell userid message ; they read what came  */
/* while they were away with  tell .                                   */
/* (the prompt also keeps ( and ) as typed; on the command line CMS   */
/* hands them over as separate words)                                  */
PARSE ARG WHO REST
NODE = ''
IF TRANSLATE(WORD(REST, 1)) = 'AT' THEN DO
  NODE = TRANSLATE(WORD(REST, 2))
  REST = SUBWORD(REST, 3)
END
IF WHO = '' THEN DO
  SAY 'TELL: usage: TELL userid [AT LINUX|NET|node] [message]'
  EXIT 24
END
IF STRIP(REST) = '' THEN DO
  SAY 'TELL: enter the message for' WHO
  PARSE PULL REST
  IF STRIP(REST) = '' THEN EXIT 0
END
IF NODE = '' THEN DO
  'CP MSG' WHO REST
  EXIT RC
END
SELECT
  WHEN NODE = 'LINUX' | NODE = 'DEBIAN' THEN SVC = 'TELL'
  WHEN NODE = 'NET' | NODE = 'INTERNET' THEN SVC = 'TELLNET'
  OTHERWISE SVC = 'NJE TELL'
END
/* the text goes as input cards, so ( and many words are safe        */
CALL QUIET 'ERASE TELLMSG CARDS A'
N = 0
DO WHILE REST <> ''
  QUEUE LEFT(REST, 80)
  REST = SUBSTR(REST, 81)
  N = N + 1
END
'EXECIO' N 'DISKW TELLMSG CARDS A (FINIS'
IF SVC = 'NJE TELL' THEN WHO = WHO NODE
'EXEC LXCALL' SVC WHO '(FILE TELLMSG CARDS A'
R = RC
CALL QUIET 'ERASE TELLMSG CARDS A'
EXIT R
QUIET: PROCEDURE
  PARSE ARG CMD
  'SET CMSTYPE HT'
  CMD
  'SET CMSTYPE RT'
  RETURN
