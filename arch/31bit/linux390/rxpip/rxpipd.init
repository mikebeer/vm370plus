#!/bin/sh
### BEGIN INIT INFO
# Provides:          rxpipd
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: RXPIP REXX package repository (VM/370plus 9.26)
### END INIT INFO
P=/opt/rxpip/rxpipd.py      # matched as "^python3 $P": this script is rxpipd too
[ -r /etc/default/rxpipd ] && . /etc/default/rxpipd
: ${RXPIPD_PORT:=8089} ${RXPIPD_HOST:=127.0.0.1} ${RXPIPD_REPO:=/var/lib/rxpip/repo}
case "$1" in
start)
  pgrep -f "^python3 $P" >/dev/null && exit 0
  echo -n "Starting RXPIP repository: rxpipd"
  (nohup python3 $P --port $RXPIPD_PORT --host $RXPIPD_HOST \
     --script /opt/rxpip/server/rxpip_server.rexx --repo $RXPIPD_REPO \
     >>/var/log/rxpipd.log 2>&1 &)
  echo "." ;;
stop) echo -n "Stopping RXPIP repository: rxpipd"; pkill -f "^python3 $P"; echo "." ;;
restart) $0 stop; sleep 1; $0 start ;;
status) pgrep -f "^python3 $P" >/dev/null && echo "rxpipd is running" || { echo "rxpipd is not running"; exit 3; } ;;
*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
