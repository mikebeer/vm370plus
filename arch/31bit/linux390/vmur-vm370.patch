+/*
+ * VM/370plus: CP has no DIAGNOSE X'210'.  Ask it instead: QUERY VIRTUAL
+ * answers "RDR  00C ...", "PUN  00D ..." or "PRT  00E ...".
+ */
+static int get_urd_class_cp(struct urdev *urd)
+{
+	char cmd[32], *resp, *p;
+	int rc, class = -EIO;
+
+	/* a small kmalloc buffer: DIAG 8 must not cross a page */
+	resp = kzalloc(128, GFP_KERNEL | GFP_DMA);
+	if (!resp)
+		return -ENOMEM;
+	/* VM/370 device addresses have three hex digits */
+	sprintf(cmd, "QUERY VIRTUAL %03X", urd->dev_id.devno);
+	cpcmd(cmd, resp, 127, &rc);
+	for (p = resp; *p == ' '; p++)
+		;
+	if (!strncmp(p, "RDR", 3))
+		class = DEV_CLASS_UR_I;
+	else if (!strncmp(p, "PUN", 3) || !strncmp(p, "PRT", 3))
+		class = DEV_CLASS_UR_O;
+	else
+		pr_warn("vmur: %s: rc %d: %.40s\n", cmd, rc, resp);
+	if (class >= 0)
+		urd->vm370 = 1;
+	kfree(resp);
+	return class;
+}
