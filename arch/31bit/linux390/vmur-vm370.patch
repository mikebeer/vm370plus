+/*
+ * VM/370: read the reader with CCW READ (X'02'), one 80-byte card per I/O,
+ * as an operating system reads a 2540 under VM.  CP ends a spool file with
+ * unit exception: that is end of file for read().  A short record is
+ * padded with blanks (X'40') to 80 bytes, so read() returns whole cards.
+ */
+/* VM/370: is there a file in our reader?  (A READ on an empty reader ends
+ * in a unit check whose automatic sense does not complete.)  QUERY FILES
+ * answers "FILES:  NO RDR, ..." or "FILES: 001 RDR, ...". */
+static int vm370_rdr_files(void)
+{
+	char *resp;
+	int rc, n = 0;
+
+	resp = kzalloc(128, GFP_KERNEL | GFP_DMA);
+	if (!resp)
+		return -ENOMEM;
+	cpcmd("QUERY FILES", resp, 127, &rc);
+	if (!strstr(resp, "NO RDR"))
+		n = 1;
+	kfree(resp);
+	return n;
+}
+
+static ssize_t ccw_read(struct urdev *urd, char __user *ubuf, size_t count,
+			loff_t offs)
+{
+	struct ccw1 *cpa;
+	char *card;
+	size_t done = 0;
+	int rc = 0, n;
+
+	/* only at the start of a file: QUERY FILES does not count the file
+	 * being read, so asking again in the middle ended it (I-280) */
+	if (offs == 0) {
+		rc = vm370_rdr_files();
+		if (rc <= 0)
+			return rc;	/* empty reader: end of file */
+	}
+	rc = 0;
+
+	cpa = kzalloc(sizeof(*cpa), GFP_KERNEL | GFP_DMA);
+	card = kmalloc(80, GFP_KERNEL | GFP_DMA);
+	if (!cpa || !card) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	while (count - done >= 80) {
+		memset(card, 0x40, 80);
+		cpa->cmd_code = 0x02;			/* READ */
+		cpa->flags = CCW_FLAG_SLI;
+		cpa->count = 80;
+		cpa->cda = (u32)(addr_t) card;
+		urd->io_request_rc = 0;
+		rc = do_ur_io(urd, cpa);
+		if (rc)
+			break;
+		rc = urd->io_request_rc;
+		n = 80 - urd->last_count;
+		if (rc == -ENODATA) {			/* end of file */
+			rc = 0;
+			if (n > 0 && n < 80 && !(urd->last_dstat & DEV_STAT_UNIT_EXCEP))
+				;
+			break;
+		}
+		/* past a file, an empty reader answers with unit check
+		 * (intervention required): that is the end, not an error */
+		if (rc == -EIO && offs + done > 0 &&
+		    (urd->last_dstat & DEV_STAT_UNIT_CHECK)) {
+			rc = 0;
+			break;
+		}
+		if (rc)
+			break;
+		if (copy_to_user(ubuf + done, card, 80)) {
+			rc = -EFAULT;
+			break;
+		}
+		done += 80;
+	}
+out:
+	kfree(card);
+	kfree(cpa);
+	return done ? done : rc;
+}
+
 static ssize_t ur_read(struct file *file, char __user *ubuf, size_t count,
 		       loff_t *offs)
 {
@@ -567,6 +690,12 @@ static ssize_t ur_read(struct file *file, char __user *ubuf, size_t count,
 		return 0;
 
 	urd = ((struct urfile *) file->private_data)->urd;
+	if (urd->vm370) {
+		rc = ccw_read(urd, ubuf, count, *offs);	/* do_ur_io locks */
+		if (rc > 0)
+			*offs += rc;
+		return rc;
+	}
 	rc = mutex_lock_interruptible(&urd->io_mutex);
 	if (rc)
 		return rc;
@@ -648,6 +777,8 @@ static int verify_device(struct urdev *urd)
 	case DEV_CLASS_UR_O:
 		return 0; /* no check needed here */
 	case DEV_CLASS_UR_I:
