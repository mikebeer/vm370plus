EFS      TITLE 'DMSEFS     (CMS)       VM/370PLUS - EDF DISKS (M6)'
*
*        DMSEFS -- IBM'S ENHANCED DISK FORMAT (EDF) FOR VM/370PLUS CMS
*
*        4096-BYTE BLOCKS, 64-BYTE FSTS, POINTER-BLOCK TREES, THE
*        DIRECTORY AND THE ALLOCATION MAP AS FILES (DOCS 62, 63; THE
*        PC-SIDE REFERENCE IS TOOLS/EDF.PY).  A NUCLEUS EXTENSION:
*        THE SYSTEM PROFILE LOADS IT (NUCXTEXT DMSEFS (SYSTEM PERM)
*        AND CALLS IT ONCE AS A COMMAND, WHICH PUTS THE ADDRESS OF
*        ITS SERVICE ENTRY IN NUCON (NUCRSV7).  THE NUCLEUS CALLS
*        THAT ENTRY WHERE A DISK OR FILE IS AN EDF ONE:
*
*          L     R15,NUCRSV7   R0 = FUNCTION, R1 = ARGUMENT,
*          BALR  R14,R15       R2 = SECOND ARGUMENT; R15 = RC, CC
*
*        FUNCTIONS
*          1 CHK    R1 = ADT, R2 = DIAG 24 WORD.  RC 255: NOT EDF.
*                   RC 0 EDF DISK SET UP; 4 READ-ONLY UNEXPECTEDLY;
*                   1 DISK ERROR; 5 NO STORAGE.
*          2 FSTS   R1 = ADT.  THE 40-BYTE FST HYPERBLOCKS.
*          3 READ   R1 = AFT (OPENED BY ACTFREE), R2 = RDBUF PLIST.
*                   RC AS RDBUF; THE BYTE COUNT IS IN THE PLIST.
*          4 CLOSE  R1 = AFT.  BUFFERS BACK.
*          5 WRITE  R1 = AFT, R2 = WRBUF PLIST.  RC AS WRBUF.
*          6 FINW   R1 = AFT, R2 = ITS FST IN THE HYPERBLOCKS: AN
*                   OUTPUT FILE IS FINISHED -- ITS POINTER TREE, ITS
*                   DIRECTORY ENTRY, THE MAP AND THE LABEL ARE WRITTEN.
*          7 SYNC   R1 = ADT (UPDISK): RENAMED FILES GET THEIR NEW
*                   NAMES IN THE DIRECTORY, ERASED ONES THEIR BLOCKS
*                   BACK; THEN DIRECTORY, MAP AND LABEL ARE WRITTEN.
*          8 FMT    R1 = PARAMETERS (FORMAT (BLKSIZE 4096).
*          9 REL    R1 = ADT.  EVERYTHING EDF OWNS FOR THE DISK BACK.
*
*        IN STORAGE A FILE'S 40-BYTE FST CARRIES THE INDEX OF ITS
*        64-BYTE DIRECTORY ENTRY IN FSTFCL (THE FIRST CHAIN LINK,
*        WHICH EDF HAS NOT GOT); THE DIRECTORY ITSELF IS KEPT WHOLE.
*        AN OPEN FILE'S EDF STATE IS IN AFTCLB (80 BYTES, THE FIRST
*        CHAIN LINK'S DIRECTORY ON AN 800-BYTE DISK).
*
         EJECT
*        THE EDF CONTROL BLOCK, ONE PER ACCESSED EDF DISK (ADTQQM)
EDFCB    DSECT
EDBS     DS    F              BLOCK SIZE (4096)
EDBPT    DS    F              BLOCKS PER TRACK
EDHDS    DS    F              TRACKS PER CYLINDER
EDDEV    DS    H              VIRTUAL DEVICE ADDRESS
EDFLG    DS    X
EDFRW    EQU   X'80'          READ-WRITE
         DS    X
EDDOP    DS    F              FIRST DIRECTORY BLOCK
EDTOT    DS    F              TOTAL BLOCKS
EDUSED   DS    F              BLOCKS IN USE
EDNDIR   DS    F              DIRECTORY ENTRIES (THE FIRST TWO TOO)
EDDIRA   DS    A              THE DIRECTORY, 64 BYTES AN ENTRY
EDDIRN   DS    F              ITS SIZE IN DOUBLEWORDS
EDMAPA   DS    A              THE ALLOCATION MAP (READ-WRITE DISKS)
EDMAPN   DS    F              ITS SIZE IN DOUBLEWORDS
EDBUF    DS    A              A 4K WORK BUFFER
EDPBNO   DS    F              BLOCK NOW IN EDBUF (0: NONE)
EDCYL    DS    F              CYLINDERS (LABEL)
EDMBL    DS    A              THE MAP'S BLOCK NUMBERS (R/W)
EDMBN    DS    F              HOW MANY
EDWBUF   DS    A              A 4K BUFFER FOR WRITING (R/W)
EDACUR   DS    F              ALLOCATION: NEXT MAP BYTE TO LOOK AT
         DS    0D
EDCBL    EQU   *-EDFCB
EDCBD    EQU   (EDCBL+7)/8
*
*        AN OPEN FILE'S EDF STATE, IN AFTCLB
EDAFT    DSECT
EAFOP    DS    F              FILE ORIGIN POINTER
EAADBC   DS    F              DATA BLOCKS
EAAIC    DS    F              RECORDS
EALVL    DS    X              POINTER LEVELS
EAPSZ    DS    X              POINTER SIZE (4 F, 12 V)
EAFLG    DS    X
EAFINI   EQU   X'80'          STATE SET UP
EAFDRT   EQU   X'40'          THE DATA BLOCK IN EADBUF IS CHANGED
EAFBL    EQU   X'20'          THE BLOCK LIST IS LOADED
EAFVE    EQU   X'10'          EAVEND IS KNOWN
         DS    X
EARP     DS    F              NEXT RECORD TO READ
EAWP     DS    F              NEXT RECORD TO WRITE
EADBUF   DS    A              DATA BLOCK BUFFER (4K)
EADBIX   DS    F              ITS INDEX IN THE FILE (-1: NONE)
EAPBUF   DS    A              POINTER BLOCK BUFFER (4K)
EAPBNO   DS    F              BLOCK NUMBER IN IT (0: NONE)
EAVPOS   DS    F              V: FILE OFFSET OF RECORD EAVREC
EAVREC   DS    F              V: ITS NUMBER
EADIRX   DS    F              DIRECTORY INDEX
EABL     DS    A              WRITING: THE DATA BLOCK LIST, 12 BYTES
*                             AN ENTRY (BLOCK, HIGHEST RECORD, DISP)
EABLN    DS    F              ITS ENTRIES
EABLC    DS    F              ITS CAPACITY
EAVEND   DS    F              V: THE END OF THE DATA (EAFVE)
         DS    CL4
EAL      EQU   *-EDAFT        (80 = L'AFTCLB)
         EJECT
DMSEFS   CSECT
         USING NUCON,R0
*
*        COMMAND ENTRY: "DMSEFS" (ANY OPERANDS) REGISTERS THE SERVICE
*        ENTRY.  CALLED BY SVC 202 FROM THE SYSTEM PROFILE.
*
         USING DMSEFS,R15
         SPKA  0              NUCON IS KEY-0 STORAGE
         L     R1,=A(EDFENT)
         ST    R1,NUCRSV7
         SR    R15,R15
         BR    R14
         DROP  R15
         LTORG
*
*        THE SERVICE ENTRY
*
EDFENT   DS    0H
         USING EDFENT,R15
         B     EDFENT2
EDSAVE   DS    16F            (HERE: WITHIN REACH OF R15)
EDFENT2  STM   R0,R14,EDSAVE
         DROP  R15
         LR    R12,R15
         USING EDFENT,R12,R11
         LA    R11,2048(,R12)
         LA    R11,2048(,R11)
         LA    R13,EDWORK
         LR    R15,R0
         CH    R15,=H'9'
         BH    BADFUNC
         SLL   R15,2
         L     R15,FUNCTAB(R15)
         BR    R15
FUNCTAB  DC    A(BADFUNC,FCHK,FFSTS,FREAD,FCLOSE,FWRITE)
         DC    A(FFINW,FSYNC,FFMT,FREL)
BADFUNC  LA    R15,99
*
*        RETURN, R15 = RC
*
RETURN   ST    R15,EDSAVE+60
*        DEBUG (DBGON NONZERO): MSG * EFS F=N RC=NNN BY DIAG 8
         CLI   DBGON,0
         BE    RETNODBG
         L     R1,EDSAVE      THE FUNCTION
         LA    R1,X'F0'(,R1)
         STC   R1,DBGFN
         L     R1,EDSAVE+60
         CVD   R1,DBGDW
         UNPK  DBGRC,DBGDW
         OI    DBGRC+2,X'F0'
         LA    R2,DBGTXT
         LA    R3,DBGTXTL
         DC    X'83230008'
RETNODBG LA    R15,EDSAVE     (R12 IS THE CALLER'S AFTER THE LM)
         LM    R0,R14,0(R15)
         L     R15,60(,R15)
         LTR   R15,R15
         BR    R14
         EJECT
***********************************************************************
*        1  CHK -- IS IT AN EDF DISK?  SET IT UP IF SO.
***********************************************************************
FCHK     LR    R9,R1          R9 = ADT
         USING ADTSECT,R9
         ST    R2,DIAG24      THE DIAG 24 WORD
         L     R7,ADTDTA      NUCON DEVICE TABLE
         LH    R1,DTAD(,R7)
         STH   R1,DEV
*        GEOMETRY FROM CP'S DEVICE TYPE (BYTE 1 OF THE DIAG 24 WORD)
         LA    R3,4           3350: 4 BLOCKS A TRACK,
         LA    R4,30          30 TRACKS A CYLINDER
         MVI   CMSTYPE,X'0B'  (CMS T3350)
         CLI   DIAG24+1,X'08'
         BE    CHK10
         LA    R3,10          3380: 10 AND 15
         LA    R4,15
         MVI   CMSTYPE,X'0E'  (CMS T3380)
         CLI   DIAG24+1,X'20'
         BE    CHK10
         LA    R15,255        ANYTHING ELSE: NOT FOR EDF
         B     RETURN
CHK10    STM   R3,R4,GEOM
*        A WORK BUFFER, THEN THE LABEL: TRACK 0 RECORD 3, ANY LENGTH
         LA    R0,512+EDCBD
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   NOSTORE
         LR    R10,R1         R10 = THE CONTROL BLOCK, THEN 4K
         USING EDFCB,R10
         XC    EDFCB(EDCBL),EDFCB
         LA    R1,EDCBL(,R10)
         ST    R1,EDBUF
         LM    R3,R4,GEOM
         ST    R3,EDBPT
         ST    R4,EDHDS
         MVC   EDDEV,DEV
         MVC   EDBS,F4096
         LA    R1,3           BLOCK 3 IS THE LABEL
         L     R2,EDBUF
         BAL   R14,RDBLK
         BNZ   CHKNOT         UNREADABLE AS EDF: NOT EDF
         L     R2,EDBUF
         CLC   0(4,R2),CMS1
         BNE   CHKNOT
         CLC   12(4,R2),F4096 4096-BYTE BLOCKS ONLY, FOR NOW
         BNE   CHKNOT
         MVC   EDDOP,16(R2)
         MVC   EDCYL,20(R2)
         MVC   EDTOT,28(R2)
         MVC   EDUSED,32(R2)
         MVC   ADTID(6),4(R2) THE LABEL
*        READ-ONLY OR READ-WRITE: AS READMFD DECIDES IT
         MVI   RCRO,0
         TM    ADTFLG3,ADTFORCE  FORCED READ-ONLY: NO MESSAGE
         BO    CHKRO
         CLI   DIAG24+3,X'80' MRW: READ-ONLY INDICATOR
         BL    CHKRW
         MVI   RCRO,4         READ-ONLY UNEXPECTEDLY: RC 4
         B     CHKRO
CHKRW    OI    EDFLG,EDFRW
CHKRO    DS    0H
*        THE DIRECTORY'S OWN FST: THE FIRST 64 BYTES OF BLOCK DOP
         L     R1,EDDOP
         L     R2,EDBUF
         BAL   R14,RDBLK
         BNZ   CHKERR
         L     R2,EDBUF
         MVC   DIRFST(64),0(R2)
         L     R1,DIRFST+48   ENTRIES (AIC)
         ST    R1,EDNDIR
*        THE WHOLE DIRECTORY: ADBC BLOCKS, ONE MORE FOR GROWTH
         L     R0,DIRFST+44
         A     R0,F1
         SLL   R0,9           4096/8 DOUBLEWORDS A BLOCK
         ST    R0,EDDIRN
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   CHKNOST
         ST    R1,EDDIRA
         LA    R6,DIRFST      READ IT THROUGH ITS OWN TREE
         SR    R5,R5          BLOCK INDEX 0..ADBC-1
CHK20    C     R5,DIRFST+44
         BNL   CHK30
         BAL   R14,BLKOF      R1 = BLOCK NUMBER OF INDEX R5
         BNZ   CHKERR
         LR    R2,R5
         SLL   R2,12
         A     R2,EDDIRA
         LTR   R1,R1
         BZ    CHK25          (A NULL BLOCK: NEVER IN A DIRECTORY)
         BAL   R14,RDBLK
         BNZ   CHKERR
CHK25    LA    R5,1(,R5)
         B     CHK20
CHK30    DS    0H
*        A READ-WRITE DISK: THE ALLOCATION MAP TOO (ENTRY 2), ITS
*        BLOCK NUMBERS, AND A BUFFER FOR WRITING
         TM    EDFLG,EDFRW
         BZ    CHK40
         L     R6,EDDIRA
         LA    R6,64(,R6)     THE ALLOCMAP FST
         L     R0,44(,R6)     ITS BLOCKS
         SLL   R0,9
         ST    R0,EDMAPN
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   CHKNOST
         ST    R1,EDMAPA
         L     R0,44(,R6)
         ST    R0,EDMBN
         AH    R0,=H'2'      (DOUBLEWORDS: HALF THE COUNT, ROUNDED)
         SRL   R0,1
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   CHKNOST
         ST    R1,EDMBL
         LA    R0,512
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   CHKNOST
         ST    R1,EDWBUF
         SR    R5,R5
CHK35    C     R5,44(,R6)
         BNL   CHK40
         BAL   R14,BLKOF
         BNZ   CHKERR
         LR    R2,R5
         SLL   R2,2
         A     R2,EDMBL
         ST    R1,0(,R2)      THE MAP'S BLOCK NUMBER
         LR    R2,R5
         SLL   R2,12
         A     R2,EDMAPA
         BAL   R14,RDBLK
         BNZ   CHKERR
         LA    R5,1(,R5)
         B     CHK35
*        THE ADT, AS READMFD LEAVES IT
CHK40    ST    R10,ADTQQM     THE EDF CONTROL BLOCK
         OI    ADTFLG3,X'02'  ADTFEDF: AN EDF DISK
         MVC   ADTNUM,EDTOT
         MVC   ADTUSED,EDUSED
         L     R1,EDTOT
         S     R1,EDUSED
         ST    R1,ADTLEFT
         MVC   ADTCYL,EDCYL
         XC    ADT1ST,ADT1ST
         XC    ADTLAST,ADTLAST
         MVI   ADTFLG2,ADTFMFD
         L     R7,ADTDTA
         MVC   DTADT(1,R7),CMSTYPE
         SR    R15,R15
         TM    EDFLG,EDFRW
         BZ    CHK45
         OI    ADTFLG1,ADTFRW
         B     RETURN
CHK45    IC    R15,RCRO       0, OR 4 AS READMFD SAYS IT
CHK46    OI    ADTFLG1,ADTFRO
         B     RETURN
*
CHKNOT   LA    R0,512+EDCBD   NOT EDF: GIVE IT ALL BACK
         LR    R1,R10
         DMSFRET DWORDS=(0),LOC=(1)
         LA    R15,255
         B     RETURN
CHKNOST  LA    R15,5
         B     CHKFAIL
CHKERR   LA    R15,1
CHKFAIL  ST    R15,RCSAVE
         BAL   R14,FREECB
         L     R15,RCSAVE
         B     RETURN
NOSTORE  LA    R15,5
         B     RETURN
         DROP  R9
         EJECT
***********************************************************************
*        2  FSTS -- THE 40-BYTE FST HYPERBLOCKS FOR ALL FILES
***********************************************************************
FFSTS    LR    R9,R1
         USING ADTSECT,R9
         L     R10,ADTQQM
         SR    R8,R8          HYPERBLOCK COUNT
         SR    R7,R7          FILES
         L     R3,ADTFDA      THE FIRST HYPERBLOCK, IF ANY
         LTR   R3,R3
         BNZ   FST05
         LA    R0,102
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   NOSTORE
         LR    R3,R1
         MVC   0(8,R3),F40800  ITEM SIZE 40, BLOCK 800
         ST    R3,ADTFDA
         OI    ADTFLG1,ADTFFSTF
FST05    LA    R3,8(,R3)      THE ENTRIES
         ST    R3,HBSTART
         BAL   R14,CLR808
         LA    R8,1(,R8)
         ST    R3,ADTCHBA
         ST    R3,ADTCFST
         LA    R4,20          SLOTS LEFT IN THIS HYPERBLOCK
         LA    R5,2           DIRECTORY INDEX: FILES FROM 2 ON
FST10    C     R5,EDNDIR
         BNL   FST50
         LR    R6,R5
         SLL   R6,6
         A     R6,EDDIRA      R6 = THE 64-BYTE ENTRY
         OC    0(8,R6),0(R6)  AN EMPTY SLOT?
         BZ    FST40
         LTR   R4,R4          ROOM IN THIS HYPERBLOCK?
         BNZ   FST20
         LA    R0,101
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BNZ   NOSTORE
         L     R2,HBSTART     THE OLD ONE'S ENTRIES
         ST    R1,FSTFWDP(,R2)   FORWARD FROM THE OLD ONE
         LR    R3,R1
         BAL   R14,CLR808
         ST    R2,FSTBKWD(,R3)   BACK FROM THE NEW ONE
         ST    R3,HBSTART
         ST    R3,ADTCHBA
         LA    R8,1(,R8)
         LA    R4,20
FST20    BAL   R14,MAKE40     ENTRY R6 -> 40-BYTE FST AT R3
         LM    R0,R1,FSTT-FSTSECT(R3)
         L     R13,AFVS       (TYPSRCH WANTS THE FVS IN R13)
         L     R15,ATYPSRCH   OFTEN-USED FILETYPE BITS, AS READFST
         BALR  R14,R15
         LA    R13,EDWORK
         O     R15,ADTFTYP-3
         ST    R15,ADTFTYP-3
         ST    R3,ADTCFST     THE LAST ONE FILLED
         LA    R3,40(,R3)
         BCTR  R4,0
         LA    R7,1(,R7)
FST40    LA    R5,1(,R5)
         B     FST10
FST50    ST    R8,ADTHBCT
         ST    R7,ADTFSTC
         LM    R1,R2,ADTCHBA
         SR    R2,R1
         STM   R1,R2,ADTLHBA
         LA    R1,1
         STH   R1,ADTRES
         MVI   ADTFLG2,ADTFALUF  THE WHOLE DIRECTORY IS IN STORAGE
         SR    R15,R15
         B     RETURN
*
*        MAKE40: DIRECTORY ENTRY R6 (INDEX R5) -> 40-BYTE FST AT R3
MAKE40   MVC   0(40,R3),0(R6)
         USING FSTSECT,R3
         L     R1,48(,R6)     RECORDS (AIC) -> FSTIC, CAPPED
         C     R1,F65535
         BNH   *+8
         L     R1,F65535
         STH   R1,FSTIC
         LA    R1,1(,R1)      WP = RECORDS + 1, CAPPED
         C     R1,F65535
         BNH   *+8
         L     R1,F65535
         STH   R1,FSTWP
         MVC   FSTRP,H1
         STH   R5,FSTFCL      THE DIRECTORY INDEX
         L     R1,44(,R6)     DATA BLOCKS -> FSTDBC, CAPPED
         C     R1,F65535
         BNH   *+8
         L     R1,F65535
         STH   R1,FSTDBC
         MVI   FSTFB,0
         DROP  R3
         BR    R14
*
CLR808   XC    0(200,R3),0(R3)
         XC    200(200,R3),200(R3)
         XC    400(200,R3),400(R3)
         XC    600(208,R3),600(R3)
         BR    R14
         DROP  R9
         EJECT
***********************************************************************
*        3  READ -- RDBUF FOR AN EDF FILE
***********************************************************************
FREAD    LR    R8,R1          R8 = AFT
         USING AFTSECT,R8
         LR    R7,R2          R7 = RDBUF PLIST
         L     R9,AFTADT
         USING ADTSECT,R9
         L     R10,ADTQQM
         LA    R6,AFTCLB
         USING EDAFT,R6
         TM    EAFLG,EAFINI
         BO    RD10
         BAL   R14,OPENST     FIRST USE: STATE FROM THE DIRECTORY
         BNZ   RETURN
RD10     OI    AFTFLG,AFTRD
         XC    40(4,R7),40(R7)  BYTES READ: NONE YET
         SR    R4,R4
         ICM   R4,3,26(R7)    THE ITEM NUMBER
         BZ    RD14
         L     R1,EARP        MODULO 65536, NEAR THE READ POINTER
         BAL   R14,ITEMMOD
         B     RD15
RD14     L     R4,EARP        0: THE NEXT ONE
RD15     C     R4,EAAIC       PAST THE END?
         BNH   RD20
RDEOF    LA    R15,12
         B     RETURN
RD20     SR    R5,R5
         ICM   R5,3,38(R7)    HOW MANY ITEMS
         BNZ   RD22
         LA    R15,5
         B     RETURN
RD22     CLI   AFTFV,C'V'
         BE    RDV
         CLI   AFTFV,C'F'
         BE    RDF
         LA    R15,7
         B     RETURN
*
*        F: N ITEMS FROM ITEM R4, AS FAR AS THE FILE GOES
RDF      L     R1,EAAIC
         SR    R1,R4
         LA    R1,1(,R1)      ITEMS LEFT
         CR    R5,R1
         BNH   *+6
         LR    R5,R1
         LR    R1,R4
         BCTR  R1,0
         M     R0,AFTIL       R1 = FILE OFFSET
         LR    R3,R5
         M     R2,AFTIL       R3 = BYTES WANTED
         SR    R15,R15
         C     R3,32(,R7)     MORE THAN THE BUFFER?
         BNH   RDF10
         L     R3,32(,R7)
         LA    R15,8          ERROR 8: TRUNCATED (NONFATAL)
RDF10    ST    R15,RCSAVE
         ST    R3,40(,R7)     BYTES READ
         L     R2,28(,R7)
         LA    R2,0(,R2)      THE USER'S BUFFER
         BAL   R14,STREAD     R1 OFFSET, R2 TARGET, R3 LENGTH
         BNZ   RDERR
         AR    R4,R5          THE NEXT ITEM
         ST    R4,EARP
         STH   R4,AFTRP
         STH   R4,AFTIN
         MVI   37(R7),FSTITAV
         L     R15,RCSAVE
         B     RETURN
*
*        V: ONE ITEM, FOUND BY WALKING THE LENGTH FIELDS
RDV      C     R5,F1
         BE    RDV05
         LA    R15,11
         B     RETURN
RDV05    L     R1,EAVPOS      FROM THE REMEMBERED PLACE IF IT IS
         L     R2,EAVREC      NOT PAST THE ITEM WANTED,
         CR    R2,R4
         BNH   RDV10
         SR    R1,R1          ELSE FROM THE START
         LA    R2,1
RDV10    CR    R2,R4
         BE    RDV20
         ST    R2,RCSAVE      SKIP ONE RECORD
         LA    R2,HALF
         LA    R3,2
         ST    R1,OFFSAVE
         BAL   R14,STREAD
         BNZ   RDERR
         L     R1,OFFSAVE
         LH    R3,HALF
         N     R3,F65535
         LTR   R3,R3
         BZ    RDEOF          A ZERO LENGTH: THE END
         LA    R1,2(R3,R1)
         L     R2,RCSAVE
         LA    R2,1(,R2)
         B     RDV10
RDV20    ST    R1,OFFSAVE     THE ITEM: ITS LENGTH,
         LA    R2,HALF
         LA    R3,2
         BAL   R14,STREAD
         BNZ   RDERR
         LH    R3,HALF
         N     R3,F65535
         LTR   R3,R3
         BZ    RDEOF
         ST    R3,LENSAVE
         SR    R15,R15
         C     R3,32(,R7)
         BNH   RDV25
         L     R3,32(,R7)
         LA    R15,8
RDV25    ST    R15,RCSAVE
         ST    R3,40(,R7)
         L     R1,OFFSAVE     THEN THE DATA
         LA    R1,2(,R1)
         L     R2,28(,R7)
         LA    R2,0(,R2)
         BAL   R14,STREAD
         BNZ   RDERR
         L     R1,OFFSAVE     THE NEXT ITEM STARTS AFTER IT
         LA    R1,2(,R1)
         A     R1,LENSAVE
         ST    R1,EAVPOS
         LA    R4,1(,R4)
         ST    R4,EAVREC
         ST    R4,EARP
         STH   R4,AFTRP
         STH   R4,AFTIN
         MVI   37(R7),FSTITAV
         L     R15,RCSAVE
         B     RETURN
RDERR    LA    R15,3          PERMANENT DISK ERROR
         B     RETURN
*
*        OPENST: AN OPEN FILE'S STATE FROM ITS DIRECTORY ENTRY
OPENST   ST    R14,OPENR14
         XC    EDAFT(EAL),EDAFT
         SR    R1,R1
         ICM   R1,3,AFTFCL    THE DIRECTORY INDEX
         ST    R1,EADIRX
         SLL   R1,6
         A     R1,EDDIRA
         MVC   EAFOP(12),40(R1)   FOP, ADBC, AIC
         MVC   EALVL(2),52(R1)    LEVELS, POINTER SIZE
         LA    R1,1
         ST    R1,EARP
         ST    R1,EAVREC
         L     R1,EAAIC
         LA    R1,1(,R1)
         ST    R1,EAWP
         L     R1,F1
         LNR   R1,R1
         ST    R1,EADBIX
         LA    R0,1024        TWO 4K BUFFERS
         DMSFREE DWORDS=(0),TYPE=NUCLEUS
         LTR   R15,R15
         BZ    OPEN10
         LA    R15,25
         L     R14,OPENR14
         LTR   R15,R15
         BR    R14
OPEN10   ST    R1,EADBUF
         LA    R1,2048(,R1)
         LA    R1,2048(,R1)
         ST    R1,EAPBUF
         OI    EAFLG,EAFINI
         SR    R15,R15
         L     R14,OPENR14
         BR    R14
         EJECT
*
*        STREAD: R3 BYTES FROM FILE OFFSET R1 TO R2 (R6 = THE FILE)
*
STREAD   ST    R14,STRR14
         STM   R4,R9,STRSAVE
STR10    LTR   R3,R3
         BNP   STRDONE
         LR    R15,R1
         SRL   R15,12         BLOCK INDEX
         LR    R0,R1
         N     R0,F4095       OFFSET IN THE BLOCK
         C     R15,EADBIX     IN THE BUFFER?
         BE    STR20
         STM   R1,R3,STRREGS
         LR    R5,R15
         ST    R5,EADBIX
         BAL   R14,FBLKOF     R1 = ITS BLOCK NUMBER (R6 = EDAFT)
         BNZ   STRERR
         L     R2,EADBUF
         LTR   R1,R1
         BNZ   STR15
         LR    R0,R2          A NULL BLOCK: ZEROS
         L     R1,F4096
         SR    R15,R15
         MVCL  R0,R14
         B     STR18
STR15    BAL   R14,RDBLK
         BNZ   STRERR
STR18    LM    R1,R3,STRREGS
         LR    R0,R1
         N     R0,F4095
STR20    L     R15,F4096      BYTES LEFT IN THE BLOCK
         SR    R15,R0
         CR    R15,R3
         BNH   *+6
         LR    R15,R3         THE CHUNK
         STM   R1,R3,STRREGS
         L     R14,EADBUF
         AR    R14,R0         SOURCE
         LR    R0,R2          TARGET
         LR    R1,R15
         ST    R15,STRCHUNK
         LR    R15,R1
         MVCL  R0,R14
         LM    R1,R3,STRREGS
         A     R1,STRCHUNK
         A     R2,STRCHUNK
         S     R3,STRCHUNK
         B     STR10
STRDONE  SR    R15,R15
         LM    R4,R9,STRSAVE
         L     R14,STRR14
         BR    R14
STRERR   L     R14,F1
         LNR   R14,R14
         ST    R14,EADBIX     NOTHING VALID IN THE BUFFER
         LM    R4,R9,STRSAVE
         LA    R15,3
         L     R14,STRR14
         LTR   R15,R15
         BR    R14
         DROP  R6,R8,R9
         EJECT
***********************************************************************
*        4  CLOSE -- AN EDF FILE'S BUFFERS BACK
***********************************************************************
FCLOSE   LR    R8,R1
         USING AFTSECT,R8
         LA    R6,AFTCLB
         USING EDAFT,R6
         TM    EAFLG,EAFINI
         BZ    CLOSE9
         BAL   R14,FREEBL
         L     R1,EADBUF
         LTR   R1,R1
         BZ    CLOSE9
         LA    R0,1024
         DMSFRET DWORDS=(0),LOC=(1)
CLOSE9   XC    EDAFT(EAL),EDAFT
         SR    R15,R15
         B     RETURN
         DROP  R6,R8
***********************************************************************
*        9  REL -- THE DISK IS RELEASED
***********************************************************************
FREL     LR    R9,R1
         USING ADTSECT,R9
         L     R10,ADTQQM
         LTR   R10,R10
         BZ    REL9
         BAL   R14,FREECB
         XC    ADTQQM,ADTQQM
         XC    ADTMSK,ADTMSK
REL9     SR    R15,R15
         B     RETURN
         DROP  R9
*
*        FREECB: THE DIRECTORY, THE MAP AND THE CONTROL BLOCK (R10)
FREECB   ST    R14,FREER14
         L     R1,EDDIRA
         LTR   R1,R1
         BZ    FREE10
         L     R0,EDDIRN
         DMSFRET DWORDS=(0),LOC=(1)
FREE10   L     R1,EDMAPA
         LTR   R1,R1
         BZ    FREE20
         L     R0,EDMAPN
         DMSFRET DWORDS=(0),LOC=(1)
FREE20   L     R1,EDMBL
         LTR   R1,R1
         BZ    FREE30
         L     R0,EDMBN
         AH    R0,=H'2'
         SRL   R0,1
         DMSFRET DWORDS=(0),LOC=(1)
FREE30   L     R1,EDWBUF
         LTR   R1,R1
         BZ    FREE40
         LA    R0,512
         DMSFRET DWORDS=(0),LOC=(1)
FREE40   LA    R0,512+EDCBD
         LR    R1,R10
         DMSFRET DWORDS=(0),LOC=(1)
         L     R14,FREER14
         BR    R14
         EJECT
***********************************************************************
*        5  WRITE -- WRBUF FOR AN EDF FILE.  R1 = AFT, R2 = PLIST.
*        F FILES: ANY ITEM; V FILES: APPENDED.  THE DATA GOES INTO
*        BLOCKS OF THE FILE'S BLOCK LIST; THE POINTER TREE IS BUILT
*        WHEN THE FILE IS FINISHED (FUNCTION 6).
***********************************************************************
FWRITE   LR    R8,R1
         USING AFTSECT,R8
         LR    R7,R2          R7 = WRBUF PLIST
         L     R9,AFTADT
         USING ADTSECT,R9
         L     R10,ADTQQM
         LA    R6,AFTCLB
         USING EDAFT,R6
         LA    R15,12         (A READ-ONLY DISK)
         TM    EDFLG,EDFRW
         BZ    RETURN
         TM    EAFLG,EAFINI
         BO    WR04
         SR    R1,R1
         ICM   R1,3,AFTFCL    A DIRECTORY ENTRY YET?
         BNZ   WR03
         BAL   R14,NEWENT     NO: A NEW FILE
         BNZ   RETURN
WR03     BAL   R14,OPENST
         BNZ   RETURN
WR04     TM    EAFLG,EAFBL
         BO    WR06
         BAL   R14,LOADBL     THE BLOCK LIST
         BNZ   RETURN
WR06     TM    AFTFLG,AFTWRT  THE FIRST WRITE: AN ACTIVE WRITE NOW
         BO    WR08
         OI    AFTFLG,AFTWRT
         LH    R1,ADTNACW
         LA    R1,1(,R1)
         STH   R1,ADTNACW
WR08     SR    R4,R4
         ICM   R4,3,26(R7)    THE ITEM NUMBER
         BZ    WR09
         L     R1,EAWP        A HALFWORD: MODULO 65536, NEAR THE
         BAL   R14,ITEMMOD    WRITE POINTER
         B     WR10
WR09     L     R4,EAWP        0: THE NEXT ONE
WR10     CLI   AFTFV,C'V'
         BE    WRV
*        F: N ITEMS OF AFTIL BYTES AT (ITEM-1) * AFTIL
         SR    R5,R5
         ICM   R5,3,38(R7)    HOW MANY ITEMS
         BNZ   *+8
         LA    R5,1
         L     R3,AFTIL
         LR    R1,R4
         BCTR  R1,0
         MR    R0,R3          R1 = THE FILE OFFSET
         LR    R15,R5
         MR    R14,R3         R15 = THE BYTES
         LR    R3,R15
         L     R2,28(,R7)
         LA    R2,0(,R2)
         BAL   R14,STWRITE
         BNZ   RETURN
         AR    R4,R5          THE NEXT ITEM
         ST    R4,EAWP
         BCTR  R4,0
         C     R4,EAAIC
         BNH   WRDONE
         ST    R4,EAAIC
         B     WRDONE
*        V: ONE RECORD, AT THE END
WRV      L     R1,EAAIC
         LA    R1,1(,R1)
         CR    R4,R1
         BE    WRV05
         LA    R15,7          (ONLY APPENDING, FOR NOW)
         B     RETURN
WRV05    TM    EAFLG,EAFVE
         BO    WRV10
         BAL   R14,VEND       THE END OF AN EXISTING FILE'S DATA
         BNZ   RETURN
WRV10    L     R3,32(,R7)     THE RECORD'S LENGTH
         ST    R3,LENSAVE
         STH   R3,HALF
         L     R1,EAVEND
         ST    R1,VSTART
         LA    R2,HALF        ITS LENGTH FIELD
         LA    R3,2
         BAL   R14,STWRITE
         BNZ   RETURN
         L     R1,VSTART      THEN THE DATA
         LA    R1,2(,R1)
         L     R2,28(,R7)
         LA    R2,0(,R2)
         L     R3,LENSAVE
         BAL   R14,STWRITE
         BNZ   RETURN
         L     R1,VSTART      R1 = START, R2 = END
         L     R2,LENSAVE
         LA    R2,2(R2,R1)
         ST    R2,EAVEND
         L     R3,EAAIC
         LA    R3,1(,R3)
         ST    R3,EAAIC       R3 = THE RECORD'S NUMBER
         BAL   R14,VINFO
         LA    R3,1(,R3)
         ST    R3,EAWP
         L     R1,LENSAVE
         C     R1,AFTIL       THE LONGEST YET?
         BNH   WRDONE
         ST    R1,AFTIL
*        THE AFT'S HALFWORD COUNTS, CAPPED
WRDONE   L     R1,EAAIC
         BAL   R14,CAP
         STH   R1,AFTIC
         L     R1,EAWP
         BAL   R14,CAP
         STH   R1,AFTWP
         STH   R1,AFTIN
         L     R1,EABLN
         BAL   R14,CAP
         STH   R1,AFTDBC
         SR    R15,R15
         B     RETURN
*
*        ITEMMOD: R4 = THE ITEM NUMBER CONGRUENT TO R4 MODULO 65536
*        THAT IS NEAREST TO R1 (A POINTER): PLISTS HOLD HALFWORDS
ITEMMOD  LR    R0,R4
         SR    R0,R1
         N     R0,F65535
         C     R0,F32768
         BL    *+8
         S     R0,F65536
         AR    R0,R1
         LTR   R0,R0
         BNPR  R14            (NONSENSE: KEEP IT AS GIVEN)
         LR    R4,R0
         BR    R14
*
CAP      C     R1,F65535      R1 = MIN(R1, 65535)
         BNHR  R14
         L     R1,F65535
         BR    R14
*
*        VINFO: V RECORD R3 FROM OFFSET R1 TO R2 -- THE BLOCK LIST'S
*        HIGHEST-RECORD AND DISPLACEMENT FIELDS OF THE BLOCKS IT IS IN
VINFO    STM   R1,R5,ALCREGS
         LR    R4,R1
         SRL   R4,12          THE FIRST BLOCK: A RECORD STARTS HERE
         LR    R5,R4
         MH    R5,H12
         A     R5,EABL
         ST    R3,4(,R5)
VI10     LA    R4,1(,R4)      THE BLOCKS AFTER IT THAT IT REACHES
         LR    R5,R4
         SLL   R5,12          THE BLOCK'S START
         CR    R5,R2
         BNL   VI90
         LR    R15,R4
         MH    R15,H12
         A     R15,EABL
         ST    R3,4(,R15)
         LR    R0,R2
         SR    R0,R5          THE RECORD'S END IN THIS BLOCK
         C     R0,F4096
         BNH   *+8
         L     R0,FM1         ... OR NOT IN IT: X'FFFFFFFF'
         ST    R0,8(,R15)
         B     VI10
VI90     LM    R1,R5,ALCREGS
         BR    R14
*
*        VEND: EAVEND, THE END OF AN EXISTING V FILE'S DATA
VEND     ST    R14,VER14
         SR    R1,R1          OFFSET
         SR    R4,R4          RECORDS PASSED
VE10     C     R4,EAAIC
         BNL   VE90
         ST    R1,OFFSAVE
         LA    R2,HALF
         LA    R3,2
         BAL   R14,STREAD
         BNZ   VEERR
         L     R1,OFFSAVE
         LH    R3,HALF
         N     R3,F65535
         LA    R1,2(R3,R1)
         LA    R4,1(,R4)
         B     VE10
VE90     ST    R1,EAVEND
         OI    EAFLG,EAFVE
         SR    R15,R15
         L     R14,VER14
         BR    R14
VEERR    LA    R15,3
         L     R14,VER14
         LTR   R15,R15
         BR    R14
*
*        NEWENT: A DIRECTORY ENTRY FOR THE NEW FILE OF AFT R8: A FREE
*        SLOT OR ONE MORE AT THE END.  AFTFCL = ITS INDEX.  IT IS
*        MARKED PENDING (BYTE 63) UNTIL THE FILE IS FINISHED.
NEWENT   ST    R14,NER14
         LA    R5,2
NE10     C     R5,EDNDIR
         BNL   NE20
         LR    R1,R5
         SLL   R1,6
         A     R1,EDDIRA
         OC    0(8,R1),0(R1)
         BZ    NE30
         LA    R5,1(,R5)
         B     NE10
NE20     LA    R1,1(,R5)      ONE MORE: ROOM FOR IT?
         SLL   R1,6
         L     R0,EDDIRN
         SLL   R0,3
         CR    R1,R0
         BNH   NE25
         BAL   R14,DIRGROW
         BNZ   NE90
NE25     LA    R1,1(,R5)
         ST    R1,EDNDIR
         LR    R1,R5
         SLL   R1,6
         A     R1,EDDIRA
NE30     XC    0(64,R1),0(R1)
         MVC   0(40,R1),AFTFST
         MVI   53(R1),4       POINTER SIZE: 4 F, 12 V
         CLI   AFTFV,C'V'
         BNE   *+8
         MVI   53(R1),12
         MVI   63(R1),X'01'   PENDING
         STH   R5,AFTFCL
         SR    R15,R15
NE90     L     R14,NER14
         LTR   R15,R15
         BR    R14
*
*        DIRGROW: THE DIRECTORY BUFFER ONE BLOCK LARGER
DIRGROW  ST    R14,LBR14
         L     R0,EDDIRN
         AH    R0,=H'512'
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=DGERR
         LR    R2,R1          NEW
         LR    R0,R1
         L     R1,EDDIRN
         SLL   R1,3
         L     R14,EDDIRA     OLD
         LR    R15,R1
         MVCL  R0,R14         COPY,
         SR    R14,R14
         L     R1,F4096
         SR    R15,R15
         MVCL  R0,R14         AND ZEROS AFTER IT
         L     R1,EDDIRA
         L     R0,EDDIRN
         DMSFRET DWORDS=(0),LOC=(1)
         ST    R2,EDDIRA
         L     R0,EDDIRN
         AH    R0,=H'512'
         ST    R0,EDDIRN
         SR    R15,R15
         L     R14,LBR14
         BR    R14
DGERR    LA    R15,25         NO STORAGE
         L     R14,LBR14
         LTR   R15,R15
         BR    R14
*
*        LOADBL: THE BLOCK LIST OF THE OPEN FILE (R6), FROM ITS TREE.
*        THE TREE'S POINTER BLOCKS ARE FREED AS THEY ARE READ (A NEW
*        TREE IS BUILT WHEN THE FILE IS FINISHED).
LOADBL   ST    R14,LBR14
         L     R0,EAADBC
         AH    R0,=H'256'    ROOM FOR GROWTH
         ST    R0,EABLC
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=LBNOST
         ST    R1,EABL
         SR    R5,R5
         ST    R5,EABLN
         MVI   FREEFLG,1
LB10     C     R5,EAADBC
         BNL   LB90
         LR    R4,R5
         MH    R4,H12
         A     R4,EABL
         XC    0(12,R4),0(R4)
         CLI   EALVL,0
         BNE   LB20
         L     R1,EAFOP       LEVEL 0: ONE BLOCK
         ST    R1,0(,R4)
         MVC   4(4,R4),EAAIC
         B     LB30
LB20     BAL   R14,FBLKOF
         BNZ   LBERR
         ST    R1,0(,R4)
         CLI   EAPSZ,12
         BNE   LB30
         L     R1,LASTENT     V: HIGHEST RECORD AND DISPLACEMENT
         MVC   4(8,R4),4(R1)
LB30     LA    R5,1(,R5)
         B     LB10
LB90     MVI   FREEFLG,0
         ST    R5,EABLN
         XC    EAPBNO,EAPBNO  (THE TREE IS GONE)
         OI    EAFLG,EAFBL
         SR    R15,R15
         L     R14,LBR14
         BR    R14
LBERR    MVI   FREEFLG,0
         LA    R15,3
         L     R14,LBR14
         LTR   R15,R15
         BR    R14
LBNOST   LA    R15,25
         L     R14,LBR14
         LTR   R15,R15
         BR    R14
*
*        FREEBL: THE BLOCK LIST'S STORAGE BACK
FREEBL   L     R1,EABL
         LTR   R1,R1
         BZR   R14
         ST    R14,LBR14
         L     R0,EABLC
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFRET DWORDS=(0),LOC=(1)
         XC    EABL,EABL
         NI    EAFLG,255-EAFBL
         L     R14,LBR14
         BR    R14
*
*        STWRITE: R3 BYTES FROM R2 TO FILE OFFSET R1 (R6 = THE FILE).
*        BLOCKS PAST THE END ARE ALLOCATED.  RC 13 DISK FULL, 3 I/O.
STWRITE  ST    R14,STWR14
         STM   R4,R9,STRSAVE
STW10    LTR   R3,R3
         BNP   STWDONE
         LR    R5,R1
         SRL   R5,12          BLOCK INDEX
         C     R5,EADBIX
         BE    STW30
         STM   R0,R3,STWREGS
         BAL   R14,FLUSH      THE OLD BLOCK OUT
         BNZ   STWERR
STW12    C     R5,EABLN       PAST THE END?
         BL    STW20
         L     R0,EABLN       ONE MORE ENTRY
         C     R0,EABLC
         BL    STW14
         BAL   R14,GROWBL
         BNZ   STWERR
STW14    L     R4,EABLN
         MH    R4,H12
         A     R4,EABL
         XC    0(12,R4),0(R4) (A NULL BLOCK, UNLESS IT IS OURS)
         L     R1,EABLN
         LA    R1,1(,R1)
         ST    R1,EABLN
         B     STW12
STW20    LR    R4,R5          THE ENTRY
         MH    R4,H12
         A     R4,EABL
         L     R1,0(,R4)
         LTR   R1,R1
         BNZ   STW25
         BAL   R14,ALLOC1     A NULL BLOCK GETS A BLOCK NOW
         BNZ   STWERR
         ST    R1,0(,R4)
         L     R0,EADBUF      ZEROS
         L     R1,F4096
         SR    R14,R14
         SR    R15,R15
         MVCL  R0,R14
         B     STW28
STW25    L     R2,EADBUF      AN EXISTING BLOCK: READ IT
         BAL   R14,RDBLK
         BNZ   STWIOE
STW28    ST    R5,EADBIX
         LM    R0,R3,STWREGS
STW30    LR    R0,R1
         N     R0,F4095       OFFSET IN THE BLOCK
         L     R15,F4096
         SR    R15,R0
         CR    R15,R3
         BNH   *+6
         LR    R15,R3         THE CHUNK
         ST    R15,STRCHUNK
         STM   R1,R3,STWREGS
         L     R14,EADBUF
         AR    R0,R14         TARGET
         LR    R14,R2         SOURCE
         LR    R1,R15
         MVCL  R0,R14
         OI    EAFLG,EAFDRT
         LM    R1,R3,STWREGS
         A     R1,STRCHUNK
         A     R2,STRCHUNK
         S     R3,STRCHUNK
         B     STW10
STWDONE  SR    R15,R15
         LM    R4,R9,STRSAVE
         L     R14,STWR14
         BR    R14
STWIOE   LA    R15,3
STWERR   L     R14,F1
         LNR   R14,R14
         ST    R14,EADBIX
         LM    R4,R9,STRSAVE
         L     R14,STWR14
         LTR   R15,R15
         BR    R14
*
*        GROWBL: THE BLOCK LIST TWICE AS LARGE
GROWBL   STM   R14,R5,ALCREGS
         L     R0,EABLC
         SLL   R0,1
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=GBERR
         LR    R4,R1          NEW
         LR    R0,R1
         L     R1,EABLN
         MH    R1,H12
         L     R14,EABL
         LR    R15,R1
         MVCL  R0,R14
         L     R1,EABL
         L     R0,EABLC
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFRET DWORDS=(0),LOC=(1)
         ST    R4,EABL
         L     R0,EABLC
         SLL   R0,1
         ST    R0,EABLC
         LM    R14,R5,ALCREGS
         SR    R15,R15
         BR    R14
GBERR    LM    R14,R5,ALCREGS
         LA    R15,25
         LTR   R15,R15
         BR    R14
*
*        FLUSH: THE DATA BLOCK IN EADBUF TO DISK IF IT WAS CHANGED
FLUSH    TM    EAFLG,EAFDRT
         BZR   R14            (CC 0)
         ST    R14,FLR14
         STM   R1,R2,ALCREGS
         L     R1,EADBIX
         MH    R1,H12
         A     R1,EABL
         L     R1,0(,R1)
         L     R2,EADBUF
         BAL   R14,WRBLK
         LM    R1,R2,ALCREGS
         L     R14,FLR14
         BNZ   FLERR
         NI    EAFLG,255-EAFDRT
         SR    R15,R15
         BR    R14
FLERR    LA    R15,3
         LTR   R15,R15
         BR    R14
*
*        ALLOC1: R1 = A FREE BLOCK, NOW IN USE.  RC 13: DISK FULL.
ALLOC1   STM   R2,R7,ALCREGS
         L     R2,EDMAPA
         L     R4,EDTOT
         LA    R4,7(,R4)
         SRL   R4,3           MAP BYTES
         L     R3,EDACUR
         LR    R5,R4          BYTES TO LOOK AT
AL10     CR    R3,R4
         BL    *+6
         SR    R3,R3          (WRAP)
         LA    R1,0(R3,R2)
         CLI   0(R1),X'FF'
         BNE   AL20
AL15     LA    R3,1(,R3)
         BCT   R5,AL10
         LA    R15,13         FULL
         LM    R2,R7,ALCREGS
         LTR   R15,R15
         BR    R14
AL20     SR    R0,R0
         IC    R0,0(,R1)
         LA    R6,X'80'
         SR    R7,R7          BIT NUMBER
AL25     LR    R15,R0
         NR    R15,R6
         BZ    AL30
         SRL   R6,1
         LA    R7,1(,R7)
         C     R7,F8
         BL    AL25
         B     AL15
AL30     LR    R15,R3         BLOCK = BYTE * 8 + BIT + 1
         SLL   R15,3
         LA    R15,1(R7,R15)
         C     R15,EDTOT
         BH    AL15           (PAST THE END OF THE DISK)
         OR    R0,R6
         STC   R0,0(,R1)
         ST    R3,EDACUR
         LR    R1,R15
         L     R15,EDUSED
         LA    R15,1(,R15)
         ST    R15,EDUSED
         SR    R15,R15
         LM    R2,R7,ALCREGS
         BR    R14
*
*        FREE1: BLOCK R1 FREE (IF IT IS IN USE).  ALL BUT R15 KEPT.
FREE1    STM   R0,R5,ALCREGS
         LTR   R1,R1
         BZ    FR90
         LR    R2,R1
         BCTR  R2,0
         LR    R3,R2
         SRL   R3,3           BYTE
         N     R2,F7          BIT
         LA    R4,X'80'
         SRL   R4,0(R2)
         A     R3,EDMAPA
         SR    R0,R0
         IC    R0,0(,R3)
         LR    R5,R0
         NR    R5,R4
         BZ    FR90           NOT IN USE
         XR    R0,R4
         STC   R0,0(,R3)
         L     R5,EDUSED
         BCTR  R5,0
         ST    R5,EDUSED
FR90     LM    R0,R5,ALCREGS
         BR    R14
         DROP  R6,R8,R9
         EJECT
***********************************************************************
*        6  FINW -- AN OUTPUT FILE IS FINISHED.  R1 = AFT, R2 = ITS
*        40-BYTE FST IN THE HYPERBLOCKS (FINIS HAS FILLED IT IN).
***********************************************************************
FFINW    LR    R8,R1
         USING AFTSECT,R8
         LR    R7,R2          R7 = THE FST
         L     R9,AFTADT
         USING ADTSECT,R9
         L     R10,ADTQQM
         LA    R6,AFTCLB
         USING EDAFT,R6
         TM    EAFLG,EAFBL    ANYTHING WRITTEN?
         BZ    FW90
         BAL   R14,FLUSH
         BNZ   RETURN
         L     R5,EABLN
         ST    R5,EAADBC
         SR    R15,R15
         IC    R15,EAPSZ
         ST    R15,PSZ
         L     R4,EABL
         BAL   R14,TREEB      THE POINTER TREE
         BNZ   RETURN
         ST    R1,EAFOP
         STC   R0,EALVL
         BAL   R14,FREEBL     (THE LIST IS SPENT)
         XC    EAPBNO,EAPBNO
*        THE DIRECTORY ENTRY: THE FST AS FINIS LEFT IT, AND FULLWORDS
         L     R1,EADIRX
         SLL   R1,6
         A     R1,EDDIRA
         MVC   0(40,R1),0(R7)
         MVC   40(12,R1),EAFOP    FOP, ADBC, AIC
         MVC   52(2,R1),EALVL     LEVELS, POINTER SIZE
         BAL   R14,BCDDATE        +54
         MVI   63(R1),0           NO LONGER PENDING
         BAL   R14,COMMIT
         BNZ   RETURN
FW90     SR    R15,R15
         B     RETURN
         DROP  R6,R8,R9
*
*        BCDDATE: YY MM DD HH MM SS (BCD) AT 54(R1), FROM DIAG X'0C'
BCDDATE  STM   R14,R3,ALCREGS
         LA    R2,DATEBUF
         DC    X'8320000C'    DIAG X'0C': MM/DD/YY HH:MM:SS
         LR    R3,R1
         LA    R2,DATEBUF+6   YY
         BAL   R14,BCD2
         LA    R2,DATEBUF     MM
         BAL   R14,BCD2
         LA    R2,DATEBUF+3   DD
         BAL   R14,BCD2
         LA    R2,DATEBUF+8   HH
         BAL   R14,BCD2
         LA    R2,DATEBUF+11  MM
         BAL   R14,BCD2
         LA    R2,DATEBUF+14  SS
         BAL   R14,BCD2
         LM    R14,R3,ALCREGS
         BR    R14
*        BCD2: THE TWO DIGITS AT R2 AS ONE BYTE AT 54(R3), R3 + 1
BCD2     SR    R0,R0
         IC    R0,0(,R2)
         N     R0,F15
         SLL   R0,4
         SR    R1,R1
         IC    R1,1(,R2)
         N     R1,F15
         OR    R0,R1
         STC   R0,54(,R3)
         LA    R3,1(,R3)
         BR    R14
*
*        TREEB: THE POINTER TREE OVER THE R5 ENTRIES (12 BYTES EACH)
*        AT R4, POINTER SIZE PSZ.  R1 = FOP, R0 = LEVELS.  THE LIST IS
*        USED UP.  RC 13 FULL, 3 I/O.
TREEB    ST    R14,TBR14
         STM   R4,R9,STRSAVE
         SR    R0,R0
         SR    R1,R1
         LTR   R5,R5
         BZ    TB99
         L     R1,0(,R4)
         C     R5,F1
         BE    TB99           ONE BLOCK: LEVEL 0
         LA    R15,1024
         CLC   PSZ,F4
         BE    *+8
         LA    R15,341
         ST    R15,PER
         SR    R0,R0
         ST    R0,TBLVL
TB10     L     R0,TBLVL       ONE LEVEL MORE
         AH    R0,=H'1'
         ST    R0,TBLVL
         ST    R5,TBN
         SR    R0,R0
         ST    R0,TBIN
         ST    R0,TBOUT
TB20     L     R3,TBN         THIS GROUP: MIN(PER, N - IN)
         S     R3,TBIN
         C     R3,PER
         BNH   *+8
         L     R3,PER
         ST    R3,TBCNT
         L     R0,EDWBUF      AN EMPTY POINTER BLOCK
         L     R1,F4096
         SR    R14,R14
         SR    R15,R15
         MVCL  R0,R14
         L     R7,TBIN
         MH    R7,H12
         AR    R7,R4          R7 = THE GROUP'S FIRST ENTRY
         L     R8,EDWBUF      R8 = WHERE ITS POINTERS GO
         LR    R9,R3
TB25     CLC   PSZ,F4
         BNE   TB26
         MVC   0(4,R8),0(R7)
         LA    R8,4(,R8)
         B     TB27
TB26     MVC   0(12,R8),0(R7)
         LA    R8,12(,R8)
TB27     LA    R7,12(,R7)
         BCT   R9,TB25
         CLC   PSZ,F4
         BE    TB28
         LR    R0,R3          V: THE LAST WORD = OFFSET OF THE LAST
         BCTR  R0,0
         MH    R0,H12
         L     R8,EDWBUF
         ST    R0,4092(,R8)
TB28     BAL   R14,ALLOC1
         BNZ   TB98
         L     R2,EDWBUF
         BAL   R14,WRBLK
         BNZ   TB97
*        ITS ENTRY ONE LEVEL UP: (BLOCK, THE LAST HI, THE FIRST DISP)
         L     R7,TBIN
         MH    R7,H12
         AR    R7,R4
         L     R2,8(,R7)      FIRST DISP
         L     R3,TBCNT
         BCTR  R3,0
         MH    R3,H12
         AR    R3,R7
         L     R3,4(,R3)      LAST HI
         L     R7,TBOUT
         MH    R7,H12
         AR    R7,R4
         ST    R1,0(,R7)
         ST    R3,4(,R7)
         ST    R2,8(,R7)
         L     R7,TBOUT
         LA    R7,1(,R7)
         ST    R7,TBOUT
         L     R7,TBIN
         A     R7,TBCNT
         ST    R7,TBIN
         C     R7,TBN
         BL    TB20
         L     R5,TBOUT       THE NEXT LEVEL'S ENTRIES
         C     R5,F1
         BH    TB10
         L     R1,0(,R4)      THE TOP
         L     R0,TBLVL
TB99     SR    R15,R15
         LM    R4,R9,STRSAVE
         L     R14,TBR14
         BR    R14
TB97     LA    R15,3
TB98     LM    R4,R9,STRSAVE
         L     R14,TBR14
         LTR   R15,R15
         BR    R14
*
*        COMMIT: THE DIRECTORY (WITH ITS OWN TREE), THE ALLOCATION MAP
*        AND THE LABEL'S USED COUNT TO DISK; THE ADT'S COUNTS.  R9 =
*        ADT, R10 = EDFCB.
         USING ADTSECT,R9
COMMIT   ST    R14,CMR14
         STM   R4,R9,CMSAVE
         L     R6,EDDIRA      THE DIRECTORY'S OWN FST
         L     R0,EDNDIR
         SLL   R0,6
         A     R0,F4095
         SRL   R0,12          BLOCKS NEEDED
         ST    R0,CMNEW
         MVC   CMOLD,44(R6)   BLOCKS NOW
         L     R0,CMOLD
         C     R0,CMNEW
         BNL   *+8
         L     R0,CMNEW
         ST    R0,CMLN        (THE LARGER: THE LIST'S SIZE)
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=CMNOST
         ST    R1,CMLIST
*        THE PRESENT DATA BLOCKS; THE OLD POINTER BLOCKS FREED
         MVI   FREEFLG,1
         SR    R5,R5
CM10     C     R5,CMOLD
         BNL   CM20
         L     R4,CMLIST
         LR    R1,R5
         MH    R1,H12
         AR    R4,R1
         XC    0(12,R4),0(R4)
         CLI   52(R6),0
         BNE   CM12
         L     R1,40(,R6)
         B     CM14
CM12     BAL   R14,BLKOF
         BNZ   CMIOE
CM14     ST    R1,0(,R4)
         LA    R5,1(,R5)
         B     CM10
CM20     MVI   FREEFLG,0
         XC    EDPBNO,EDPBNO
*        MORE BLOCKS, OR FEWER (THE FIRST, DOP, ALWAYS STAYS)
CM22     C     R5,CMNEW
         BNL   CM30
         BAL   R14,ALLOC1
         BNZ   CMERR
         L     R4,CMLIST
         LR    R2,R5
         MH    R2,H12
         AR    R4,R2
         XC    0(12,R4),0(R4)
         ST    R1,0(,R4)
         LA    R5,1(,R5)
         B     CM22
CM30     C     R5,CMNEW
         BNH   CM40
         BCTR  R5,0
         L     R4,CMLIST
         LR    R2,R5
         MH    R2,H12
         AR    R4,R2
         L     R1,0(,R4)
         BAL   R14,FREE1
         B     CM30
*        THE DATA BLOCKS FROM THE SECOND ON (THE FIRST HOLDS THE
*        DIRECTORY'S OWN ENTRY, WHICH THE TREE CHANGES)
CM40     LA    R5,1
CM42     C     R5,CMNEW
         BNL   CM50
         L     R4,CMLIST
         LR    R2,R5
         MH    R2,H12
         AR    R4,R2
         L     R1,0(,R4)
         LR    R2,R5
         SLL   R2,12
         A     R2,EDDIRA
         BAL   R14,WRBLK
         BNZ   CMIOE
         LA    R5,1(,R5)
         B     CM42
CM50     MVC   PSZ,F4
         L     R4,CMLIST
         L     R5,CMNEW
         BAL   R14,TREEB
         BNZ   CMERR
         L     R6,EDDIRA
         ST    R1,40(,R6)     FOP
         MVC   44(4,R6),CMNEW ADBC
         MVC   48(4,R6),EDNDIR    AIC: THE ENTRIES
         STC   R0,52(,R6)     LEVELS
         MVI   53(R6),4
         L     R1,EDNDIR
         BAL   R14,CAP
         STH   R1,26(,R6)     (FSTIC)
         L     R1,CMNEW
         BAL   R14,CAP
         STH   R1,36(,R6)     (FSTDBC)
         L     R1,EDDOP       THE FIRST DIRECTORY BLOCK
         L     R2,EDDIRA
         BAL   R14,WRBLK
         BNZ   CMIOE
*        THE ALLOCATION MAP
         SR    R5,R5
CM60     C     R5,EDMBN
         BNL   CM70
         LR    R1,R5
         SLL   R1,2
         A     R1,EDMBL
         L     R1,0(,R1)
         LR    R2,R5
         SLL   R2,12
         A     R2,EDMAPA
         BAL   R14,WRBLK
         BNZ   CMIOE
         LA    R5,1(,R5)
         B     CM60
*        THE LABEL'S USED COUNT
CM70     LA    R1,3
         L     R2,EDWBUF
         BAL   R14,RDBLK
         BNZ   CMIOE
         L     R2,EDWBUF
         MVC   32(4,R2),EDUSED
         LA    R1,3
         BAL   R14,WRBLK
         BNZ   CMIOE
         MVC   ADTUSED,EDUSED
         L     R1,EDTOT
         S     R1,EDUSED
         ST    R1,ADTLEFT
         SR    R15,R15
         B     CM90
CMIOE    LA    R15,3
CMERR    MVI   FREEFLG,0
CM90     ST    R15,RCSAVE
         L     R1,CMLIST
         L     R0,CMLN
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFRET DWORDS=(0),LOC=(1)
         L     R15,RCSAVE
CM99     LM    R4,R9,CMSAVE
         L     R14,CMR14
         LTR   R15,R15
         BR    R14
CMNOST   LA    R15,25
         B     CM99
         DROP  R9
         EJECT
***********************************************************************
*        7  SYNC -- UPDISK ON AN EDF DISK.  R1 = ADT.  DIRECTORY
*        ENTRIES WHOSE FILE NO LONGER HAS AN FST WERE ERASED: THEIR
*        BLOCKS GO BACK.  RENAMED FILES GET THEIR NEW NAMES.  THEN THE
*        DIRECTORY, THE MAP AND THE LABEL ARE WRITTEN.
***********************************************************************
FSYNC    LR    R9,R1
         USING ADTSECT,R9
         L     R10,ADTQQM
         TM    EDFLG,EDFRW
         BZ    SY99
         XC    SYCHG,SYCHG
         LA    R5,2
SY10     C     R5,EDNDIR
         BNL   SY80
         LR    R6,R5
         SLL   R6,6
         A     R6,EDDIRA      R6 = THE ENTRY
         OC    0(8,R6),0(R6)
         BZ    SY70           (AN EMPTY SLOT)
         CLI   63(R6),0
         BNE   SY70           (A NEW FILE, NOT YET FINISHED)
         STH   R5,HALF
*        ITS FST IN THE HYPERBLOCKS
         L     R3,ADTFDA
         LTR   R3,R3
         BZ    SY40
         LA    R3,8(,R3)
SY20     LA    R4,20
         LR    R2,R3
SY25     OC    0(8,R2),0(R2)
         BZ    SY27
         CLC   28(2,R2),HALF  FSTFCL = THE INDEX?
         BE    SY30
SY27     LA    R2,40(,R2)
         BCT   R4,SY25
         ICM   R3,15,800(R3)  THE NEXT HYPERBLOCK
         BNZ   SY20
         B     SY40
SY30     CLC   0(20,R6),0(R2) THE SAME NAME, TYPE, DATE?
         BNE   SY32
         CLC   24(2,R6),24(R2)    AND MODE?
         BE    SY70
SY32     MVC   0(20,R6),0(R2)
         MVC   24(2,R6),24(R2)
         MVI   SYCHG,1
         B     SY70
*        ERASED: ITS BLOCKS BACK
SY40     MVI   SYCHG,1
         MVI   FREEFLG,1
         ST    R5,SYIX
         CLI   52(R6),0
         BNE   SY50
         L     R1,40(,R6)     LEVEL 0: THE ONE BLOCK
         BAL   R14,FREE1
         B     SY60
SY50     SR    R5,R5
SY52     C     R5,44(,R6)
         BNL   SY60
         BAL   R14,BLKOF      (POINTER BLOCKS FREED ON THE WAY)
         BNZ   SY60
         BAL   R14,FREE1
         LA    R5,1(,R5)
         B     SY52
SY60     MVI   FREEFLG,0
         XC    EDPBNO,EDPBNO
         XC    0(64,R6),0(R6)
         L     R5,SYIX
SY70     LA    R5,1(,R5)
         B     SY10
SY80     CLI   SYCHG,0
         BE    SY99
         BAL   R14,COMMIT
         B     RETURN
SY99     SR    R15,R15
         B     RETURN
         DROP  R9
         EJECT
***********************************************************************
*        8  FMT -- FORMAT A DISK AS EDF (FORMAT ... (BLKSIZE 4096).
*        R1 -> H DEVICE, X 0, X CMS DEVICE TYPE, F CYLINDERS AT MOST,
*        CL6 LABEL.  THE TRACKS GET 4096-BYTE RECORDS AFTER R0; THEN
*        THE LABEL, THE DIRECTORY AND THE ALLOCATION MAP ARE WRITTEN
*        AS EDF.PY FORMAT WRITES THEM.  RC 255 NOT A 3350/3380, 1 I/O,
*        25 STORAGE.
***********************************************************************
FFMT     LR    R8,R1          R8 = THE PARAMETERS
         LA    R3,4           3350: 4 BLOCKS A TRACK, 30 TRACKS
         LA    R4,30
         CLI   3(R8),X'0B'
         BE    FM05
         LA    R3,10          3380: 10 AND 15
         LA    R4,15
         CLI   3(R8),X'0E'
         BE    FM05
         LA    R15,255
         B     RETURN
FM05     STM   R3,R4,GEOM
         LA    R0,512+EDCBD   A CONTROL BLOCK AND A 4K BUFFER
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=FMNOST
         LR    R10,R1
         XC    EDFCB(EDCBL),EDFCB
         LA    R1,EDCBL(,R10)
         ST    R1,EDBUF
         LM    R3,R4,GEOM
         ST    R3,EDBPT
         ST    R4,EDHDS
         MVC   EDDEV,0(R8)
         MVC   EDBS,F4096
*        THE CYLINDERS: THE LARGEST C <= THE LIMIT WHOSE LAST
*        CYLINDER (C-1) CAN BE REACHED
         L     R5,4(,R8)      HI
         LTR   R5,R5
         BP    *+8
         L     R5,F65535
         LA    R4,1           LO
         LR    R1,R5
         BCTR  R1,0
         BAL   R14,SEEKOK
         BZ    FM20           ALL OF IT
FM10     LA    R1,1(,R4)
         CR    R1,R5
         BNL   FM15
         LR    R1,R4          MID = (LO + HI) / 2
         AR    R1,R5
         SRL   R1,1
         ST    R1,FMMID
         BCTR  R1,0
         BAL   R14,SEEKOK
         L     R1,FMMID
         BNZ   FM12
         LR    R4,R1          REACHABLE: LO = MID
         B     FM10
FM12     LR    R5,R1          NOT: HI = MID
         B     FM10
FM15     LR    R5,R4
FM20     ST    R5,EDCYL
         M     R4,EDHDS       TOTAL = CYL * HEADS * BPT
         M     R4,EDBPT
         ST    R5,EDTOT
*        EVERY TRACK: HOME ADDRESS, R0, THEN BPT 4096-BYTE RECORDS
         SR    R6,R6          CYLINDER
FM30     SR    R7,R7          HEAD
FM32     BAL   R14,FMTTRK
         BNZ   FMIOE
         LA    R7,1(,R7)
         C     R7,EDHDS
         BL    FM32
         LA    R6,1(,R6)
         C     R6,EDCYL
         BL    FM30
*        THE ALLOCATION MAP: BLOCKS 1-4 AND THOSE PAST THE END IN USE
         L     R1,EDTOT
         LA    R1,7(,R1)
         SRL   R1,3           MAP BYTES
         A     R1,F4095
         SRL   R1,12          MAP BLOCKS
         ST    R1,EDMBN
         SLL   R1,9
         ST    R1,EDMAPN
         LR    R0,R1
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=FMNOST2
         ST    R1,EDMAPA
         LR    R0,R1          ZEROS
         L     R1,EDMAPN
         SLL   R1,3
         SR    R14,R14
         SR    R15,R15
         MVCL  R0,R14
         L     R2,EDMAPA
         MVI   0(R2),X'F0'    BLOCKS 1-4
         L     R1,EDTOT
         LR    R3,R1
         SRL   R3,3           THE BYTE OF THE FIRST BLOCK PAST THE END
         N     R1,F7
         LA    R0,X'FF'
         SRL   R0,0(R1)
         LA    R3,0(R3,R2)
         SR    R1,R1
         IC    R1,0(,R3)
         OR    R1,R0
         STC   R1,0(,R3)
         LA    R3,1(,R3)      AND ALL FURTHER BYTES
         L     R1,EDMAPN
         SLL   R1,3
         AR    R1,R2          (THE END OF THE MAP)
FM40     CR    R3,R1
         BNL   FM45
         MVI   0(R3),X'FF'
         LA    R3,1(,R3)
         B     FM40
FM45     LA    R0,4
         ST    R0,EDUSED
         LA    R0,512         A BUFFER FOR WRITING
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=FMNOST2
         ST    R1,EDWBUF
*        THE MAP'S BLOCKS (5, 6, ...), AND ITS TREE IF IT HAS SEVERAL
         L     R0,EDMBN
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,ERR=FMNOST2
         ST    R1,EDMBL       (AS A 12-BYTE LIST HERE)
         SR    R5,R5
FM50     C     R5,EDMBN
         BNL   FM55
         BAL   R14,ALLOC1
         BNZ   FMERR
         LR    R2,R5
         MH    R2,H12
         A     R2,EDMBL
         XC    0(12,R2),0(R2)
         ST    R1,0(,R2)
         LTR   R5,R5
         BNZ   *+8
         ST    R1,FMAM1       THE FIRST
         LA    R5,1(,R5)
         B     FM50
FM55     MVC   PSZ,F4
         L     R4,EDMBL
         L     R5,EDMBN
         BAL   R14,TREEB
         BNZ   FMERR
         ST    R1,FMAMFOP
         STC   R0,FMAMLVL
*        THE DIRECTORY: BLOCK 4, TWO ENTRIES
         L     R0,EDWBUF
         L     R1,F4096
         SR    R14,R14
         SR    R15,R15
         MVCL  R0,R14
         L     R1,EDWBUF
         MVC   0(16,R1),DIRNAME   X'0000000100000000' DIRECTOR
         LA    R2,2
         ST    R2,48(,R1)     AIC 2
         LA    R2,4
         ST    R2,40(,R1)     FOP 4
         LA    R2,1
         ST    R2,44(,R1)     ADBC 1
         LA    R2,64
         ST    R2,32(,R1)     LRECL 64
         BAL   R14,FMENT
         LA    R1,64(,R1)
         MVC   0(16,R1),AMNAME    X'0000000200000000' ALLOCMAP
         L     R2,EDMBN
         ST    R2,44(,R1)     ADBC
         ST    R2,48(,R1)     AIC
         MVC   40(4,R1),FMAMFOP
         MVC   52(1,R1),FMAMLVL
         MVC   32(4,R1),F4096 LRECL 4096
         BAL   R14,FMENT
         LA    R1,4
         L     R2,EDWBUF
         BAL   R14,WRBLK
         BNZ   FMIOE
*        THE MAP
         SR    R5,R5
FM60     C     R5,EDMBN
         BNL   FM70
         L     R1,FMAM1
         AR    R1,R5
         LR    R2,R5
         SLL   R2,12
         A     R2,EDMAPA
         BAL   R14,WRBLK
         BNZ   FMIOE
         LA    R5,1(,R5)
         B     FM60
*        THE LABEL: BLOCK 3
FM70     L     R0,EDWBUF
         L     R1,F4096
         SR    R14,R14
         SR    R15,R15
         MVCL  R0,R14
         L     R1,EDWBUF
         MVC   0(4,R1),CMS1
         MVC   4(6,R1),8(R8)
         MVC   12(4,R1),F4096 BLOCK SIZE
         MVC   16(4,R1),F4    DOP
         MVC   20(4,R1),EDCYL CYLINDERS FORMATTED,
         MVC   24(4,R1),EDCYL AND THE MAXIMUM
         MVC   28(4,R1),EDTOT
         MVC   32(4,R1),EDUSED
         LA    R2,64
         ST    R2,36(,R1)     FST SIZE
         ST    R2,40(,R1)     FSTS A BLOCK
         SH    R1,=H'10'      (BCDDATE WRITES AT 54(R1): +44)
         BAL   R14,BCDDATE
         LA    R1,3
         L     R2,EDWBUF
         BAL   R14,WRBLK
         BNZ   FMIOE
         SR    R15,R15
         B     FM90
FMIOE    LA    R15,1
         B     FM90
FMERR    DS    0H             (R15 FROM ALLOC1 OR TREEB)
FM90     ST    R15,RCSAVE
         L     R1,EDMBL       (12-BYTE ENTRIES HERE)
         LTR   R1,R1
         BZ    FM92
         L     R0,EDMBN
         MH    R0,H12
         AH    R0,=H'7'
         SRL   R0,3
         DMSFRET DWORDS=(0),LOC=(1)
         XC    EDMBL,EDMBL
FM92     BAL   R14,FREECB     (THE MAP, THE BUFFERS, THE BLOCK)
         L     R15,RCSAVE
         B     RETURN
FMNOST2  LA    R15,25
         B     FM90
FMNOST   LA    R15,25
         B     RETURN
*
*        FMENT: THE COMMON FIELDS OF DIRECTORY ENTRY R1 (FOP, ADBC,
*        AIC, LRECL AND LEVELS ALREADY IN IT)
FMENT    ST    R14,FMR14
         L     R2,48(,R1)     WP = AIC + 1, RP = 1
         LA    R2,1(,R2)
         STH   R2,20(,R1)
         MVC   22(2,R1),H1
         MVC   24(2,R1),=C'P0'
         MVC   26(2,R1),50(R1)    IC (HALFWORD OF AIC)
         MVC   28(2,R1),42(R1)    FCL (HALFWORD OF FOP)
         MVI   30(R1),C'F'
         MVI   31(R1),X'08'
         MVC   36(2,R1),46(R1)    DBC
         MVI   53(R1),4
         BAL   R14,BCDDATE        +54: YY MM DD HH MM SS
         MVC   16(4,R1),55(R1)    FSTD: MM DD HH MM
         MVC   38(2,R1),DATEBUF+6 YEAR (EBCDIC)
         L     R14,FMR14
         BR    R14
*
*        SEEKOK: CAN CYLINDER R1 BE REACHED?  CC 0 YES
SEEKOK   STM   R14,R5,IOREGS
         XC    SEEKARG,SEEKARG
         STH   R1,SEEKARG+2
         LH    R4,EDDEV
         LA    R5,PRBCCW
         DC    X'83450020'
         LM    R14,R5,IOREGS
         BR    R14
*
*        FMTTRK: FORMAT CYLINDER R6 HEAD R7
FMTTRK   STM   R14,R5,IOREGS
         XC    SEEKARG,SEEKARG
         STH   R6,SEEKARG+2
         STH   R7,SEEKARG+4
         MVI   HAREC,0
         MVC   HAREC+1(4),SEEKARG+2   CC HH
         XC    R0REC,R0REC
         MVC   R0REC(4),SEEKARG+2     R0: CC HH 0 0 0008 + 8 ZEROS
         MVI   R0REC+7,8
         L     R3,EDBPT
         LA    R2,FMTRECS     THE RECORDS' CCWS
         LA    R1,CNTS        AND THEIR COUNT FIELDS
         LA    R4,1           R
FT10     MVC   0(4,R1),SEEKARG+2
         STC   R4,4(,R1)
         MVI   5(R1),0
         MVC   6(2,R1),F4096+2
         ST    R1,0(,R2)      CCW X'1D', THE COUNT, CC+SILI, 8
         MVI   0(R2),X'1D'
         MVC   4(4,R2),FTFLGS
         LA    R1,8(,R1)
         LA    R2,8(,R2)
         LA    R4,1(,R4)
         BCT   R3,FT10
         SH    R2,=H'8'
         MVI   4(R2),X'20'    THE LAST: SILI, NO CHAINING
         LH    R4,EDDEV
         LA    R5,FMTCCWS
         DC    X'83450020'
         LM    R14,R5,IOREGS
         BR    R14
         EJECT
***********************************************************************
*        BLKOF: BLOCK NUMBER OF DATA BLOCK INDEX R5 OF THE FILE WHOSE
*        64-BYTE FST IS AT R6 (THROUGH EDBUF).  R1 = BLOCK (0 NULL).
*        FBLKOF: THE SAME FOR AN OPEN FILE (R6 = ITS EDAFT STATE),
*        THROUGH ITS OWN POINTER BUFFER.
***********************************************************************
BLKOF    ST    R14,BLKR14
         L     R1,40(,R6)     FOP
         SR    R0,R0
         IC    R0,52(,R6)     LEVELS
         SR    R15,R15
         IC    R15,53(,R6)    POINTER SIZE
         ST    R15,PSZ
         LA    R2,EDPBNO      THE CACHE: EDBUF / EDPBNO
         ST    R2,CACHENO
         L     R2,EDBUF
         ST    R2,CACHEBUF
         B     BLK10
         USING EDAFT,R6
FBLKOF   ST    R14,BLKR14
         L     R1,EAFOP
         SR    R0,R0
         IC    R0,EALVL
         SR    R15,R15
         IC    R15,EAPSZ
         ST    R15,PSZ
         LA    R2,EAPBNO
         ST    R2,CACHENO
         L     R2,EAPBUF
         ST    R2,CACHEBUF
         DROP  R6
*        R0 = LEVELS, R1 = FOP, R5 = INDEX
BLK10    LTR   R0,R0
         BZ    BLKDONE        LEVEL 0: THE FOP IS THE BLOCK
*        ENTRIES A POINTER BLOCK: 1024 (F) OR 341 (V)
         LA    R15,1024
         CLC   PSZ,F4
         BE    *+8
         LA    R15,341
         ST    R15,PER
*        DIVISOR FOR THE TOP LEVEL: PER ** (LEVELS-1)
         LA    R3,1
         LR    R2,R0
         BCTR  R2,0
BLK12    LTR   R2,R2
         BZ    BLK14
         ST    R2,LVLCNT
         SR    R2,R2
         M     R2,PER         R3 = R3 * PER
         L     R2,LVLCNT
         BCTR  R2,0
         B     BLK12
BLK14    ST    R3,DIVISOR
*        DOWN THE TREE: AT EACH LEVEL ENTRY = (INDEX / DIV) MOD PER
BLK20    ST    R0,LVLCNT
         LR    R14,R1         THE POINTER BLOCK NUMBER
         L     R2,CACHENO
         C     R14,0(,R2)     IN THE CACHE?
         BE    BLK25
         ST    R14,0(,R2)
         LR    R1,R14
         L     R2,CACHEBUF
         BAL   R14,RDBLK
         BNZ   BLK22
         CLI   FREEFLG,0      FREEING THE TREE AS IT IS WALKED?
         BE    BLK25
         BAL   R14,FREE1      (R1 = THE POINTER BLOCK)
         B     BLK25
BLK22    L     R2,CACHENO
         XC    0(4,R2),0(R2)
         LA    R15,3
         B     BLKRET
BLK25    SR    R2,R2
         LR    R3,R5
         D     R2,DIVISOR     R3 = INDEX / DIV
         SR    R2,R2
         D     R2,PER         R2 = THAT MOD PER
         LR    R3,R2
         M     R2,PSZ         R3 = OFFSET OF THE ENTRY
         A     R3,CACHEBUF
         ST    R3,LASTENT     (THE LEVEL-1 ENTRY, AT THE END)
         L     R1,0(,R3)      THE NEXT BLOCK DOWN
         L     R0,LVLCNT
         BCTR  R0,0
         LTR   R0,R0
         BZ    BLKDONE
         ST    R0,LVLCNT
         SR    R2,R2          DIVISOR / PER
         L     R3,DIVISOR
         D     R2,PER
         ST    R3,DIVISOR
         B     BLK20
BLKDONE  SR    R15,R15
BLKRET   L     R14,BLKR14
         LTR   R15,R15
         BR    R14
         EJECT
***********************************************************************
*        RDBLK: READ BLOCK R1 INTO R2 (4096 BYTES).  CC 0 OK.
*        THE I/O IS DIAG X'20' ON THE VIRTUAL DEVICE: SEEK, SEARCH ID
*        EQUAL, TIC, READ DATA -- AS DMSFOR FORMATS, NOT THROUGH DIAG
*        X'18' (WHICH TAKES AT MOST 2048 BYTES A CCW).
***********************************************************************
RDBLK    STM   R14,R5,IOREGS
         MVI   IODATA,X'06'   READ DATA
         B     IO10
WRBLK    STM   R14,R5,IOREGS
         MVI   IODATA,X'05'   WRITE DATA
IO10     BCTR  R1,0           BLOCK - 1
         SR    R0,R0
         D     R0,EDBPT       R1 = TRACK, R0 = RECORD - 1
         LR    R4,R0
         LA    R4,1(,R4)      RECORD
         SR    R0,R0
         D     R0,EDHDS       R1 = CYLINDER, R0 = HEAD
         XC    SEEKARG,SEEKARG
         STH   R1,SEEKARG+2   BB CC HH
         STH   R0,SEEKARG+4
         STC   R4,SEEKARG+6   R
         STCM  R2,7,IODATA+1  THE BUFFER
         LH    R4,EDDEV
         LA    R5,IOCCWS
         DC    X'83450020'    DIAG X'20': R4 DEVICE, R5 CCWS
         BNZ   IOERR
         LM    R14,R5,IOREGS
         SR    R15,R15
         BR    R14
IOERR    LM    R14,R5,IOREGS
         LA    R15,3
         LTR   R15,R15
         BR    R14
         EJECT
*        CONSTANTS AND WORK AREAS (THE MODULE IS NOT REENTRANT; CMS
*        CALLS IT FROM ONE PLACE AT A TIME)
         DS    0D
IOCCWS   CCW   X'07',SEEKARG,X'40',6        SEEK
SRCH     CCW   X'31',SEEKARG+2,X'40',5      SEARCH ID EQUAL
         CCW   X'08',SRCH,0,0               TIC
IODATA   CCW   X'06',0,X'20',4096           READ/WRITE DATA, SILI
SEEKARG  DC    XL8'00'
FMTCCWS  CCW   X'07',SEEKARG,X'40',6        SEEK
         CCW   X'1F',FMASK,X'60',1          SET FILE MASK
FMTSRCH  CCW   X'31',R0REC,X'60',5          SEARCH ID EQUAL: R0
         CCW   X'08',FMTSRCH,0,0            TIC (AS DMSFOR, NO HA/R0
*                                           WRITES: CP REFUSES THEM
*                                           ON A MINIDISK)
FMTRECS  DS    12D            WRITE CKD, ONE A RECORD (FMTTRK)
PRBCCW   CCW   X'07',SEEKARG,X'00',6        SEEK ONLY (SEEKOK)
CNTS     DS    12D
R0REC    DS    XL16
HAREC    DS    XL5
FMASK    DC    X'C0'          PERMIT WRITES (AS DMSFOR)
         DS    0F
FTFLGS   DC    X'60',X'00',H'8'
DIRNAME  DC    X'0000000100000000',CL8'DIRECTOR'
AMNAME   DC    X'0000000200000000',CL8'ALLOCMAP'
FMMID    DS    F
FMAM1    DS    F
FMAMFOP  DS    F
FMR14    DS    F
FMAMLVL  DS    X
DBGDW    DC    D'0'
DBGON    DC    X'00'          X'01': A MESSAGE PER CALL
DBGTXT   DC    C'MSG * EFS F='
DBGFN    DC    C'0'
         DC    C' RC='
DBGRC    DC    C'000'
DBGTXTL  EQU   *-DBGTXT
IOREGS   DS    8F
STRREGS  DS    3F
STRSAVE  DS    6F
EDWORK   DS    18F
DIAG24   DS    F
GEOM     DS    2F
RCSAVE   DS    F
OFFSAVE  DS    F
LENSAVE  DS    F
STRCHUNK DS    F
STRR14   DS    F
BLKR14   DS    F
OPENR14  DS    F
FREER14  DS    F
PSZ      DS    F
PER      DS    F
DIVISOR  DS    F
LVLCNT   DS    F
CACHENO  DS    A
CACHEBUF DS    A
DIRFST   DS    XL64
LASTENT  DS    A
HBSTART  DS    A
TBR14    DS    F
TBLVL    DS    F
TBN      DS    F
TBIN     DS    F
TBOUT    DS    F
TBCNT    DS    F
STWR14   DS    F
STWREGS  DS    4F
FLR14    DS    F
ALCREGS  DS    8F
CMSAVE   DS    6F
         DS    0D
DATEBUF  DS    CL32
LBR14    DS    F
CMR14    DS    F
CMLIST   DS    A
CMLN     DS    F
CMOLD    DS    F
CMNEW    DS    F
VSTART   DS    F
VER14    DS    F
NER14    DS    F
SYCHG    DS    F
SYIX     DS    F
SYR14    DS    F
FREEFLG  DS    X
DEV      DS    H
HALF     DS    H
CMSTYPE  DS    X
RCRO     DS    X
         DS    0F
F1       DC    F'1'
F4       DC    F'4'
F4095    DC    F'4095'
F4096    DC    F'4096'
F65535   DC    F'65535'
F32768   DC    F'32768'
F65536   DC    F'65536'
H1       DC    H'1'
H12      DC    H'12'
F7       DC    F'7'
F8       DC    F'8'
F15      DC    F'15'
FM1      DC    F'-1'
F40800   DC    F'40',F'800'
CMS1     DC    X'C3D4E2F1'    'CMS1'
         LTORG
         EJECT
         NUCON
         ADT
         AFT
         FSTB
R0       EQU   0
R1       EQU   1
R2       EQU   2
R3       EQU   3
R4       EQU   4
R5       EQU   5
R6       EQU   6
R7       EQU   7
R8       EQU   8
R9       EQU   9
R10      EQU   10
R11      EQU   11
R12      EQU   12
R13      EQU   13
R14      EQU   14
R15      EQU   15
         END
