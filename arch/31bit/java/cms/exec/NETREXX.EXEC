/* NETREXX EXEC -- NetRexx 3.05 on CMS, on JamVM (9.35)               */
/*   NETREXX fn [options]   process fn NRX with NetRexxC              */
/*   Default -exec: the program is interpreted and run at once.        */
/*   NETREXX fn COMPILE: compile to fn CLASS (ecj), then JAVA fn.      */
/*   Other NetRexxC options are passed on, e.g. -keepasjava.           */
PARSE ARG FN OPTS
IF FN = '' THEN DO
  SAY 'NETREXX: give the program: NETREXX fn [options]  (fn NRX)'
  EXIT 24
END
'STATE' FN 'NRX *'
IF RC <> 0 THEN DO; SAY 'NETREXX:' FN 'NRX not found'; EXIT 28; END
'STATE NETREXX JAR *'
IF RC <> 0 THEN DO
  SAY 'NETREXX: NETREXX JAR not found -- enter LANG first'
  EXIT 28
END
OPTS = TRANSLATE(OPTS, 'abcdefghijklmnopqrstuvwxyz',,
                       'ABCDEFGHIJKLMNOPQRSTUVWXYZ')
ECJ = ''
IF WORDPOS('compile', OPTS) > 0 THEN DO
  OPTS = DELWORD(OPTS, WORDPOS('compile', OPTS), 1)
  ECJ = '-Dnrx.compiler=ecj'
END
ELSE IF OPTS = '' THEN OPTS = '-exec'
C = 'org.netrexx.process.NetRexxC'
'EXEC JAVA -Xmx64m' ECJ '-cp /netrexx.jar:/ecj.jar' C OPTS FN
EXIT RC
