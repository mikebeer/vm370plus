@@ -0,0 +1,5 @@
+## s390 (31-bit), VM/370plus: native calls through libffi
+noinst_LTLIBRARIES = libnative.la
+libnative_la_SOURCES = init.c dll_md.c
+
+AM_CPPFLAGS = -I$(top_builddir)/src
