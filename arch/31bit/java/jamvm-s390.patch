diff --git a/src/arch/s390.h b/src/arch/s390.h
new file mode 100644
index 0000000..9ad9a39
--- /dev/null
+++ b/src/arch/s390.h
@@ -0,0 +1,38 @@
+/*
+ * s390.h -- JamVM on 31-bit S/390 (ESA/390), VM/370plus 9.34.
+ * Big-endian like powerpc; atomics by GCC's __sync builtins (CS);
+ * no inlining interpreter (configure --disable-int-inlining), so the code
+ * generation macros are never used.  Native calls go through libffi.
+ */
+
+#define OS_ARCH "s390"
+
+/* a 64 MB virtual machine: keep the minimum heap small */
+#define DEFAULT_MIN_HEAP 1*MB
+
+#define HANDLER_TABLE_T static const void
+#define DOUBLE_1_BITS 0x3ff0000000000000LL
+
+#define READ_DBL(v,p,l) v = ((u8)p[0]<<56)|((u8)p[1]<<48)|((u8)p[2]<<40) \
+                            |((u8)p[3]<<32)|((u8)p[4]<<24)|((u8)p[5]<<16) \
+                            |((u8)p[6]<<8)|(u8)p[7]; p+=8
+
+#define FPU_HACK
+
+#define COMPARE_AND_SWAP_32(addr, old_val, new_val) \
+        __sync_bool_compare_and_swap((volatile int*)(addr), (int)(old_val), (int)(new_val))
+
+#define COMPARE_AND_SWAP(addr, old_val, new_val) \
+        COMPARE_AND_SWAP_32(addr, old_val, new_val)
+
+#define LOCKWORD_READ(addr) *addr
+#define LOCKWORD_WRITE(addr, value) *addr = value
+#define LOCKWORD_COMPARE_AND_SWAP(addr, old_val, new_val) \
+        COMPARE_AND_SWAP(addr, old_val, new_val)
+
+#define FLUSH_CACHE(addr, length)
+#define GEN_REL_JMP(target_addr, patch_addr, patch_size) FALSE
+
+#define MBARRIER() __sync_synchronize()
+#define JMM_LOCK_MBARRIER() __sync_synchronize()
+#define JMM_UNLOCK_MBARRIER() __sync_synchronize()
