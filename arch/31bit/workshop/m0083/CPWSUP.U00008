***********************************************************************
*        TRANSLATE TABLE TO FOLD PF13-24 INTO PF1-12
*              FOLD PF13-PF24 INTO PF1-PF12                             01033260
***********************************************************************
PFTRTAB  DC    256AL1(NINTR)       UNRECOGNISED = NOAID                 01033280
         ORG   PFTRTAB+ENT    ENTER KEY                                 01033300
         DC    AL1(ENT)                                                 01033320
         ORG   PFTRTAB+RDR    OPERATOR ID CARD                          01033340
         DC    AL1(ENT)       MAP INTO ENTER                            01033360
         ORG   PFTRTAB+SCNR   HAND SCANNER                              01033380
         DC    AL1(ENT)       MAP INTO ENTER                            01033400
         ORG   PFTRTAB+PEN    LIGHT PEN HIT                             01033420
         DC    AL1(ENT)       MAP INTO ENTER.                           01033440
         ORG   PFTRTAB+TRQ    TEST REQ/SYS REQ                          01033460
         DC    AL1(TRQ)                                                 01033480
         ORG   PFTRTAB+PA1                                              01033500
         DC    AL1(PA1)       MAP INTO SELF                             01033520
         ORG   PFTRTAB+CLR    CLEAR KEY                                 01033540
         DC    AL1(CLR)                                                 01033560
         ORG   PFTRTAB+PA2    PA 2 (CNCL)                               01033580
         DC    AL1(PA2)                                                 01033600
         ORG   PFTRTAB+PA3    PA 3                                      01033620
         DC    AL1(PA3)                                                 01033640
         ORG   PFTRTAB+PF1         PF1-9                                01033660
         DC    AL1(PF1,PF2,PF3,PF4,PF5,PF6,PF7,PF8,PF9)                 01033680
         ORG   PFTRTAB+PF10        PF10-12                              01033700
