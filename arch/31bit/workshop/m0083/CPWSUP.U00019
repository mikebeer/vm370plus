./ I 00095000          $ 95007 7                      10/31/84 14:25:22
EXTVMCB  EQU   *              ENTRY: VMCF INTERRUPT.           U00019   00095007
         LA    R11,VMCDMHDR   INTERRUPT HEADER                 U00019   00095014
         USING VMCMHDR,R11                                     U00019   00095021
         SPACE 2                                               U00019   00095028
         ICM   R9,15,AVMCU    FIND THE RECORD FOR THIS USER.   U00019   00095035
EXTUL1   BZ    EXTULNF        NOT FOUND.                       U00019   00095042
         USING VMUSECT,R9                                      U00019   00095049
         CLC   VMCMUSER,VMUNAME         IS THIS HIM ?          U00019   00095056
         BE    EXTULFD                                         U00019   00095063
            ICM  R9,15,VMUFPNT CHAIN.                          U00019   00095070
            B   EXTUL1        AND CONTINUE                     U00019   00095077
EXTULNF  EQU   *              USER DOES NOT EXIST YET.         U00019   00095084
         LA    R0,VMUSECTL    BYTES.                           U00019   00095091
         SVC   SVCGETM                                         U00019   00095098
         XC    0(VMUSECTL,R1),0(R1)                            U00019   00095105
         IF CLC,AVMCU,=F'0',EQ,THEN     IS IT FIRST            U00019   00095112
            ST  R1,AVMCU      YES, BEGIN CHAIN.                U00019   00095119
         IF ELSE                                               U00019   00095126
            L   R9,AVMCU                                       U00019   00095133
            DO WHILE,CLC,VMUFPNT,=F'0',NE                      U00019   00095140
               L   R9,VMUFPNT                                  U00019   00095147
            DO END                                             U00019   00095154
            ST  R1,VMUFPNT                                     U00019   00095161
         IF END                                                U00019   00095168
         SPACE 1                                               U00019   00095175
         LR    R9,R1                                           U00019   00095182
         MVC   VMUNAME,VMCMUSER         MAKE IT HIS.           U00019   00095189
         MVC   VMUSTAT,=A(VMUMET) FIRST TIME THROUGH.          U00019   00095196
         MVC   VMUDSP,=V(DSPSYS)                               U00019   00095203
         SPACE 2                                               U00019   00095210
EXTULFD  EQU   *              FOUND USER.                      U00019   00095217
         SPACE 1                                               U00019   00095224
         IF TM,VMCMSTAT,VMCMRESP,O,THEN                        U00019   00095231
*           FINAL RESPONSE TO OUR LAST SEND.                   U00019   00095238
            L  R2,VMCSOS       OUTSTANDING VMCF MESSAGES.      U00019   00095245
            BCTR R2,0         ARE ONE LESS                     U00019   00095252
            ST   R2,VMCSOS                                     U00019   00095259
            SPACE 1                                            U00019   00095266
            IF C,R2,=A(VMCSMAX-1),EQ,THEN                      U00019   00095273
               SVC SVCDISP    SEND OFF WHOEVER'S WAITING.      U00019   00095280
            IF END                                             U00019   00095287
            SPACE 1                                            U00019   00095294
*              CHECK FOR DATA TRANSFER ERROR CODE.             U00019   00095301
            SR  R1,R1                                          U00019   00095308
            IC  R1,VMCMEFLG   DATA TRANSFER ERROR ?            U00019   00095315
            IF LTR,R1,R1,Z,OR,                                         +00095322
               C,R1,=A(VMC15),EQ,OR,                                   +00095329
               C,R1,=A(VMC16),EQ,OR,                                   +00095336
               C,R1,=A(VMC19),EQ,THEN LISTENING FOR NEXT.      U00019   00095343
               MVC  VMUSTAT,=A(VMULSTN) HE IS LISTENING FOR NEXU00019   00095350
               IF LTR,R1,R1,NZ,THEN AN ERROR STATE.            U00019   00095357
*                 SHOULD BUILD MESSAGE HERE-CODE 15, 16, 19.   U00019   00095364
               IF END                                          U00019   00095371
            SPACE 1                                            U00019   00095378
            IF ELSE           HAS QUIT, OR FATAL ERROR.        U00019   00095385
               MVC VMUSTAT,=A(VMUNOT)   MARK AS DEAD.          U00019   00095392
               IF C,R1,=A(VMC05),NE,THEN HAS DIED HORRIBLY.    U00019   00095399
*                 SHOULD BUILD MESSAGE HERE- CODE 1, 6, 7, 17. U00019   00095406
               IF END                                          U00019   00095413
               SP  LISTNRS,=P'1'                               U00019   00095420
            IF END                                             U00019   00095427
            SPACE 3                                            U00019   00095434
         IF ELSE              WE HAVE RECEIVED A REQUEST.      U00019   00095441
            IF CLC,VMCMFUNC,=AL2(VMCPSENX),EQ,THEN             U00019   00095448
               MVC   VMUIDNT,VMCIDNT                           U00019   00095455
               MVC   VMUPSWD,VMCPSWD                           U00019   00095462
               SPACE 1                                         U00019   00095469
               L     R0,VMUPAG                                 U00019   00095476
               L     R1,VMUDSP                                 U00019   00095483
               LA    R2,VMCCMD                                 U00019   00095490
               L     R15,=A(CMDLU)                             U00019   00095497
               BALR  R14,R15                                   U00019   00095504
               ST    R1,VMUDSP                                 U00019   00095511
               ST    R0,VMUPAG                                 U00019   00095518
               SPACE 1                                         U00019   00095525
               L  R1,VMUSTAT                                   U00019   00095532
               IF C,R1,=A(VMUMET),EQ,OR,                               +00095539
               C,R1,=A(VMUNOT),EQ,THEN    NEW CHAP             U00019   00095546
                  MVC VMUSTAT,=A(VMUMET)  (FOR NOW).           U00019   00095553
                  SPACE 3                                      U00019   00095560
* =============== HOOK FOR VERIFYING PASSWORD. =============== U00019   00095567
* AS INSTALLED, IDENTITY/PASSWORD MUST BE BLANKS (THEY WILL BE)U00019   00095574
* YOU CAN CHANGE THIS CODE TO YOUR HEART'S CONTENT.            U00019
                  IF CLC,VMUIDNT,=CL8' ',NE,OR,                 U00019 +00095581
               CLC,VMUPSWD,=CL8' ',NE,THEN                     U00019   00095588
                     SPACE 1                                   U00019
*    INVALID PASSWORD ACTION 1: DISABLE THE USERID.            U00019
                     MVC VMUSTAT,=A(VMUNOT) MARK HIM DEAD.     U00019   00095609
                     SPACE 1                                   U00019
*     INVALID PASSWORD ACTION 2: TELL HIM TO GO AWAY, POLITELY.U00019
                     VMCF IDENTIFY,USERID=VMUNAME,PARM=VMCDPARM,       +00095595
               MSGID=VMUIPSWD,USEWORD='PASSWORD'               U00019   00095602
                  IF END                                       U00019   00095616
* =============== END PASSWORD VERIFICATION HOOK. ============ U00019   00095623
                  SPACE 3                                      U00019   00095630
*                 VERIFY CPWCMS PROTOCOL LEVEL.                U00019   00095637
                  IF CLC,VMCMUSE,CPWCMSLV,NE,THEN              U00019   00095644
                     VMCF IDENTIFY,USERID=VMUNAME,PARM=VMCDPARM,       +00095651
               MSGID=VMUIPROT,USEWORD=CPWCMSLV                 U00019   00095658
                     MVC VMUSTAT,=A(VMUNOT) MARK HIM DEAD.     U00019   00095665
                  IF END                                       U00019   00095672
                  SPACE 3                                      U00019   00095679
                  IF CLC,VMUSTAT,=A(VMUMET),EQ,THEN PERMITTED  U00019   00095686
                     AP LISTNRS,=P'1'                          U00019   00095693
                     IF CP,LISTNRS,=P'1',EQ,THEN               U00019   00095700
                        NI EXTOPSW+1,255-WAIT ALLOW SCREEN BUILU00019   00095707
                        MVC VMUSTAT,=A(VMULSTN)                U00019   00095714
                     IF ELSE                                   U00019   00095721
                        MVC VMUSTAT,=A(VMUSNDNW) SEND IMMEDIATEU00019   00095728
                     IF END                                    U00019   00095735
                  IF END                                       U00019   00095742
               SPACE 1                                         U00019   00095749
               IF ELSE        HE'S ALREADY IN SESSION.         U00019   00095756
                  MVC VMUSTAT,=A(VMUSNDNW) SEND IMMEDIATE.     U00019   00095763
               IF END                                          U00019   00095770
               SPACE 1                                         U00019   00095777
               IF CLC,VMUSTAT,=A(VMUSNDNW),EQ,THEN             U00019   00095784
                  SVC SVCDISP SEND IT OFF                      U00019   00095791
               IF END                                          U00019   00095798
            IF END                                             U00019   00095805
         IF END                                                U00019   00095812
         SPACE 3                                               U00019   00095819
*              RETURN TO INTERRUPTED ROUTINE.                  U00019   00095826
EXTXIT   EQU   *                                               U00019   00095833
         LM    R0,R15,EXTSAV                                   U00019   00095840
         LPSW  EXTOPSW                                         U00019   00095847
         DROP  R0,R11,R12                                      U00019   00095854
         SPACE 6                                               U00019   00095861
         ENTRY VMCDMHDR,VMCIH                                  U00019   00095868
VMCIH    DC    A(VMCDMHDR,VMCL)         DESCRIPTION OF HEADER. U00019   00095875
VMCDMHDR DC    0D'0',XL(VMCL)'0'   VMCF INTERRUPT HEADER+SX DATU00019   00095882
         SPACE 1                                               U00019   00095889
VMCDPARM DC    0D'0',XL(VMCPLEN)'0'     VMCF REQUEST PARAMETER.U00019   00095896
