         STM   R0,R15,EXTSAV                                   U00019   00091190
         BALR  R12,0                                           U00019   00091380
         USING *,R12                                           U00019   00091570
         L     R12,=A(EXTINTER)                                U00019   00091760
         USING EXTINTER,R12                                    U00019   00091950
         SPACE 1                                               U00019   00092140
         CLC   =AL2(VMCXCODE),EXTOPSW+2     VMCF INTERRUPT ?   U00019   00092330
         BE    EXTVMCB        YES, GO TO SEPARATE HANDLER.     U00019   00092520
            SPACE 1                                            U00019   00092710
*              ORDINARY EXTERNAL: JUST WAKE UP.                U00019   00092900
