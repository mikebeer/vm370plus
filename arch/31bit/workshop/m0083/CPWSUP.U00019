CPWSUP   CSECT RESTORE OLD CSECT.                              U00019   00096010
         EJECT                                                 U00019   00096020
*--------------------------------------------------------------U00019   00096030
* ENTER: R0 = PAGE NO WITHIN CURRENT DISPLAY.                  U00019   00096040
*        R1 -> CURRENT DISPLAY *DSPSECT*                       U00019   00096050
*        R2 -> COMMAND.                                        U00019   00096060
* EXIT:  R0 = NEW PAGE NUMBER.                                 U00019   00096070
*        R1 -> NEW DISPLAY *DSPSECT*                           U00019   00096080
* NON-REENTRANT; MUST RUN UNINTERRUPTABLE.                     U00019   00096090
*--------------------------------------------------------------U00019   00096100
         USING CPWSUP,R0                                       U00019   00096110
CMDLU    STM   R0,R15,CMDLUSAV  LOOK UP A COMMAND.             U00019   00096120
         LA    R3,CMDS                                         U00019   00096130
         LA    R4,CMDEND                                       U00019   00096140
CMDLP    CR    R3,R4                                           U00019   00096150
         BE    CMDLPN                                          U00019   00096160
         CLC   0(8,R2),0(R3)                                   U00019   00096170
         BE    CMDLPN                                          U00019   00096180
            LA  R3,L'CMDS(,R3)                                 U00019   00096190
            B   CMDLP                                          U00019   00096200
CMDLPN   L     R3,8(,R3)                                       U00019   00096210
         BR    R3             GO TO ROUTINE.                   U00019   00096220
         SPACE 1                                               U00019   00096230
CMDDSP   EQU   *              NOT A COMMAND - MUST BE A DISPLAYU00019   00096240
         L     R3,ADSPLAY     FIND DSPSECTS.                   U00019   00096250
         DO UNTIL,C,R3,ADSPLAY,EQ,OR,                                  +00096260
               CLC,0(8,R2),DSPNAME-DSPSECT(R3),EQ              U00019   00096270
            L   R3,DSPNEXT-DSPSECT(,R3)                        U00019   00096280
         DO END                                                U00019   00096290
         IF CR,R1,R3,NE,THEN NEW DISPLAY.                      U00019   00096300
            SR    R0,R0          BEGINNING PAGE.               U00019   00096310
            LR    R1,R3          NEW DSPSECT                   U00019   00096320
         IF END                                                U00019   00096330
         B     CMDX                                            U00019   00096340
         SPACE 1                                               U00019   00096350
CMDLEFT  EQU   *              GO LEFT (PREVIOUS) THROUGH DISPLAU00019   00096360
         BCTR  R0,0                                            U00019   00096370
         IF R0,M,THEN                                          U00019   00096380
            SR  R0,R0                                          U00019   00096390
         IF END                                                U00019   00096400
         B     CMDX                                            U00019   00096410
         SPACE 1                                               U00019   00096420
CMDRIGHT EQU   *              GO RIGHT (NEXT) THROUGH DISPLAY PU00019   00096430
         LA    R4,1                                            U00019   00096440
         AR    R0,R4                                           U00019   00096450
         ZAP   CMDDWD,DSPSCRC-DSPSECT(L'DSPSCRC,R1) PICK UP NO U00019   00096460
         CVB   R4,CMDDWD                                       U00019   00096470
         BCTR  R4,0           MAX OFFSET FROM 0                U00019   00096480
         IF CR,R0,R4,GT,THEN                                   U00019   00096490
            LR  R0,R4                                          U00019   00096500
         IF END                                                U00019   00096510
         B     CMDX                                            U00019   00096520
         SPACE 1                                               U00019   00096530
CMDFWD   EQU   *              GO FORWARD (NEXT) THROUGH MAJOR DU00019   00096540
         L     R1,DSPNEXT-DSPSECT(,R1) GET NEXT DSPSECT        U00019   00096550
         SR    R0,R0          AND LOOK AT BEGINNING PAGE.      U00019   00096560
         B     CMDX                                            U00019   00096570
         SPACE 1                                               U00019   00096580
CMDBACK  EQU   *              GO BACKWARD (PREVIOUS) THROUGH MAU00019   00096590
         L     R3,ADSPLAY                                      U00019   00096600
         DO UNTIL,CR,R1,R3,EQ                                  U00019   00096610
            LR  R4,R3                                          U00019   00096620
            L   R3,DSPNEXT-DSPSECT(,R3)                        U00019   00096630
         DO END                                                U00019   00096640
         LR    R1,R4          GET PREVIOUS DISPLAY SECTION     U00019   00096650
         SR    R0,R0          AND LOOK AT BEGINNING PAGE.      U00019   00096660
         B     CMDX                                            U00019   00096670
         SPACE 1                                               U00019   00096680
CMDX     EQU   *                                               U00019   00096690
         STM   R0,R1,CMDLUSAV                                  U00019   00096700
         LM    R0,R15,CMDLUSAV                                 U00019   00096710
         BR    R14            RETURN TO CALLER                 U00019   00096720
CMDLUSAV DS    16F                                             U00019   00096730
         SPACE 1                                               U00019   00096740
CMDDWD   DS    D                                               U00019   00096750
         DS    0F                                              U00019   00096760
CMDS     DS    0CL12          TABLE OF LOCAL COMMANDS.         U00019   00096770
         DC    CL8'LEFT',AL4(CMDLEFT)                          U00019   00096780
         DC    CL8'RIGHT',AL4(CMDRIGHT)                        U00019   00096790
         DC    CL8'BACKWARD',AL4(CMDBACK)                      U00019   00096800
         DC    CL8'FORWARD',AL4(CMDFWD)                        U00019   00096810
CMDEND   DC    2F'-1',AL4(CMDDSP)                              U00019   00096820
CPWSUP   CSECT                                                 U00019   00096830
./ R 00573010 00573090 $ 573011 1                     10/31/84 14:25:22
         SPACE 1                                               U00019   00573011
*              FIRST, SEND OUT ANY VMCF COMMUNICATIONS.        U00019   00573012
         L R9,AVMCU                                            U00019   00573013
         USING VMUSECT,R9                                      U00019   00573014
         DO WHILE,LTR,R9,R9,NZ,AND,CLC,VMCSOS,=A(VMCSMAX),LT   U00019   00573015
            IF CLC,VMUSTAT,=A(VMUSNDNW),EQ,THEN                U00019   00573016
               L   R0,VMUPAG                                   U00019   00573017
               L   R1,VMUDSP                                   U00019   00573018
               BAL R10,SVCDSPLU         FIND THE SCREEN.       U00019   00573019
               SPACE 1                                         U00019   00573020
               LR    R3,R1                                     U00019   00573021
               USING DSPSECT,R3                                U00019   00573022
               USING SCRSECT,R2                                U00019   00573023
               IF R3,NZ,AND,R2,NZ,THEN                         U00019   00573024
                  VMCF  SEND,USERID=VMUNAME,PARM=SVCDPARM,             +00573025
               MSGID=VMUSDATA,USEWORD=DSPNAME,                         +00573026
               FLDA=SCREEN                                     U00019   00573027
               DROP R2,R3                                      U00019   00573028
                 IF R15,Z,THEN                                 U00019   00573029
                    MVC  VMUSTAT,=A(VMUINCP) XACTION INCOMPLETEU00019   00573030
                    SPACE 1                                    U00019   00573031
                    L    R1,VMCSOS   OUTSTANDING VMCF MESSAGES U00019   00573032
                    A    R1,=F'1'   ARE ONE MORE               U00019   00573033
                    ST   R1,VMCSOS                             U00019   00573034
                    SPACE 1                                    U00019   00573035
                 IF ELSE                                       U00019   00573036
                    C R15,=A(VMC01) INVALID BUFFER ADDRESS     U00019   00573037
                    BE DSNLSER                                 U00019   00573038
                    C R15,=A(VMC02) INVALID SUBFUNCTION        U00019   00573039
                    BE DSNLSER                                 U00019   00573040
                    C R15,=A(VMC04) SOURCE NOT AUTHORIZED      U00019   00573041
                    BE DSNLSER                                 U00019   00573042
                    C R15,=A(VMC05) TARGET NOT AVAILABLE.      U00019   00573043
                    BE DSNLS                                   U00019   00573044
                    C R15,=A(VMC08) DUPLICATE MESSAGE          U00019   00573045
                    BE DSINC                                   U00019   00573046
                    C R15,=A(VMC09) TARGET QUIESCED.           U00019   00573047
                    BE DSNLS                                   U00019   00573048
                    C R15,=A(VMC10) MESSAGE LIMIT EXCEEDED.    U00019   00573049
                    BE DSSND                                   U00019   00573050
                    C R15,=A(VMC15) PAGING FAILURE             U00019   00573051
                    BE DSLSN                                   U00019   00573052
                    C R15,=A(VMC18) USER NOT AUTHORIZED PRTY   U00019   00573053
                    BE DSNLSER                                 U00019   00573054
                    B  DSNLSER                                 U00019   00573055
                    SPACE 1                                    U00019   00573056
DSLSN               EQU * LISTENING - RETRY LATER              U00019   00573057
                    MVC VMUSTAT,=A(VMULSTN)                    U00019   00573058
                        B  DSJOIN                              U00019   00573059
                    SPACE 1                                    U00019   00573060
DSINC               EQU   *  LAST ONE INCOMPLETE.              U00019   00573061
*                   SHOULD BUILD ERROR MESSAGE HERE            U00019   00573062
                    MVC VMUSTAT,=A(VMUSNDNW)                   U00019   00573063
                        B  DSJOIN                              U00019   00573064
                    SPACE 1                                    U00019   00573065
DSSND               EQU   *  MUST STILL SEND IMMEDIATELY       U00019   00573066
*                   SHOULD BUILD ERROR MESSAGE HERE            U00019   00573067
                    MVC VMUSTAT,=A(VMUSNDNW)                   U00019   00573068
                        B  DSJOIN                              U00019   00573069
                    SPACE 1                                    U00019   00573070
DSNLSER             EQU   *  CPWATCH ERROR.                    U00019   00573071
*                   SHOULD BUILD ERROR MESSAGE HERE.           U00019   00573072
*                      B  DSNLS                                U00019   00573073
                    SPACE 1                                    U00019   00573074
DSNLS               EQU   *  NOT LISTENING.                    U00019   00573075
                    MVC  VMUSTAT,=A(VMUNOT) DEAD               U00019   00573076
                    SP  LISTNRS,=P'1'                          U00019   00573077
*                      B   DSJOIN                              U00019   00573078
                    SPACE 1                                    U00019   00573079
DSJOIN              EQU *                                      U00019   00573080
                 IF END                                        U00019   00573081
              IF END                                           U00019   00573082
           IF END                                              U00019   00573083
           SPACE 1                                             U00019   00573084
           L   R9,VMUFPNT                                      U00019   00573085
         DO END                                                U00019   00573086
         DROP R9                                               U00019   00573087
         SPACE 2                                               U00019   00573088
