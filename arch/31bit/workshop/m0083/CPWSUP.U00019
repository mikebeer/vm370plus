./ I 00702000          $ 702050 50                    10/31/84 14:25:22
*--------------------------------------------------------------U00019   00702050
*              SVCDSPLU: DISPLAY LOOKUP.                       U00019   00702100
*--------------------------------------------------------------U00019   00702150
* ENTERED BY: BAL R10,SVCDSPLU                                 U00019   00702200
*             R1 -> DSPSECT, R0 = PAGE NO                      U00019   00702250
* EXIT:       R2 -> PAGE.                                      U00019   00702300
*--------------------------------------------------------------U00019   00702350
SVCDSPLU EQU   *                                               U00019   00702400
         L     R2,DSPFSCR-DSPSECT(,R1)                         U00019   00702450
         DO WHILE,R2,NZ,AND,R0,NZ                              U00019   00702500
            L     R2,SCRNEXT-SCRSECT(,R2)                      U00019   00702550
            BCTR R0,0                                          U00019   00702600
         DO END                                                U00019   00702650
         IF R2,Z,THEN                                          U00019   00702700
            L   R2,DSPFSCR-DSPSECT(,R1)                        U00019   00702750
         IF END                                                U00019   00702800
         BR    R10                                             U00019   00702850
         EJECT                                                 U00019   00702900
