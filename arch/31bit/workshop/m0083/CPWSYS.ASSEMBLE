            SPACE 6                                                     00748000
*              CP UP TIME MSG.                                          00749000
            MVC   CPSYSREL,CPREL                                        00750000
            MVC CPUP,=C' HAS BEEN UP .... DAYS .. HOURS .. MIN'         00751000
            SPACE 1                                                     00752000
            LM    R0,R1,THISCLOK                                        00753000
            SL    R0,CPSTART                                            00754000
            SL    R1,CPSTART+4                                          00755000
            BC    B'0011',*+6                                           00756000
            BCTR  R0,0                                                  00757000
            SRDL  R0,12           CP WAS UP FOR N USEC                  00758000
            D     R0,=F'60000000' UP FOR N MINUTES.                     00759000
            SPACE 1                                                     00760000
            SR  R0,R0                                                   00761000
            D   R0,=F'60'     MIN, HOURS                                00762000
            CVD R0,DWORK                                                00763000
            UNPK CPUPM,DWORK                                            00764000
            OI   CPUPM+L'CPUPM-1,C'0'                                   00765000
            SPACE 1                                                     00766000
            SR  R0,R0                                                   00767000
            D   R0,=F'24'     DAYS, HOURS.                              00768000
            CVD R0,DWORK                                                00769000
            UNPK CPUPH,DWORK                                            00770000
            OI  CPUPH+L'CPUPH-1,C'0'                                    00771000
            SPACE 1                                                     00772000
            CALL DECIT                                                  00773000
            STCM R1,B'1111',CPUPD                                       00774000
            SPACE 1                                                     00775000
