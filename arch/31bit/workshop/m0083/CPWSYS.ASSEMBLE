            MVC CPUI,=C'CPU MODEL XXXX SERIAL XXXXXX'                   00777000
            MVC CPUMODL,CPUMOD                                          00778000
            MVC CPUSERL,CPUSER#                                         00779000
            SPACE 1                                                     00780000
