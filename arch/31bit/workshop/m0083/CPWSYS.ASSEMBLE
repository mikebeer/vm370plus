*              CHANNELS.                                                00696000
            MVC CHANCOL,=CL(L'CHANCOL)'CHANNEL SIOs'                    00697000
            SPACE 1                                                     00698000
            LA  R4,CHAN0L                                               00699000
            SR  R5,R5         OFFSET INTO CHANNEL BUCKETS               00700000
            SR  R6,R6         CHANNEL COUNTER                           00701000
            SR  R7,R7         TOTAL SIO ACCUMULATOR                     00702000
            DO WHILE,CH,R6,=Y(16),LT                                    00703000
               L  R1,CPCHF(R5)          ACCUMULATE.                     00704000
               A  R1,CPCHT(R5)                                          00705000
               ST R1,CPCHT(R5)                                          00706000
               IF R1,NZ,THEN                                            00707000
                  MVC 0(L'CHAN0L,R4),=CL(L'CHAN0L)'Chan 0'              00708000
                  EX  R6,OI   OR IN CHANNEL                             00709000
OI                OI  5(R4),0 EXECUTED.                                 00710000
                  SPACE 1                                               00711000
*                 DISPLAY DIFFERENCE.                                   00712000
                  L   R1,CPCHF(R5)                                      00713000
                  AR  R7,R1   ACCUMULATE                                00714000
                  SPACE 1                                               00715000
                  M   R0,=F'2000'     1000 - MSEC, 2 FOR ROUNDING       00716000
*                 IF C,R0,SNAPINT,LT,THEN                               00717000
                     D   R0,SNAPINT                                     00718000
*                 IF ELSE                                               00719000
*                    SR  R1,R1                                          00720000
*                 IF END                                                00721000
                  LA  R1,1(,R1)                                         00722000
                  SRA R1,1                                              00723000
                  SPACE 1                                               00724000
                  CALL DECIT                                            00725000
                  MVC L'CHAN0L-4-2(4,R4),28-4(R13)                      00726000
                  MVC L'CHAN0L-2(2,R4),=C'/s'                           00727000
                  SPACE 1                                               00728000
                  LA  R4,L'SCRLINE(,R4) NEXT LINE.                      00729000
               IF END                                                   00730000
               SPACE 1                                                  00731000
               LA  R5,4(,R5)  NEXT CHANNEL BUCKET OFFSET                00732000
               LA  R6,1(,R6)  NEXT CHANNEL NUMBER.                      00733000
            DO END                                                      00734000
            SPACE 1                                                     00735000
*              SYSTEM SIO'S                                             00736000
