            SPACE 1                                                     00497000
            IF TM,XAPSTAT1,APUOPER+APUNONLN,NZ,THEN                     00498000
               L   R3,APPAGEF    LESS PAGE WAIT                         00499000
               A   R3,APIONTF    LESS I/O WAIT                          00500000
               A   R3,APIDLEF    LESS IDLE WAIT                         00501000
               A   R3,=F'5'      ROUND                                  00502000
