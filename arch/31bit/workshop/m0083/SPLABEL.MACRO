         MACRO
         SPLABEL &OPRN
         GBLC  &SPLSTK(255)     LABEL STACK
         GBLA  &SPNSTK,&SPMSTK    STACK LEVEL.
         GBLC  &CLABEL        LABEL FOR INNER MACRO COMMUNICATION.
         LCLA  &I
         AIF   ('&OPRN' NE 'PUSH').C10
.* PUSH LABELS ONTO LABEL STACK. GEO. 21.01.77
&I       SETA  1              DON'T PUSH OPERATION.
.A10     AIF   (&I GE N'&SYSLIST).A60
&I       SETA  &I+1
&SPNSTK    SETA  &SPNSTK+1
         AIF   (&SPNSTK LE 256).A30
         MNOTE 8,'LABEL STACK OVERFLOW.'
         AGO   .Z90
.A30     ANOP
&SPLSTK(&SPNSTK) SETC  '&SYSLIST(&I)'
         AGO   .A10
.A60     ANOP
.* UPDATE MAXIMUM STACK DEPTH.
         AIF   (&SPNSTK LE &SPMSTK).A70
&SPMSTK    SETA  &SPNSTK
.A70     AGO   .Z90
.*
.C10     AIF   ('&OPRN' NE 'POP').X10
.* POP TOP LABEL OFF STACK AND PLACE IN CLABEL.
         AIF   (&SPNSTK EQ 0).X20
&CLABEL  SETC  '&SPLSTK(&SPNSTK)'
&SPNSTK    SETA  &SPNSTK-1
         AGO   .Z90
*
.X10     MNOTE 8,'SPLABEL INVALID OP TYPE &OPRN'
         AGO   .Z90
.X20     MNOTE 8,'LABEL STACK UNDERFLOW.'
.*       AGO   .Z90
.*
.Z90     ANOP
         MEND
//
