*********************************************************************** 12070000
CPWCMS   CSECT                                                          12080000
         DS    0D                                                       12090000
MYION    DC    AL1(DISABLE),XL3'0',A(MYIOE)  I/O NEW PSW                12100000
MYEXTN   DC    AL1(DISABLE),XL3'0',A(MYEXTE) EXT NEW PSW                12110000
MYPGMN   DC    AL1(DISABLE),XL3'0',A(MYPGME) PGM NEW PSW                12120000
         SPACE 1                                                        12130000
         DS    0D                                                       12140000
MORE     DC    X'19',AL3(BLANK),AL1(SILI+CC,X'80'),AL2(1)               12150000
CLEAR    DC    X'19',AL3(BLANK),AL1(SILI,X'FF'),AL2(1)                  12160000
         SPACE 1                                                        12170000
*              FULL SCREEN WRITE CCW. MODIFIED BEFORE USE.              12180000
         DS    0D                                                       12190000
WRFS     DC    X'29',AL3(*-*),AL1(SILI,WRTERA),AL2(*-*)                 12200000
*        CONTROL (WRFS+5) DEFINITIONS.                                  12210000
WRTERA   EQU   X'80'          WRITE ERASE                               12220000
WRTERALT EQU   X'C0'          WRITE ERASE ALTERNATE FLAGS               12230000
WRTUPD   EQU   X'00'          WRITE UPDATE.                             12240000
WRTPA1   EQU   X'10'      PASS PA1 AS DATA (OR'D INTO WRTERA, WRTERALT) 12250000
WSFFLAG  EQU   X'20'          WRITE STRUCTURED FIELD.                   12260000
         SPACE 1                                                        12270000
*              FULL SCREEN READ CCW. MODIFIED BEFORE USE.               12280000
         DS    0D                                                       12290000
RDFS     DC    X'2A',AL3(*-*),AL1(SILI,RDMOD),AL2(*-*)                  12300000
*        CONTROL (RDFS+5) DEFINITIONS                                   12310000
RDBUFF   EQU   X'00'          READ FULL BUFFER.                         12320000
RDMOD    EQU   X'80'          READ MODIFIED.                            12330000
         SPACE 1                                                        12340000
SNSCCW   CCW   SENSE,SNSDATA,SILI,L'SNSDATA                             12350000
         SPACE 1                                                        12360000
         LTORG                                                          12370000
         SPACE 2                                                        12380000
UPTAB    DC    256AL1(*-UPTAB)                                          12390000
         ORG   UPTAB+C'A'-C' '          LOWERCASE A                     12400000
         DC    C'ABCDEFGHI'                                             12410000
         ORG   UPTAB+C'J'-C' '                                          12420000
         DC    C'JKLMNOPQR'                                             12430000
         ORG   UPTAB+C'S'-C' '                                          12440000
         DC    C'STUVWXYZ'                                              12450000
         ORG   ,                                                        12460000
         SPACE 2                                                        12470000
AIDTAB   DC    256AL1((KJUNK-AIDN)/L'AIDN)                              12480000
         ORG   AIDTAB+C'-'                                              12490000
         DC    AL1((KNOAID-AIDN)/L'AIDN)                                12500000
         ORG   AIDTAB+X'7D'                                             12510000
         DC    AL1((KENTER-AIDN)/L'AIDN)                                12520000
         ORG   AIDTAB+X'6D'                                             12530000
         DC    AL1((KCLEAR-AIDN)/L'AIDN)                                12540000
         ORG   AIDTAB+C'='                                              12550000
         DC    AL1((KLPEN-AIDN)/L'AIDN)                                 12560000
         ORG   AIDTAB+C'%'                                              12570000
         DC    AL1((KPA1-AIDN)/L'AIDN)                                  12580000
         ORG   AIDTAB+C'>'                                              12590000
         DC    AL1((KPA2-AIDN)/L'AIDN)                                  12600000
         ORG   AIDTAB+C','                                              12610000
         DC    AL1((KPA3-AIDN)/L'AIDN)                                  12620000
         ORG   AIDTAB+C'1'                                              12630000
         DC    AL1((KPF1-AIDN)/L'AIDN)                                  12640000
         ORG   AIDTAB+C'2'                                              12650000
         DC    AL1((KPF2-AIDN)/L'AIDN)                                  12660000
         ORG   AIDTAB+C'3'                                              12670000
         DC    AL1((KPF3-AIDN)/L'AIDN)                                  12680000
         ORG   AIDTAB+C'4'                                              12690000
         DC    AL1((KPF4-AIDN)/L'AIDN)                                  12700000
         ORG   AIDTAB+C'5'                                              12710000
         DC    AL1((KPF5-AIDN)/L'AIDN)                                  12720000
         ORG   AIDTAB+C'6'                                              12730000
         DC    AL1((KPF6-AIDN)/L'AIDN)                                  12740000
         ORG   AIDTAB+C'7'                                              12750000
         DC    AL1((KPF7-AIDN)/L'AIDN)                                  12760000
         ORG   AIDTAB+C'8'                                              12770000
         DC    AL1((KPF8-AIDN)/L'AIDN)                                  12780000
         ORG   AIDTAB+C'9'                                              12790000
         DC    AL1((KPF9-AIDN)/L'AIDN)                                  12800000
         ORG   AIDTAB+C':'                                              12810000
         DC    AL1((KPF10-AIDN)/L'AIDN)                                 12820000
         ORG   AIDTAB+C'#'                                              12830000
         DC    AL1((KPF11-AIDN)/L'AIDN)                                 12840000
         ORG   AIDTAB+C'@'                                              12850000
         DC    AL1((KPF12-AIDN)/L'AIDN)                                 12860000
         ORG   AIDTAB+C'A'                                              12870000
         DC    AL1((KPF13-AIDN)/L'AIDN)                                 12880000
         ORG   AIDTAB+C'B'                                              12890000
         DC    AL1((KPF14-AIDN)/L'AIDN)                                 12900000
         ORG   AIDTAB+C'C'                                              12910000
         DC    AL1((KPF15-AIDN)/L'AIDN)                                 12920000
         ORG   AIDTAB+C'D'                                              12930000
         DC    AL1((KPF16-AIDN)/L'AIDN)                                 12940000
         ORG   AIDTAB+C'E'                                              12950000
