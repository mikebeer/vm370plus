AIDN     DS    0CL16                                                    13120000
KJUNK    DC    CL8'JUNK',CL8'IGNORE'                                    13130000
KNOAID   DC    CL8'NOAID',CL8'IGNORE'                                   13140000
KLPEN    DC    CL8'LPEN',CL8'IGNORE'                                    13150000
KENTER   DC    CL8'ENTER',CL8' ' ... FILLED IN LATER ...                13160000
KCLEAR   DC    CL8'CLEAR',CL8'IGNORE'                                   13170000
KPA1     DC    CL8'PA1',CL8'CP'                                         13180000
KPA2     DC    CL8'PA2',CL8'CMS'                                        13190000
KPA3     DC    CL8'PA3',CL8'IGNORE'                                     13200000
