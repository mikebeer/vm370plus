*********************************************************************** 13460000
*              STORAGE                                                  13470000
*********************************************************************** 13480000
CMSION   DC    D'0'           SAVE AREA FOR CMS' I/O NEW PSW            13490000
CMSEXTN  DC    D'0'           SAVE AREA FOR CMS' EXTERNAL NEW PSW       13500000
CMSPGMN  DC    D'0'           SAVE AREA FOR CMS' PROGRAM CHECK NEW PSW  13510000
CMSKX    DC    F'0'           SAVE AREA FOR CMS' KILLEX ROUTINE.        13520000
         SPACE 1                                                        13530000
WORK     DC    AL1(0)         ACTIVITY FLAGS.                           13540000
*ATTN    EQU   X'80'          ATTN INTERRUPT RECEIVED.                  13550000
NEWSCR   EQU   X'40'          NEW SCREEN FOR WRITING.                   13560000
*WAIT    EQU   X'20'          HAVE ENTERED WAIT STATE.                  13570000
VMCFAUT  EQU   X'04'          WE HAVE ENABLED FOR VMCF.                 13580000
HOLD     EQU   X'02'          HOLD PRESENT SCREEN.                      13590000
QUIT     EQU   X'01'          TERMINATE REQUESTED BY SOMEONE.           13600000
*SOME     EQU   ATTN+NEWSCR+QUIT         SOME WORK IS AVAILABLE.        13610000
         SPACE 1                                                        13620000
CONSADDR DS    H              VIRTUAL ADDRESS OF VIRTUAL CONSOLE.       13630000
CONSFLAG DC    AL1(UNFORMAT)  CONSOLE STATUS FLAG.                      13640000
CLRPLS   EQU   X'80'          DO CLEAR BEFORE WRITE.                    13650000
UNFORMAT EQU   X'40'          BELIEVED TO BE UNFORMATTED.               13660000
USEALT   EQU   X'20'          USER WRITE/ERASE ALTERNATE.               13670000
TRAPPA1  EQU   X'10'          HOOK PA1 INTERRUPTS.                      13680000
RDBREQ   EQU   X'01'          A READ-FULL-BUFFER IS REQUIRED.           13690000
