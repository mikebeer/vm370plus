./ I 00095000          $ 95050 50                     10/31/84 14:40:28
*              START UP VMCF                                   U00019   00095050
*--------------------------------------------------------------U00019   00095100
         VMCF CREG0,ON                                         U00019   00095150
         SPACE 1                                               U00019   00095200
         L     R2,=V(VMCIH)   VMCF INTERRUPT HEADER DESC LOC   U00019   00095250
         LM    R2,R3,0(R2)    START ADDRESS, LENGTH.           U00019   00095300
         VMCF AUTHORIZE,FLDA=(R2),LENA=(R3),PARM=ENDPARM       U00019   00095350
         IF LTR,R1,R15,NZ,THEN                                 U00019   00095400
            DATA                                               U00019   00095450
AUTMSG      DC    C'RETCODE .... ON VMCF AUTHORIZE '           U00019   00095500
            PROC ,                                             U00019   00095550
            CALL DECIT                                         U00019   00095600
            STCM R1,15,AUTMSG+9                                U00019   00095650
            WTO  AUTMSG                                        U00019   00095700
         IF END                                                U00019   00095750
         SPACE 3                                               U00019   00095800
