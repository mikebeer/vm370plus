./ I 00146000          $ 146040 40                    10/31/84 14:40:28
*--------------------------------------------------------------U00019   00146040
*              SHUT DOWN VMCF                                  U00019   00146080
*--------------------------------------------------------------U00019   00146120
*              TERMINATE NEW INITIATIONS.                      U00019   00146160
         VMCF  QUIESCE,PARM=ENDPARM                            U00019   00146200
         SPACE 1                                               U00019   00146240
*              INFORM ALL USERS WE'RE GOING DOWN.              U00019   00146280
         L     R9,AVMCU                                        U00019   00146320
         USING VMUSECT,R9                                      U00019   00146360
         DO WHILE,R9,NZ                                        U00019   00146400
            VMCF IDENTIFY,USERID=VMUNAME,PARM=ENDPARM,         U00019  +00146440
               MSGID=VMUISHUT                                  U00019   00146480
            SPACE 1                                            U00019   00146520
            L   R9,VMUFPNT                                     U00019   00146560
         DO END                                                U00019   00146600
         SPACE 1                                               U00019   00146640
*              AND COMPLETE TERMINATE.                         U00019   00146680
         VMCF CREG0,OFF                                        U00019   00146720
         SPACE 1                                               U00019   00146760
         VMCF  UNAUTHORIZE,PARM=ENDPARM                        U00019   00146800
         SPACE 3                                               U00019   00146840
