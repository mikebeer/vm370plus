         SR  R2,R2         FIND AID ENTRY.                     U00020   00748090
         IC  R2,DEVAID GET AID                                 U00020   00748680
         IC  R2,AIDTAB(R2) GET ENTRY NUMBER.                   U00020   00749270
         MH  R2,=Y(L'AIDNAMES) CALCULATE ENTRY OFFSET          U00020   00749860
         LA  R1,AIDNAMES(R2)   ENTRY LOCATION                  U00020   00750450
         SPACE 1                                               U00020   00751040
         IF C,R1,=A(KENTER),EQ,THEN                            U00020   00751630
            OC  DEVDATA,BLANKS FORCE TO UPPER CASE             U00020   00752220
         IF ELSE USE DEFINED DATA                              U00020   00752810
            MVC DEVDATA,8(R1)                                  U00020   00753400
         IF END                                                U00020   00753990
         IF C,R1,=A(KCLEAR),EQ,OR,        IF ANY OF THESE KEYS,        +00754580
               C,R1,=A(KNOAID),EQ,OR,     WE'VE PROBABLY LOST          +00755170
               C,R1,=A(KUNKNOWN),EQ,THEN  SCREEN FORMAT.       U00020   00755760
            OI  DEVFLAGS,DEVERAS+DEVWRQ                        U00020   00756350
            NI  DEVFLAGS,255-DEVHOLD    NO, HE'S NOT ON HOLD   U00020   00756940
         IF END                                                U00020   00757530
         SPACE 1                                               U00020   00758120
         IF CLC,DEVDATA,=CL8'HOLD',EQ,OR,      CHECK FOR LOCAL         +00760480
               CLC,DEVDATA,=CL8'DISC',EQ,OR,   COMMANDS.               +00761070
               CLC,DEVDATA,=CL8'QUIT',EQ,THEN                  U00020   00761660
            IF CLC,DEVDATA,=CL8'HOLD',EQ,THEN                  U00020   00762250
               BAL R8,HOLDSCR                                  U00020   00762840
            IF ELSE                                            U00020   00763430
               BAL R8,DISCONN                                  U00020   00764020
            IF END                                             U00020   00764610
         SPACE 3                                               U00020   00765200
         IF ELSE              GENERAL COMMAND OR A DISPLAY NAM U00020   00765790
            NI  DEVFLAGS,255-DEVHOLD    NO, HE'S NOT ON HOLD   U00020   00766380
            SPACE 1                                            U00020   00766970
            L     R0,DEVPAG                                    U00020   00767560
            L     R1,DEVDSP                                    U00020   00768150
            LA    R2,DEVDATA                                   U00020   00768740
            L     R15,=A(CMDLU)                                U00020   00769330
            BALR  R14,R15                                      U00020   00769920
            IF    C,R1,DEVDSP,NE,OR,                           U00020  +00770510
               C,R0,DEVPAG,NE,THEN                             U00020   00771100
               OI  DEVFLAGS,DEVWRQ                             U00020   00771690
               IF C,R1,DEVDSP,NE,THEN                          U00020   00772280
                  L   R2,DEVDSP                                U00020   00772870
                  SP DSPUSRS-DSPSECT(L'DSPUSRS,R2),=P'1'       U00020   00773460
                  AP DSPUSRS-DSPSECT(L'DSPUSRS,R1),=P'1'       U00020   00774050
               IF END                                          U00020   00774640
            IF END                                             U00020   00775230
            ST    R1,DEVDSP                                    U00020   00775820
            ST    R0,DEVPAG                                    U00020   00776410
         IF END                                                U00020   00777000
