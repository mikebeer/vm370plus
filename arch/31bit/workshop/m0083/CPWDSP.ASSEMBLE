CPWDSP   CSECT                                                          00487000
*---------------------------------------------------------------------- 00488000
*              SERVICE ROUTINES                                         00489000
*---------------------------------------------------------------------- 00490000
*  MUST BE CALLED FROM MAIN LINE.                                       00491000
         SPACE 3                                                        00492000
*              BITIT                                                    00493000
*        CONVERT BYTE IN LOW ORDER POSITION OF R1                       00494000
*        TO CHARACTER BIT EQUIVALENT IN R0, R1.                         00495000
         SPACE 1                                                        00496000
         ENTRY BITIT                                                    00497000
         DS    0H                                                       00498000
BITIT    EQU   *-20                                                     00499000
         USING BITIT,R15                                                00500000
         N     R1,F00255                                                00501000
         SLDL  R0,31          BIT 7                                     00502000
         SRL   R1,7                                                     00503000
         SRDL  R0,1           BIT 6                                     00504000
         SRL   R1,7                                                     00505000
         SRDL  R0,1           BIT 5                                     00506000
         SRL   R1,7                                                     00507000
         SRDL  R0,4           LEAVE BIT 0                               00508000
         SLL   R0,7                                                     00509000
         SLDL  R0,1           BIT 1                                     00510000
         SLL   R0,7                                                     00511000
         SLDL  R0,1           BIT 2                                     00512000
         SLL   R0,7                                                     00513000
         SLDL  R0,1           BIT 3 (R0 FINISHED)                       00514000
         SRL   R1,7           REPOSITION AND FINISH R1                  00515000
         SPACE 1                                                        00516000
         STM   R14,R1,12(R13)                                           00517000
         OC    20(8,R13),CZEROS                                         00518000
         LM    R0,R1,20(R13)                                            00519000
         SPACE 1                                                        00520000
         BR    R14                                                      00521000
         DROP  R15                                                      00522000
         SPACE 3                                                        00523000
*              CONVERT BINARY NUMBER IN R1 TO EXTERNAL HEX REPRESENTATN 00524000
*        ENTER R1 = VALUE TO BE CONVERTED.                              00525000
*        EXIT R0,R1=CHARACTER HEX EQUIVALENT.                           00526000
         ENTRY HEXIT                                                    00527000
         DS    0H                                                       00528000
HEXIT    EQU   *-20                                                     00529000
         USING HEXIT,R15                                                00530000
         ST    R1,12(,R13)                                              00531000
         UNPK  20(9,R13),12(5,R13)                                      00532000
         TR    20(8,R13),HEXTAB                                         00533000
         SPACE 1                                                        00534000
         STM   R14,R15,12(R13)                                          00535000
         LM    R0,R1,20(R13)                                            00536000
         BR    R14                                                      00537000
         DROP  R15                                                      00538000
         EJECT                                                          00539000
*              CONVERT BINARY NUMBER IN R1 TO EXTERNAL DECIMAL.         00540000
*        ENTER R1 = VALUE TO BE CONVERTED.                              00541000
*        EXIT R0,R1 CONTAIN CHARACTER VALUE.                            00542000
         ENTRY DECIT,DECIT1D,DECIT2D                                    00543000
         DS    0H                                                       00544000
DECIT    EQU   *-20                                                     00545000
         USING DECIT,R15                                                00546000
         IF R2,=F'9999999',GT,OR,R2,=F'-999999',LT,THEN                 00547000
            MVC   20(8,R13),=8C'*'                                      00548000
         IF ELSE                                                        00549000
            CVD R1,28(,R13)                                             00550000
            MVC 19(9,R13),=X'40202020206B202120'                        00551000
            LA  R1,19+9-1(,R13)                                         00552000
            EDMK 19(9,R13),28+8-4(R13)                                  00553000
            IF M,THEN                                                   00554000
               BCTR R1,0                                                00555000
               MVI 0(R1),C'-'                                           00556000
            IF END                                                      00557000
         IF END                                                         00558000
         SPACE 1                                                        00559000
         STM   R14,R15,12(R13)          FOR THE RECORD.                 00560000
         LM    R0,R1,20(R13)  DROP LEADING BLANK.                       00561000
         SPACE 1                                                        00562000
         BR    R14                                                      00563000
         DROP  R15                                                      00564000
         SPACE 3                                                        00565000
         DS    0H                                                       00566000
DECIT1D  EQU *-20             WITH ONE DECIMAL PLACE.                   00567000
         USING DECIT1D,R15                                              00568000
         MVC 19(9,R13),=X'402020202021204B20'                           00569000
         CVD R1,28(,R13)                                                00570000
         LA  R1,19+9-3(,R13)                                            00571000
         EDMK 19(9,R13),28+8-4(R13)                                     00572000
         IF M,THEN                                                      00573000
            BCTR R1,0                                                   00574000
            MVI 0(R1),C'-'                                              00575000
         IF END                                                         00576000
         STM R14,R15,12(R13)                                            00577000
         LM  R0,R1,20(R13)                                              00578000
         BR    R14                                                      00579000
         DROP  R15                                                      00580000
         SPACE 3                                                        00581000
         DS    0H                                                       00582000
DECIT2D  EQU *-20             WITH TWO DECIMAL PLACES.                  00583000
         USING DECIT2D,R15                                              00584000
         MVC 19(9,R13),=X'4020202021204B2020'                           00585000
         CVD R1,28(,R13)                                                00586000
         LA  R1,19+9-3(,R13)                                            00587000
         EDMK 19(9,R13),28+8-4(R13)                                     00588000
         IF M,THEN                                                      00589000
            BCTR R1,0                                                   00590000
            MVI 0(R1),C'-'                                              00591000
         IF END                                                         00592000
         STM R14,R15,12(R13)                                            00593000
         LM  R0,R1,20(R13)                                              00594000
         BR    R14                                                      00595000
         DROP  R15                                                      00596000
         SPACE 3                                                        00597000
*              LITERAL POOL FOR SERVICE ROUTINES.                       00598000
         LTORG                                                          00599000
         EJECT                                                          00600000
*********************************************************************** 00601000
*              DISPLAY CHAIN.                                           00602000
*********************************************************************** 00603000
         SPACE 1                                                        00604000
CPWDSPS  CSECT                                                          00605000
         ENTRY DSPLAYS                                                  00606000
DSPLAYS  DS    0D                                                       00607000
DSPBEGIN DSPENTRY SCRMENU,FLAGS=DSPNC                                   00608000
DSPSYS   DSPENTRY ,                                                     00609000
DSPTRM   DSPENTRY ,                                                     00610000
DSPSDV   DSPENTRY ,                                                     00611000
DSPALL   DSPENTRY ,                                                     00612000
         PRINT GEN                                                      00613000
DSPACT   DSPENTRY ,DSPBEGIN                                             00614000
DSPSYA   DSPENTRY ,DSPSYA,FLAGS=DSPNC     FREE STANDING                 00615000
DSPSYX   DSPENTRY ,DSPSYX,FLAGS=DSPNC     FREE STANDING                 00616000
         PRINT NOGEN                                                    00617000
DSPCLOCK DSPENTRY SCRCLOCK,DSPBEGIN     FREE STANDING                   00618000
         EJECT                                                          00619000
*********************************************************************** 00620000
*              S C R E E N   B U F F E R S                              00621000
*********************************************************************** 00622000
         SPACE 1                                                        00623000
*              MENU PAGE.                                               00624000
         ENTRY SCRMENU                                                  00625000
SCRMENU  DC    A(0,0)         NO OTHER CHAINS.                          00626000
MENU     DS    CL1920                                                   00627000
         ORG   MENU                                                     00628000
M1       DC    CL80' '                                                  00629000
M2       DC    CL80'CPWATCH &V..&M MENU '                               00630000
M3       DC    CL80' '                                                  00631000
M4       DC    CL80' KEY   COMMAND             ACTION    '              00632000
M5       DC    CL80' '                                                  00633000
M6       DC    CL80'CLEAR   DISC         Release Screen.'               00634000
M7       DC    CL80' PA1    HOLD         Lock/Unlock screen against upd+00635000
               ates.'                                                   00636000
M8       DC    CL80' PA2    PAGE         Step through frames of one Dis+00637000
               play.'                                                   00638000
M9       DC    CL80' '                                                  00639000
M10      DC    CL80' PF1    MENU         Return to this page.'          00640000
M11      DC    CL80' PF2    SYS          System Status Page.'           00641000
M12      DC    CL80' PF3    TERM         Terminal Device Page.'         00642000
M13      DC    CL80' PF4    DEV          Non-Terminal Device Page.'     00643000
M14      DC    CL80' PF5    ALL          All Users Status.  '           00644000
M15      DC    CL80' PF6    ACT          Active Users Resource Usage.'  00645000
M16      DC    CL80' PF7    SYM          CP/370 System Synonym Table, n+00646000
               ame order.'                                              00647000
M17      DC    CL80' PF8    SYMX         CP/370 System Synonym Table, a+00648000
               ddress order.'                                           00649000
M18      DC    CL80' '                                                  00650000
M19      DC    CL80' PF12   CLOCK        Digital Clock Display.'        00651000
M20      DC    CL80' '                                                  00652000
M21      DC    CL80'ENTER                Go To Next Screen.'            00653000
M22      DC    CL80' '                                                  00654000
M23      DC    CL80' (Use the Enter Key with the Command Form.)'        00655000
M24      DC    CL80' '                                                  00656000
         ORG                                                            00657000
         SPACE 3                                                        00658000
         ORG   M2+L'M2-25                                               00659000
CPWDSPDT DC    CL25'ASSEMBLED &SYSDATE &SYSTIME'                        00660000
         ORG                                                            00661000
         EJECT                                                          00662000
SCRCLOCK DC    A(0,0)                                                   00663000
         DS    CL1920                                                   00664000
         END                                                            00665000
