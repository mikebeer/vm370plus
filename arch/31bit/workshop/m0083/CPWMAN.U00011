*              CPU ID, SYSTEM CODE.                            U00011   00166000
         STORAGE                                               U00011   00166010
DIAG0    DS    8D                                              U00011   00166020
DIAG0LN  EQU   *                                               U00011   00166030
         PROC  ,                                               U00011   00166040
         LA    R0,DIAG0                                        U00011   00166050
         LA    R1,DIAG0LN                                      U00011   00166060
         DIAG  R0,R1,0        STORE EXTENDED ID CODE           U00011   00166070
         MVC   CPREL(8),DIAG0 USE SYSTEM NAME.                 U00011   00166080
         IF LTR,R1,R1,Z,THEN AT SECOND LEVEL                   U00011   00166090
             MVC CPREL(8),DIAG0+32+16 (USE USERID)             U00011   00166100
         IF END                                                U00011   00166110
         SPACE 1                                               U00011   00166120
*              NOW RIGHT JUSTIFY SYSTEM CODE - MAKE IT PRETTY. U00011   00166130
         LA    R1,CPREL+7                                      U00011   00166140
         LA    R2,CPREL+7                                      U00011   00166150
         LA    R3,CPREL                                        U00011   00166160
         DO WHILE,CLI,0(R2),C' ',EQ                            U00011   00166170
            BCTR R2,0                                          U00011   00166180
         DO END                                                U00011   00166190
         DO WHILE,CR,R2,R3,GE                                  U00011   00166200
            MVC 0(1,R1),0(R2)                                  U00011   00166210
            BCTR R1,0                                          U00011   00166220
            BCTR R2,0                                          U00011   00166230
         DO END                                                U00011   00166240
         DO WHILE,CR,R1,R3,GE                                  U00011   00166250
            MVI 0(R1),C' '                                     U00011   00166260
            BCTR R1,0                                          U00011   00166270
         DO END                                                U00011   00166280
         SPACE 1                                               U00011   00166290
*              VM VERSION NUMBER.                              U00011   00166300
         SR    R1,R1                                           U00011   00166310
         IC    R1,DIAG0+8 VERSION NUMBER                       U00011   00166320
         CALL  DECIT                                           U00011   00166330
         STCM  R1,7,CPREL+8                                    U00011   00166340
         MVI   CPREL+11,C'.'                                   U00011   00166350
         SPACE 1                                               U00011   00166360
         SR    R1,R1                                           U00011   00166370
         IC    R1,DIAG0+8+1                                    U00011   00166380
         CALL  DECIT                                           U00011   00166390
         STCM R1,3,CPREL+12                                    U00011   00166400
