* MASS RE-ASSEMBLY OF CPWATCH.
&IF &INDEX > 0 &1 ¬= * &GOTO -SPEC
         CPWLVL STACK
         &READ VARS &X &CNTRL
         &ARGS &CNTRL &2 &3 &4 &5 &6 &7
-SPEC
*
&CONTROL MSG
&ERROR &EXIT &RETCODE
STATE &1 CNTRL *
*
* BUILD MACRO LIBRARIES.
 EXEC VMFMAC CPWMAC CPWR6
 EXEC VMFMAC CPWMBSE CPWBSE
 EXEC VMFMAC CPWMSP  &CNTRL
*
* EXECUTE ASSEMBLIES
 EXEC VMFASM  CPWASM &1
 EXEC VMFASM  CPWCMS &1 CPWUTL
 EXEC VMFASM  CPWDEV &1
 EXEC VMFASM  CPWDSE &1 EXP XREF
 EXEC VMFASM  CPWDSP &1
 EXEC VMFASM  CPWEND &1
 EXEC VMFASM  CPWLVL CPWUTL
 EXEC VMFASM  CPWMAN &1
 EXEC VMFASM  CPWSUP &1
 EXEC VMFASM  CPWSYS &1
 EXEC VMFASM  CPWUSR &1
*
 LOAD CPWLVL (CLEAR
 GENMOD CPWLVL MODULE A2 ( ALL )
*
 LOAD CPWCMS (ORIGIN TRANS CLEAR
 GENMOD CPWCMS MODULE A2 ( ALL SYSTEM
