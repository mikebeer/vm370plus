* *************************************************************U00020   04980200
* PFKEYS: DISPLAY PFKEY ASSIGNMENTS.                           U00020   04980400
* *************************************************************U00020   04980600
PFKEYS   ENTER SAVE=(DSECT,SCRATCH)                            U00020   04980800
*              ENTER HOLD STATUS.                              U00020   04981000
         OI    WORK,HOLD                                       U00020   04981200
         SPACE 1                                               U00020   04981400
         ICALL UNAUT       UNAUTHORIZE.                        U00020   04981600
         SPACE 1                                               U00020   04981800
*              CLEAR SCREEN BUFFER.                            U00020   04982000
         L     R2,DBUFFA                                       U00020   04982200
         L     R3,DBUFFM                                       U00020   04982400
         SR    R4,R4                                           U00020   04982600
         SR    R5,R5                                           U00020   04982800
         ICM   R5,8,=X'40'                                     U00020   04983000
         MVCL R2,R4                                            U00020   04983200
         SPACE 1                                               U00020   04983400
*              LOAD WITH PFKEY ACTION TABLE.                   U00020   04983600
         L     R2,DBUFFA                                       U00020   04983800
         LA    R3,1920                                         U00020   04984000
         ST    R3,DBUFFL                                       U00020   04984200
         AR    R3,R2          END + 1.                         U00020   04984400
         SPACE 1                                               U00020   04984600
         MVC   28(30,R2),=CL30'CPWCMS PFKEY ACTION TABLE'      U00020   04984800
         MVC   8+80(16,R2),=CL16'PFKEY   ACTION'               U00020   04985000
         SPACE 1                                               U00020   04985200
         LA    R2,2*80(,R2)     START ON THIRD LINE.           U00020   04985400
         SPACE 1                                               U00020   04985600
         LA    R4,AIDBEGIN                                     U00020   04985800
         LA    R5,AIDEND                                       U00020   04986000
         SPACE 1                                               U00020   04986200
PFK110   CR    R4,R5                                           U00020   04986400
         BNL   PFK160                                          U00020   04986600
            CR    R2,R3                                        U00020   04986800
            BNL   PFK140                                       U00020   04987000
               MVC 8(L'AIDNAMES,R2),0(R4)                      U00020   04987200
               SPACE 1                                         U00020   04987400
               LA  R2,80(,R2)                                  U00020   04987600
               LA  R4,L'AIDNAMES(,R4)                          U00020   04987800
               B   PFK110                                      U00020   04988000
PFK140      EQU   *              END OF COLUMN                 U00020   04988200
            S   R2,=A(1920-80+24)                              U00020   04988400
*           B     PFK110                                       U00020   04988600
PFK160   EQU   *              END OF AIDTABLE ENTRIES.         U00020   04988800
         SPACE 1                                               U00020   04989000
         OI  WORK,NEWSCR      POST A NEW SCREEN.               U00020   04989200
         SPACE 1                                               U00020   04989400
         EXIT RC=(15)                                          U00020   04989600
         EJECT                                                 U00020   04989800
