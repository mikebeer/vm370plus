* ************************************************************ U00020   02410200
*        OPTNS: ANALYSE PLIST.                                 U00020   02410400
* ************************************************************ U00020   02410600
OPTNS    ENTER SAVE=(DSECT,SCRATCH)                            U00020   02410800
         LA    R1,8(,R1)                                       U00020   02411000
         CLI   0(R1),X'FF'                                     U00020   02411200
         BE    OPT800                                          U00020   02411400
         CLI   0(R1),C'('                                      U00020   02411600
         BE    OPT400                                          U00020   02411800
            MVC CURRSCRN,0(R1) ONLY POSITIONAL PARAMETER.      U00020   02412000
OPT090   LA    R1,8(,R1)                                       U00020   02412200
         CLI   0(R1),X'FF'                                     U00020   02412400
         BE    OPT800                                          U00020   02412600
         CLI   0(R1),C'('                                      U00020   02412800
         BE    OPT400                                          U00020   02413000
            B   OPT090        FLUSH REMAINING PARAMETERS.      U00020   02413200
         SPACE 1                                               U00020   02413400
OPT400   EQU   *              OPTION LIST.                     U00020   02413600
         LA    R1,8(,R1)                                       U00020   02413800
         CLI   0(R1),C')'                                      U00020   02414000
         BE    OPT800                                          U00020   02414200
         CLI   0(R1),X'FF'                                     U00020   02414400
         BE    OPT800                                          U00020   02414600
            CLC =CL8'SERVER',0(R1)                             U00020   02414800
            BNE OPT410                                         U00020   02415000
               MVC SERVER,8(R1)                                U00020   02415200
               LA  R1,8(,R1)                                   U00020   02415400
               B   OPT400     TRY FOR ANOTHER.                 U00020   02415600
OPT410      EQU   *           NOT 'SERVER'                     U00020   02415800
            CLC =CL8'PASSWORD',0(R1)                           U00020   02416000
            BNE OPT420                                         U00020   02416200
               MVC PASSWORD,8(R1)                              U00020   02416400
               LA  R1,8(,R1)                                   U00020   02416600
               B   OPT400                                      U00020   02416800
OPT420      EQU   *           NOT 'PASSWORD'                   U00020   02417000
            CLC =CL8'IDENTITY',0(R1)                           U00020   02417200
            BNE OPT430                                         U00020   02417400
               MVC IDENTITY,8(R1)                              U00020   02417600
               B   OPT400                                      U00020   02417800
OPT430      EQU               *                                U00020   02418000
            SPACE 1                                            U00020   02418200
         B     OPT400         DON'T WORRY.                     U00020   02418400
         SPACE 1                                               U00020   02418600
OPT800   EQU   *                                               U00020   02418800
         EXIT  RC=0                                            U00020   02419000
         EJECT                                                 U00020   02419200
