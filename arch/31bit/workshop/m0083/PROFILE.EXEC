* WCB STANDARD PROFILE EXEC  -  04JUN82. GDG.
         &CONTROL OFF NOMSG

*****    CONFIGURE VIRTUAL MACHINE.
*              DISPLAY MESSAGE NUMBERS ON ERROR MESSAGES.
         CP SET EMSG ON
*              ALLOW V.M. TO CONTINUE RUNNING DURING CONSOLE FUNCTIONS
         CP SET RUN ON
*              HIGHLIGHT CONSOLE INPUT LINES
         $CP TERM HILIGHT ON
*              DON'T DISPLAY ACCOUNTING MESSAGE AT 08:00,16:30 AND 00:01.
         CP SET ACNT OFF

*****    SET CMS OPTIONS
*              PLACE TIME AND DURATION ON "R;" MESSAGES.
         SET RDYMSG LMSG
*              DON'T BLINK SCREEN EVERY 2 VIRTUAL SECONDS.
         SET BLIP OFF

*             SET PFKEY USAGE
         EXEC STDPFKEY

*             ADD STANDARD DISK ACCESSES.
         EXEC STDACC

*             SYNONYMS
         SYNONYM SYSPRG SYNONYM *

*             MACLIBS FROM MAINT
         ACCESS 194 C

         CP SPOOL PRINTER OFF CLASS A

         &IF &READFLAG = STACK &EXIT 0

         EXEC CPWATCHX
