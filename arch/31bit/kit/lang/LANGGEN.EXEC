/* LANGGEN EXEC -- make the MODULEs of the language disk (once, MAINT) */
/*   LANGGEN fm   LOAD and GENMOD each TEXT deck on fm, then erase it   */
ARG FM .
IF FM = '' THEN FM = 'L'
LIST = 'AS LD AR XL COBC COB2C PLI2C SMALLTC SQLITE3 SQLRUN PCINT',
       'RXBVM8 APLM IZZIP IZUNZIP MINIGZ UNTRS TRS RUNCPM'
DO I = 1 TO WORDS(LIST)
  N = WORD(LIST, I)
  'STATE' N 'TEXT' FM
  IF RC <> 0 THEN DO; SAY 'LANGGEN:' N 'TEXT not on' FM; ITERATE; END
  'LOAD' N '(CLEAR NOMAP'
  IF RC <> 0 THEN DO; SAY 'LANGGEN: LOAD' N 'RC' RC; EXIT RC; END
  'GENMOD' N 'MODULE' FM
  IF RC <> 0 THEN DO; SAY 'LANGGEN: GENMOD' N 'RC' RC; EXIT RC; END
  'ERASE' N 'TEXT' FM
  SAY 'LANGGEN:' N 'MODULE'
END
SAY 'LANGGEN: done'
EXIT 0
