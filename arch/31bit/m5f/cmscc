#!/bin/sh
# cmscc -- a gcc-like driver for the M5f CMS target, so that autoconf
# projects (GMP, GnuCOBOL) can be configured for CMS:
#   cmscc -c / -E / -S ...   compile with the crt.sh flags and newlib headers
#   cmscc ... -o prog        link: entry31 + objects + cmsrt + newlib (ELF;
#                            elf_to_cms turns it into a TEXT deck)
# Link tests in configure succeed; nothing is run (cross).
H=$(cd "$(dirname "$0")" && pwd)
X=s390x-linux-gnu
NEWLIB=${NEWLIB:-/home/claude/nlbuild}
NLSRC=${NLSRC:-/home/claude/nlsrc/newlib-4.4.0.20231231/newlib}
GI=$($X-gcc -m31 -print-file-name=include)
LIBGCC=$($X-gcc -m31 -print-libgcc-file-name)
# libstdc++ built for newlib and soft float (toolchain/mklibstdcxx.sh)
LIBSTDCXX=${LIBSTDCXX:-/home/claude/src/tc/lscinst/usr/local}
CXXI=$LIBSTDCXX/include/c++/13.3.0
case $(basename "$0") in
  cmsc++|cmsg++) CC=$X-g++
     CXF="-nostdinc++ -isystem $CXXI -isystem $CXXI/s390-ibm-elf -isystem $CXXI/backward -Dthread_local= -fno-threadsafe-statics";;
  *) CC=$X-gcc; CXF=;;
esac
CF="-m31 -mesa -march=z900 -msoft-float -mlong-double-64 -fno-pic -fno-pie -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector -ffunction-sections -fdata-sections -nostdinc $CXF -isystem $GI -I$H/inc -isystem $NEWLIB/targ-include -isystem $NLSRC/libc/include -D__CMS__ -U__unix__ -U__unix -Uunix -U__linux__ -U__linux -Ulinux -U__gnu_linux__ -D_Thread_local= -D__thread= -D__SINGLE_THREAD__ -U_FORTIFY_SOURCE"
link=1
for a in "$@"; do case $a in -c|-E|-S|-M|-MM) link=0;; --version|-v|-V|-qversion|-print-*|-dumpversion|-dumpmachine) exec $CC "$@";; esac; done
if [ $link = 0 ]; then
  # no position-independent code: the image is relocated by RLDs (TEXT) or
  # by the XL loader, and neither knows GOT relocations (bfd adds -fPIC)
  for a in "$@"; do shift; case $a in -fPIC|-fpic|-fPIE|-fpie|-DPIC) ;; *) set -- "$@" "$a";; esac; done
  exec $CC $CF "$@"
fi
# link: split sources/objects/libs, drop host-only flags
W=$(mktemp -d); objs=""; out=a.out; libs=""; nxt=""; cfl=""
for a in "$@"; do
  if [ "$nxt" = o ]; then out=$a; nxt=""; continue; fi
  case $a in
    -o) nxt=o;;
    *.c) o=$W/$(basename "$a" .c).$$.o; $X-gcc $CF $cfl -c "$a" -o "$o" || { rm -rf $W; exit 1; }; objs="$objs $o";;
    *.cc|*.cpp|*.cxx|*.C) o=$W/$(basename "$a").$$.o; $CC $CF $cfl -c "$a" -o "$o" || { rm -rf $W; exit 1; }; objs="$objs $o";;
    *.o|*.a) objs="$objs $a";;
    -L*) libs="$libs $a";;
    -lm|-lc|-lrt|-lpthread) ;;
    -l*) libs="$libs $a";;
    -D*|-I*|-O*|-std=*|-w|-W[a-z]*|-f*) cfl="$cfl $a";;
    -g*|-m*|-pipe|-static|-s|-rdynamic|-export-dynamic|-Wl,*|-pthread) ;;
    *) ;;
  esac
done
# CMSCC_XL=1: a large program for the XL loader (high storage; then
# mkximage.py out out.ximage)
if [ -n "$CMSCC_XL" ]; then XLF=-DCMS_XL; ENT=entryxl.s; LDS=imagexl.ld; else XLF=; ENT=entry31.s; LDS=image.ld; fi
if [ -n "$CXF" ]; then $X-g++ $CF -fno-exceptions -fno-rtti -c "$H/cxxrt.cc" -o $W/cxxrt.o || exit 1; objs="$objs $W/cxxrt.o"
  # std::string, iostreams etc. (its operator new/delete and throw helpers
  # are cxxrt's, linked first)
  libs="$libs $LIBSTDCXX/lib32/libstdc++.a"; fi
$X-gcc $CF $XLF -c "$H/cmsrt.c" -o $W/cmsrt.o && $X-as -m31 -mesa "$H/$ENT" -o $W/entry31.o &&
$X-ld -m elf_s390 -static --emit-relocs --gc-sections -T "$H/$LDS" -o "$out" \
  $W/entry31.o $objs $W/cmsrt.o $libs \
  --start-group $NEWLIB/libc.a $NEWLIB/libm.a "$H/softfp/libsoftfp.a" $LIBGCC --end-group
rc=$?; rm -rf $W; exit $rc
